!> CUDA Fortran implementation of the split tendency kernels.
module mod_cuda_dg_kernels
  use cudafor
  use, intrinsic :: iso_c_binding, only: c_int, c_double, c_long_long
  use mod_common, only: RP
  implicit none
  private

  logical, public, parameter :: cuda_dg_kernels_available = .true.

  integer, parameter :: CUDA_BLOCK_SIZE = 256
  integer, parameter :: CUDA_P7_BLOCK_SIZE = 512
  integer, parameter :: CUDA_FUSED_P7_BLOCK_SIZE = 256
  integer, parameter :: CUDA_P255_NQ = 256
  integer, parameter :: CUDA_P255_TILE = 16
  integer, parameter :: CUDA_P255_BLOCKS_PER_ELEMENT = 65536

  !- Device-time measurement -------------------------------------------------
  !
  !  The tendency wrappers bracket their kernels with CUDA events.  Reading an
  !  event pair back needs the recorded work to be complete, so doing it in the
  !  same call drains the pipeline at every Runge-Kutta stage and exposes the
  !  launch latency of the kernels that follow.  The measurement is therefore
  !  read one call later: the events alternate between two buffers and each
  !  call harvests the buffer of the previous call, which the device has long
  !  finished by then.  cuda_dg_flush_kernel_time collects the last, still
  !  unread measurement at the end of the run.  The measured intervals are
  !  unchanged; only the moment they are read back is.
  integer, parameter :: DG_EV_SINGLE     = 1 ! 2 boundaries, 1 interval
  integer, parameter :: DG_EV_CUTE       = 2 ! 4 boundaries
  integer, parameter :: DG_EV_GEMM_FUSED = 3 ! 5 boundaries
  integer, parameter :: DG_EV_SPLIT      = 4 ! 5 boundaries, 4 intervals

  !> Stream that every kernel and event of this module uses.  It is set to the
  !! stream of the OpenACC queue of the time-stepping loop, so that the CUDA
  !! kernels and the OpenACC regions keep their order without the host
  !! synchronizing between them.  cudaforGetDefaultStream() until then.
  integer(kind=cuda_stream_kind), save :: dg_stream = 0

  !> Second stream used to produce the operands the first GEMM does not need.
  !! The x GEMM reads only flux_x, so flux_y, flux_z and the element boundary
  !! flux can be computed while it runs: it holds the SM for 250 us at 88%
  !! SM throughput but only 10% DRAM throughput, and leaves about 11k of the
  !! 64k registers per SM free, so bandwidth-bound blocks co-schedule with it.
  !! Fork and join are plain events, which stream capture turns into graph
  !! edges, so the CUDA graph path keeps working.
  !! Measured on a CUDA graph replay the same structure is a small loss
  !! instead of a gain, so the host turns it off before capturing a step.
  integer(kind=cuda_stream_kind), save :: dg_side_stream = 0
  type(cudaEvent), save :: dg_side_fork_ev, dg_side_join_ev
  logical, save :: dg_side_ready = .false.
  logical, save :: dg_side_enabled = .true.

  type(cudaEvent), save :: split_events(5,2)
  logical, save :: split_events_initialized = .false.
  integer, save :: ev_buf = 2         ! buffer the current call records into
  integer, save :: ev_pending = 0     ! buffer holding an unread measurement
  integer, save :: ev_pending_mode = 0
  real(RP), save :: dg_kernel_time(4) = 0.0_RP ! result of the last harvest

  !> .false. suppresses the event records entirely.  A graph replay does not
  !! run the Fortran wrapper that reads the events back, so the per-kernel
  !! device time cannot be reported in graph mode; recording events that
  !! nobody reads would only add nodes to the graph.
  logical, save :: dg_ev_enabled = .true.

  !- CUDA Graph -------------------------------------------------------------
  !
  !  One Runge-Kutta step is captured from dg_stream once and replayed for
  !  every later step.  All the step's work is queued on that one stream, so
  !  the capture is a plain linear graph; what it removes is the per-launch
  !  turnaround the host pays nine times a step, not any device work.
  type(cudaGraph), save :: dg_graph
  type(cudaGraphExec), save :: dg_graph_exec
  logical, save :: dg_graph_ready = .false.

  logical, save :: gemm_inited = .false.
  !- MMA instruction shape of the CUTLASS volume GEMMs; see
  !- cuda_cutlass_set_mma_shape. 0 = SM80 8x8x4, 1 = SM90 16x8x4,
  !- 2 = SM90 16x8x8, 3 = SM90 16x8x16.
  integer(c_int), save :: cutlass_mma_shape_id = 0

  public :: cuda_cal_volume_flux
  public :: cuda_cal_volume_deriv
  public :: cuda_cal_surface_lift
  public :: cuda_assemble_dqdt
  public :: cuda_cal_dqdt_split
  public :: cuda_cal_dqdt_fused
  public :: cuda_cal_dqdt_fused_p255
  public :: cuda_cal_dqdt_fused_tc
  public :: cuda_cal_dqdt_fused_p255_tc
  public :: cuda_cal_dqdt_gemm
  public :: cuda_cal_dqdt_gemm_fused
  public :: cuda_cal_dqdt_gemm_cute
  public :: cuda_gemm_setup
  public :: cuda_cutlass_set_mma_shape
  public :: cuda_gemm_finalize
  public :: cuda_cal_elembnd_flux
  public :: cuda_dg_bind_acc_stream
  public :: cuda_dg_set_side_stream
  public :: cuda_dg_flush_kernel_time
  public :: cuda_dg_set_event_timing
  public :: cuda_dg_graph_capture_begin
  public :: cuda_dg_graph_capture_end
  public :: cuda_dg_graph_launch
  public :: cuda_dg_graph_is_ready
  public :: cuda_dg_graph_finalize

  interface
    subroutine dg_set_cuda_stream(stream) &
      bind(C, name="dg_set_cuda_stream")
      import
      integer(kind=cuda_stream_kind), value :: stream
    end subroutine dg_set_cuda_stream

    subroutine launch_tendency_fused_p7_tc( &
      dqdt, D1D, Lift1D, q, u, v, w, VMapM, VMapP, &
      normal_fn, Fscale, Escale, Ne) &
      bind(C, name="launch_tendency_fused_p7_tc")
      import
      integer(c_int), value :: Ne
      real(c_double), device :: dqdt(*), D1D(*), Lift1D(*)
      real(c_double), device :: q(*), u(*), v(*), w(*)
      integer(c_int), device :: VMapM(*), VMapP(*)
      real(c_double), device :: normal_fn(*), Fscale(*), Escale(*)
    end subroutine launch_tendency_fused_p7_tc

    subroutine launch_tendency_xyz_p255_tc( &
      dqdt, q, u, v, w, D1D, Lift1D, flux_bnd, Escale, Ne) &
      bind(C, name="launch_tendency_xyz_p255_tc")
      import
      integer(c_int), value :: Ne
      real(c_double), device :: dqdt(*), q(*), u(*), v(*), w(*)
      real(c_double), device :: D1D(*), Lift1D(*), flux_bnd(*), Escale(*)
    end subroutine launch_tendency_xyz_p255_tc

    function cublas_gemm_init(emulate) bind(C, name="cublas_gemm_init")
      import
      integer(c_int), value :: emulate
      integer(c_int) :: cublas_gemm_init
    end function cublas_gemm_init

    function cublas_gemm_finalize() bind(C, name="cublas_gemm_finalize")
      import
      integer(c_int) :: cublas_gemm_finalize
    end function cublas_gemm_finalize

    function cublas_dgemm_impl(transa, transb, m, n, k, alpha, A, lda, B, ldb, &
      beta, C, ldc) bind(C, name="cublas_dgemm_impl")
      import
      integer(c_int), value :: transa, transb, m, n, k, lda, ldb, ldc
      real(c_double), value :: alpha, beta
      real(c_double), device :: A(*), B(*), C(*)
      integer(c_int) :: cublas_dgemm_impl
    end function cublas_dgemm_impl

    function cublas_dgemm_strided_batched_impl(transa, transb, m, n, k, alpha, &
      A, lda, strideA, B, ldb, strideB, beta, C, ldc, strideC, batch) &
      bind(C, name="cublas_dgemm_strided_batched_impl")
      import
      integer(c_int), value :: transa, transb, m, n, k, lda, ldb, ldc, batch
      integer(c_long_long), value :: strideA, strideB, strideC
      real(c_double), value :: alpha, beta
      real(c_double), device :: A(*), B(*), C(*)
      integer(c_int) :: cublas_dgemm_strided_batched_impl
    end function cublas_dgemm_strided_batched_impl

    function launch_volume_gemm_xy(deriv_x, deriv_y, flux_x, flux_y, D1D, D1D_tr, &
      Nq, Ne, mma_shape) bind(C, name="launch_volume_gemm_xy")
      import
      integer(c_int), value :: Nq, Ne, mma_shape
      real(c_double), device :: deriv_x(*), deriv_y(*)
      real(c_double), device :: flux_x(*), flux_y(*)
      real(c_double), device :: D1D(*), D1D_tr(*)
      integer(c_int) :: launch_volume_gemm_xy
    end function launch_volume_gemm_xy

    function launch_z_gemm_assembly(dqdt, flux_z, D1D_tr, deriv_x, deriv_y, &
      flux_bnd, lift1d, escale, Nq, Ne, mma_shape) &
      bind(C, name="launch_z_gemm_assembly")
      import
      integer(c_int), value :: Nq, Ne, mma_shape
      real(c_double), device :: dqdt(*)
      real(c_double), device :: flux_z(*), D1D_tr(*)
      real(c_double), device :: deriv_x(*), deriv_y(*), escale(*)
      real(c_double), device :: flux_bnd(*), lift1d(*)
      integer(c_int) :: launch_z_gemm_assembly
    end function launch_z_gemm_assembly

    function launch_volume_gemm_cute(deriv_x, deriv_y, deriv_z, flux_x, flux_y, &
      flux_z, D1D, D1D_tr, Nq, Ne, mma_shape) &
      bind(C, name="launch_volume_gemm_cute")
      import
      integer(c_int), value :: Nq, Ne, mma_shape
      real(c_double), device :: deriv_x(*), deriv_y(*), deriv_z(*)
      real(c_double), device :: flux_x(*), flux_y(*), flux_z(*)
      real(c_double), device :: D1D(*), D1D_tr(*)
      integer(c_int) :: launch_volume_gemm_cute
    end function launch_volume_gemm_cute
  end interface

contains

  !> Launch the kernels of this module on the stream of an OpenACC queue.
  !!
  !! The OpenACC regions of the time-stepping loop are put on queue `queue`.
  !! Sharing its stream keeps the order of the two kinds of kernels exactly as
  !! it was when every OpenACC region synchronized on its own, but lets the
  !! host queue the launches without blocking in between.
  subroutine cuda_dg_bind_acc_stream(queue)
    use openacc, only: acc_get_cuda_stream
    implicit none
    integer, intent(in) :: queue
    !------------------------------------------------------------

    dg_stream = acc_get_cuda_stream(queue)
    call dg_set_cuda_stream(dg_stream)

    return
  end subroutine cuda_dg_bind_acc_stream

  !> Turn the second stream on or off.  Overlapping the element boundary flux
  !! with the volume GEMMs is worth about 15 us per tendency call when the
  !! kernels are launched one by one, but on a CUDA graph replay the same
  !! structure costs about 5 us per call instead, so the host turns it off
  !! before capturing.
  subroutine cuda_dg_set_side_stream(on)
    implicit none
    logical, intent(in) :: on
    !------------------------------------------------------------

    dg_side_enabled = on

    return
  end subroutine cuda_dg_set_side_stream

  !> Turn the per-kernel CUDA event timing on or off.
  subroutine cuda_dg_set_event_timing(on)
    implicit none
    logical, intent(in) :: on
    !------------------------------------------------------------

    dg_ev_enabled = on

    return
  end subroutine cuda_dg_set_event_timing

  !> Create the second stream and its two events on first use.
  subroutine dg_side_stream_init()
    implicit none

    integer :: istat
    !------------------------------------------------------------

    if (dg_side_ready) return

    istat = cudaStreamCreateWithFlags(dg_side_stream,cudaStreamNonBlocking)
    if (istat /= cudaSuccess) call cuda_failure("cudaStreamCreateWithFlags",istat)
    istat = cudaEventCreateWithFlags(dg_side_fork_ev,cudaEventDisableTiming)
    if (istat /= cudaSuccess) call cuda_failure("cudaEventCreateWithFlags",istat)
    istat = cudaEventCreateWithFlags(dg_side_join_ev,cudaEventDisableTiming)
    if (istat /= cudaSuccess) call cuda_failure("cudaEventCreateWithFlags",istat)
    dg_side_ready = .true.

    return
  end subroutine dg_side_stream_init

  !> Let the second stream start on what the main stream has queued so far.
  subroutine dg_side_fork()
    implicit none

    integer :: istat
    !------------------------------------------------------------

    call dg_side_stream_init()

    istat = cudaEventRecord(dg_side_fork_ev,dg_stream)
    if (istat /= cudaSuccess) call cuda_failure("cudaEventRecord(fork)",istat)
    istat = cudaStreamWaitEvent(dg_side_stream,dg_side_fork_ev,0)
    if (istat /= cudaSuccess) call cuda_failure("cudaStreamWaitEvent(fork)",istat)

    return
  end subroutine dg_side_fork

  !> Hold the main stream until the second stream has finished its work.
  subroutine dg_side_join()
    implicit none

    integer :: istat
    !------------------------------------------------------------

    istat = cudaEventRecord(dg_side_join_ev,dg_side_stream)
    if (istat /= cudaSuccess) call cuda_failure("cudaEventRecord(join)",istat)
    istat = cudaStreamWaitEvent(dg_stream,dg_side_join_ev,0)
    if (istat /= cudaSuccess) call cuda_failure("cudaStreamWaitEvent(join)",istat)

    return
  end subroutine dg_side_join

  !> Record one measurement boundary on the kernel stream.
  subroutine dg_ev_record(iev)
    implicit none
    integer, intent(in) :: iev

    integer :: istat
    !------------------------------------------------------------

    if (.not. dg_ev_enabled) return

    istat = cudaEventRecord(split_events(iev,ev_buf),dg_stream)
    if (istat /= cudaSuccess) call cuda_failure("cudaEventRecord",istat)

    return
  end subroutine dg_ev_record

  !> Start a measurement: create the events on first use, read back the
  !! measurement of the previous call and switch to the other event buffer.
  subroutine dg_ev_begin()
    implicit none

    integer :: istat, iev, ibuf
    !------------------------------------------------------------

    if (.not. dg_ev_enabled) return

    if (.not. split_events_initialized) then
      do ibuf = 1, 2
        do iev = 1, 5
          istat = cudaEventCreate(split_events(iev,ibuf))
          if (istat /= cudaSuccess) call cuda_failure("cudaEventCreate",istat)
        end do
      end do
      split_events_initialized = .true.
    end if

    call dg_ev_harvest()
    ev_buf = 3 - ev_buf

    return
  end subroutine dg_ev_begin

  !> Mark the events just recorded as the measurement to read back next time.
  subroutine dg_ev_end(mode)
    implicit none
    integer, intent(in) :: mode
    !------------------------------------------------------------

    if (.not. dg_ev_enabled) return

    ev_pending = ev_buf
    ev_pending_mode = mode

    return
  end subroutine dg_ev_end

  !> Read the pending measurement into dg_kernel_time (zero if there is none).
  subroutine dg_ev_harvest()
    implicit none

    integer :: istat, nb, i
    real :: ms(4)
    !------------------------------------------------------------

    dg_kernel_time(:) = 0.0_RP
    if (ev_pending == 0) return

    select case (ev_pending_mode)
    case (DG_EV_SINGLE)
      nb = 2
    case (DG_EV_CUTE)
      nb = 4
    case default
      nb = 5
    end select

    istat = cudaEventSynchronize(split_events(nb,ev_pending))
    if (istat /= cudaSuccess) call cuda_failure("cudaEventSynchronize",istat)

    ms(:) = 0.0
    do i = 1, nb-1
      istat = cudaEventElapsedTime(ms(i), &
        split_events(i,ev_pending),split_events(i+1,ev_pending))
      if (istat /= cudaSuccess) call cuda_failure("cudaEventElapsedTime",istat)
    end do

    select case (ev_pending_mode)
    case (DG_EV_SINGLE)
      dg_kernel_time(1) = real(ms(1),RP)*1.0e-3_RP
    case (DG_EV_CUTE)
      dg_kernel_time(1) = real(ms(1)+ms(2)+ms(3),RP)*1.0e-3_RP
      dg_kernel_time(2) = real(ms(2),RP)*1.0e-3_RP
    case (DG_EV_GEMM_FUSED)
      dg_kernel_time(1) = real(ms(1)+ms(2)+ms(3)+ms(4),RP)*1.0e-3_RP
      dg_kernel_time(2) = real(ms(2)+ms(4),RP)*1.0e-3_RP
    case (DG_EV_SPLIT)
      do i = 1, 4
        dg_kernel_time(i) = real(ms(i),RP)*1.0e-3_RP
      end do
    end select

    ev_pending = 0

    return
  end subroutine dg_ev_harvest

  !> Read back the measurement of the last tendency call, which no later call
  !! harvested.  Call it once, after the time-stepping loop.
  subroutine cuda_dg_flush_kernel_time(kernel_time)
    implicit none
    real(RP), intent(out) :: kernel_time(4)
    !------------------------------------------------------------

    call dg_ev_harvest()
    kernel_time(:) = dg_kernel_time(:)

    return
  end subroutine cuda_dg_flush_kernel_time

  !> Begin capturing the kernel stream into a CUDA graph.  Nothing queued
  !! between here and cuda_dg_graph_capture_end() executes; it becomes graph
  !! nodes instead.
  !!
  !! The capture is relaxed rather than thread-local because the OpenACC
  !! regions of the step are queued through the OpenACC runtime, which is not
  !! written with capture in mind and would otherwise have to be audited for
  !! every call it makes while a capture of this thread is open.  What the
  !! stricter modes buy is a diagnostic, not correctness: the step queues
  !! nothing but kernels on this one stream, and the captured result is
  !! checked against the directly launched one field by field.
  subroutine cuda_dg_graph_capture_begin()
    implicit none

    integer :: istat
    !------------------------------------------------------------

    istat = cudaStreamBeginCapture(dg_stream,cudaStreamCaptureModeRelaxed)
    if (istat /= cudaSuccess) &
      call cuda_failure("cudaStreamBeginCapture",istat)

    return
  end subroutine cuda_dg_graph_capture_begin

  !> End the capture and instantiate the executable graph.
  subroutine cuda_dg_graph_capture_end()
    implicit none

    integer :: istat
    !------------------------------------------------------------

    istat = cudaStreamEndCapture(dg_stream,dg_graph)
    if (istat /= cudaSuccess) call cuda_failure("cudaStreamEndCapture",istat)

    istat = cudaGraphInstantiate(dg_graph_exec,dg_graph,0)
    if (istat /= cudaSuccess) call cuda_failure("cudaGraphInstantiate",istat)

    dg_graph_ready = .true.

    return
  end subroutine cuda_dg_graph_capture_end

  !> Replay the captured step on the kernel stream.
  subroutine cuda_dg_graph_launch()
    implicit none

    integer :: istat
    !------------------------------------------------------------

    istat = cudaGraphLaunch(dg_graph_exec,dg_stream)
    if (istat /= cudaSuccess) call cuda_failure("cudaGraphLaunch",istat)

    return
  end subroutine cuda_dg_graph_launch

  logical function cuda_dg_graph_is_ready()
    implicit none
    !------------------------------------------------------------

    cuda_dg_graph_is_ready = dg_graph_ready

    return
  end function cuda_dg_graph_is_ready

  subroutine cuda_dg_graph_finalize()
    implicit none

    integer :: istat
    !------------------------------------------------------------

    if (.not. dg_graph_ready) return

    istat = cudaGraphExecDestroy(dg_graph_exec)
    if (istat /= cudaSuccess) call cuda_failure("cudaGraphExecDestroy",istat)
    istat = cudaGraphDestroy(dg_graph)
    if (istat /= cudaSuccess) call cuda_failure("cudaGraphDestroy",istat)
    dg_graph_ready = .false.

    return
  end subroutine cuda_dg_graph_finalize

  subroutine cuda_cal_elembnd_flux( &
    flux, q, u, v, w, VMapM, VMapP, normal_fn, Fscale, &
    Np, NfpTot, Ne, NeA )
    implicit none
    integer, intent(in) :: Np, NfpTot, Ne, NeA
    real(RP), device, intent(out) :: flux(NfpTot,Ne)
    real(RP), device, intent(in) :: q(Np,NeA), u(Np,NeA), v(Np,NeA), w(Np,NeA)
    integer, device, intent(in) :: VMapM(NfpTot,Ne), VMapP(NfpTot,Ne)
    real(RP), device, intent(in) :: normal_fn(NfpTot,Ne,3), Fscale(NfpTot,Ne)

    integer :: nface, nblock

    nface = NfpTot*Ne
    nblock = (nface+CUDA_BLOCK_SIZE-1)/CUDA_BLOCK_SIZE
    call elembnd_flux_kernel<<<nblock,CUDA_BLOCK_SIZE,0,dg_stream>>>( &
      flux, q, u, v, w, VMapM, VMapP, normal_fn, Fscale, nface )
    call synchronize_cuda_kernel("elembnd_flux_kernel")
  end subroutine cuda_cal_elembnd_flux

  subroutine cuda_cal_dqdt_fused( &
    dqdt, q, u, v, w, D1D, Lift1D, VMapM, VMapP, &
    normal_fn, Fscale, Escale, &
    Nq, Np, NfpTot, Ne, NeA, kernel_time )
    implicit none
    integer, intent(in) :: Nq, Np, NfpTot, Ne, NeA
    real(RP), device, intent(out) :: dqdt(Np,NeA)
    real(RP), device, intent(in) :: q(Np,NeA)
    real(RP), device, intent(in) :: u(Np,NeA), v(Np,NeA), w(Np,NeA)
    real(RP), device, intent(in) :: D1D(Nq,Nq)
    real(RP), device, intent(in) :: Lift1D(Nq,6)
    integer, device, intent(in) :: VMapM(NfpTot,Ne)
    integer, device, intent(in) :: VMapP(NfpTot,Ne)
    real(RP), device, intent(in) :: normal_fn(NfpTot,Ne,3)
    real(RP), device, intent(in) :: Fscale(NfpTot,Ne)
    real(RP), device, intent(in) :: Escale(Np,Ne,3)
    real(RP), intent(out) :: kernel_time(2)

    integer :: istat

    if (Nq /= 8) then
      write(*,*) "CUDAFORTRAN_FUSED currently requires PolyOrder=7"
      error stop
    end if
    call dg_ev_begin()

    call dg_ev_record(1)
    call tendency_fused_p7_kernel<<<Ne,CUDA_FUSED_P7_BLOCK_SIZE,0,dg_stream>>>( &
      dqdt, D1D, Lift1D, q, u, v, w, VMapM, VMapP, &
      normal_fn, Fscale, Escale, Ne )
    istat = cudaGetLastError()
    if (istat /= cudaSuccess) call cuda_failure( &
      "tendency_fused_p7_kernel",istat)
    call dg_ev_record(2)
    call dg_ev_end(DG_EV_SINGLE)

    kernel_time(1) = dg_kernel_time(1)
    kernel_time(2) = dg_kernel_time(2)
  end subroutine cuda_cal_dqdt_fused

  !> p=255 variable-coefficient tendency. Each element is decomposed into
  !! 16x16 tensor-product tiles, so the same kernels support Ne > 1.
  subroutine cuda_cal_dqdt_fused_p255( &
    dqdt, q, u, v, w, D1D, Lift1D, VMapM, VMapP, &
    normal_fn, Fscale, Escale, flux_bnd, &
    Nq, Np, NfpTot, Ne, NeA, kernel_time )
    implicit none
    integer, intent(in) :: Nq, Np, NfpTot, Ne, NeA
    real(RP), device, intent(out) :: dqdt(Np,NeA)
    real(RP), device, intent(in) :: q(Np,NeA)
    real(RP), device, intent(in) :: u(Np,NeA), v(Np,NeA), w(Np,NeA)
    real(RP), device, intent(in) :: D1D(Nq,Nq)
    real(RP), device, intent(in) :: Lift1D(Nq,6)
    integer, device, intent(in) :: VMapM(NfpTot,Ne)
    integer, device, intent(in) :: VMapP(NfpTot,Ne)
    real(RP), device, intent(in) :: normal_fn(NfpTot,Ne,3)
    real(RP), device, intent(in) :: Fscale(NfpTot,Ne)
    real(RP), device, intent(in) :: Escale(Np,Ne,3)
    real(RP), device, intent(out) :: flux_bnd(NfpTot,Ne)
    real(RP), intent(out) :: kernel_time(2)

    integer :: istat, nface, nblock_face, nblock_deriv
    type(dim3) :: tile_threads

    if (Nq /= CUDA_P255_NQ .or. Np /= CUDA_P255_NQ**3) then
      error stop "cuda_cal_dqdt_fused_p255 requires PolyOrder=255"
    end if
    call dg_ev_begin()

    nface = NfpTot*Ne
    nblock_face = (nface+CUDA_BLOCK_SIZE-1)/CUDA_BLOCK_SIZE
    nblock_deriv = CUDA_P255_BLOCKS_PER_ELEMENT*Ne
    tile_threads = dim3(CUDA_P255_TILE,CUDA_P255_TILE,1)

    call dg_ev_record(1)
    call elembnd_flux_kernel<<<nblock_face,CUDA_BLOCK_SIZE,0,dg_stream>>>( &
      flux_bnd, q, u, v, w, VMapM, VMapP, normal_fn, Fscale, nface )
    call tendency_x_p255_kernel<<<nblock_deriv,tile_threads,0,dg_stream>>>( &
      dqdt, q, u, D1D, Lift1D, flux_bnd, Escale, Ne )
    call tendency_y_p255_kernel<<<nblock_deriv,tile_threads,0,dg_stream>>>( &
      dqdt, q, v, D1D, Lift1D, flux_bnd, Escale, Ne )
    call tendency_z_p255_kernel<<<nblock_deriv,tile_threads,0,dg_stream>>>( &
      dqdt, q, w, D1D, Lift1D, flux_bnd, Escale, Ne )
    istat = cudaGetLastError()
    if (istat /= cudaSuccess) call cuda_failure("p=255 tendency kernels",istat)
    call dg_ev_record(2)
    call dg_ev_end(DG_EV_SINGLE)

    kernel_time(1) = dg_kernel_time(1)
    kernel_time(2) = dg_kernel_time(2)
  end subroutine cuda_cal_dqdt_fused_p255

  subroutine cuda_cal_dqdt_fused_tc( &
    dqdt, q, u, v, w, D1D, Lift1D, VMapM, VMapP, &
    normal_fn, Fscale, Escale, &
    Nq, Np, NfpTot, Ne, NeA, kernel_time )
    implicit none
    integer, intent(in) :: Nq, Np, NfpTot, Ne, NeA
    real(RP), device, intent(out) :: dqdt(Np,NeA)
    real(RP), device, intent(in) :: q(Np,NeA)
    real(RP), device, intent(in) :: u(Np,NeA), v(Np,NeA), w(Np,NeA)
    real(RP), device, intent(in) :: D1D(Nq,Nq)
    real(RP), device, intent(in) :: Lift1D(Nq,6)
    integer, device, intent(in) :: VMapM(NfpTot,Ne)
    integer, device, intent(in) :: VMapP(NfpTot,Ne)
    real(RP), device, intent(in) :: normal_fn(NfpTot,Ne,3)
    real(RP), device, intent(in) :: Fscale(NfpTot,Ne)
    real(RP), device, intent(in) :: Escale(Np,Ne,3)
    real(RP), intent(out) :: kernel_time(2)

    integer :: istat

    if (Nq /= 8) then
      write(*,*) "CUDAFORTRAN_FUSED_TC currently requires PolyOrder=7"
      error stop
    end if
    call dg_ev_begin()

    call dg_ev_record(1)
    call launch_tendency_fused_p7_tc( &
      dqdt, D1D, Lift1D, q, u, v, w, VMapM, VMapP, &
      normal_fn, Fscale, Escale, int(Ne,c_int) )
    istat = cudaGetLastError()
    if (istat /= cudaSuccess) call cuda_failure( &
      "tendency_fused_p7_tc_kernel",istat)
    call dg_ev_record(2)
    call dg_ev_end(DG_EV_SINGLE)

    kernel_time(1) = dg_kernel_time(1)
    kernel_time(2) = dg_kernel_time(2)
  end subroutine cuda_cal_dqdt_fused_tc

  subroutine cuda_cal_dqdt_fused_p255_tc( &
    dqdt, q, u, v, w, D1D, Lift1D, VMapM, VMapP, &
    normal_fn, Fscale, Escale, flux_bnd, &
    Nq, Np, NfpTot, Ne, NeA, kernel_time )
    implicit none
    integer, intent(in) :: Nq, Np, NfpTot, Ne, NeA
    real(RP), device, intent(out) :: dqdt(Np,NeA)
    real(RP), device, intent(in) :: q(Np,NeA)
    real(RP), device, intent(in) :: u(Np,NeA), v(Np,NeA), w(Np,NeA)
    real(RP), device, intent(in) :: D1D(Nq,Nq)
    real(RP), device, intent(in) :: Lift1D(Nq,6)
    integer, device, intent(in) :: VMapM(NfpTot,Ne)
    integer, device, intent(in) :: VMapP(NfpTot,Ne)
    real(RP), device, intent(in) :: normal_fn(NfpTot,Ne,3)
    real(RP), device, intent(in) :: Fscale(NfpTot,Ne)
    real(RP), device, intent(in) :: Escale(Np,Ne,3)
    real(RP), device, intent(out) :: flux_bnd(NfpTot,Ne)
    real(RP), intent(out) :: kernel_time(2)

    integer :: istat, nface, nblock_face

    if (Nq /= CUDA_P255_NQ .or. Np /= CUDA_P255_NQ**3) then
      error stop "cuda_cal_dqdt_fused_p255_tc requires PolyOrder=255"
    end if
    call dg_ev_begin()

    nface = NfpTot*Ne
    nblock_face = (nface+CUDA_BLOCK_SIZE-1)/CUDA_BLOCK_SIZE

    call dg_ev_record(1)
    call elembnd_flux_kernel<<<nblock_face,CUDA_BLOCK_SIZE,0,dg_stream>>>( &
      flux_bnd, q, u, v, w, VMapM, VMapP, normal_fn, Fscale, nface )
    call launch_tendency_xyz_p255_tc( &
      dqdt, q, u, v, w, D1D, Lift1D, flux_bnd, Escale, int(Ne,c_int) )
    istat = cudaGetLastError()
    if (istat /= cudaSuccess) call cuda_failure("p=255 TC tendency kernels",istat)
    call dg_ev_record(2)
    call dg_ev_end(DG_EV_SINGLE)

    kernel_time(1) = dg_kernel_time(1)
    kernel_time(2) = dg_kernel_time(2)
  end subroutine cuda_cal_dqdt_fused_p255_tc

  !> Select the MMA instruction shape of the CUTLASS volume GEMMs.
  !!
  !! 0 = SM80 8x8x4 (the default), 1 = SM90 16x8x4, 2 = SM90 16x8x8,
  !! 3 = SM90 16x8x16. The
  !! matching kernels are all instantiated in cuda_cutlass_gemm_fused.cu, so
  !! this only picks which one is launched.
  subroutine cuda_cutlass_set_mma_shape(shape_id)
    implicit none
    integer, intent(in) :: shape_id

    if (shape_id < 0 .or. shape_id > 3) then
      write(*,*) "cuda_cutlass_set_mma_shape: unsupported shape id ", shape_id
      error stop
    end if
    cutlass_mma_shape_id = int(shape_id, c_int)
  end subroutine cuda_cutlass_set_mma_shape

  subroutine cuda_gemm_setup(emulate)
    implicit none
    logical, intent(in) :: emulate
    integer :: istat
    integer(c_int) :: emulate_flag

    emulate_flag = 0
    if (emulate) emulate_flag = 1
    istat = cublas_gemm_init(emulate_flag)
    if (istat /= 0) call cuda_failure("cublas_gemm_init",istat)
    gemm_inited = .true.
  end subroutine cuda_gemm_setup

  subroutine cuda_gemm_finalize()
    implicit none
    integer :: istat

    if (gemm_inited) then
      istat = cublas_gemm_finalize()
      if (istat /= 0) call cuda_failure("cublas_gemm_finalize",istat)
      gemm_inited = .false.
    end if
  end subroutine cuda_gemm_finalize

  subroutine cuda_cal_dqdt_gemm( &
    dqdt, q, u, v, w, D1D, D1D_tr, Lift1D, VMapM, VMapP, &
    normal_fn, Fscale, Escale, flux_bnd, &
    flux_x, flux_y, flux_z, deriv_x, deriv_y, deriv_z, lift_out, &
    Nq, Np, NfpTot, Ne, NeA, kernel_time )
    implicit none
    integer, intent(in) :: Nq, Np, NfpTot, Ne, NeA
    real(RP), device, intent(out) :: dqdt(Np,NeA)
    real(RP), device, intent(in) :: q(Np,NeA)
    real(RP), device, intent(in) :: u(Np,NeA), v(Np,NeA), w(Np,NeA)
    real(RP), device, intent(in) :: D1D(Nq,Nq), D1D_tr(Nq,Nq)
    real(RP), device, intent(in) :: Lift1D(Nq,6)
    integer, device, intent(in) :: VMapM(NfpTot,Ne), VMapP(NfpTot,Ne)
    real(RP), device, intent(in) :: normal_fn(NfpTot,Ne,3)
    real(RP), device, intent(in) :: Fscale(NfpTot,Ne)
    real(RP), device, intent(in) :: Escale(Np,Ne,3)
    real(RP), device, intent(out) :: flux_bnd(NfpTot,Ne)
    real(RP), device, intent(out) :: flux_x(Np,Ne), flux_y(Np,Ne), flux_z(Np,Ne)
    real(RP), device, intent(out) :: deriv_x(Np,Ne), deriv_y(Np,Ne), deriv_z(Np,Ne)
    real(RP), device, intent(out) :: lift_out(Np,Ne)
    real(RP), intent(out) :: kernel_time(2)

    integer :: istat, nface, npoint, nblock, nblock_face
    integer :: nq2, plane_batch
    integer(c_long_long) :: stride_plane, stride_elem, stride_zero, stride_vol
    logical :: use_side

    if (.not. gemm_inited) then
      call cuda_gemm_setup(.false.)
    end if

    call dg_ev_begin()

    nq2 = Nq*Nq
    nface = NfpTot*Ne
    npoint = Np*Ne
    nblock = (npoint+CUDA_BLOCK_SIZE-1)/CUDA_BLOCK_SIZE
    nblock_face = (nface+CUDA_BLOCK_SIZE-1)/CUDA_BLOCK_SIZE
    plane_batch = Nq*Ne
    stride_plane = int(nq2,c_long_long)
    stride_elem = int(NfpTot,c_long_long)
    stride_zero = 0_c_long_long
    stride_vol = int(Np,c_long_long)

    call dg_ev_record(1)

    ! flux_bnd is not read until the lift, so the boundary flux can run on the
    ! second stream underneath the volume GEMMs.  See cuda_cal_dqdt_gemm_fused.
    ! At p=7 it must not: there the boundary flux is 181 us while the volume
    ! GEMMs are 24 launches of 8x8 matrices, so it is far larger than the
    ! window it would hide in and overlapping the two loses 3.1%.
    use_side = dg_side_enabled .and. (Nq == CUDA_P255_NQ)

    if (.not. use_side) then
      call elembnd_flux_kernel<<<nblock_face,CUDA_BLOCK_SIZE,0,dg_stream>>>( &
        flux_bnd, q, u, v, w, VMapM, VMapP, normal_fn, Fscale, nface )
    end if

    call launch_volume_flux( &
      flux_x, flux_y, flux_z, q, u, v, w, npoint )

    if (use_side) then
      call dg_side_fork()
      call elembnd_flux_kernel<<<nblock_face,CUDA_BLOCK_SIZE,0,dg_side_stream>>>( &
        flux_bnd, q, u, v, w, VMapM, VMapP, normal_fn, Fscale, nface )
    end if

    istat = cublas_dgemm_impl(0, 0, Nq, nq2*Ne, Nq, 1.0_c_double, &
      D1D, Nq, flux_x, Nq, 0.0_c_double, deriv_x, Nq)
    if (istat /= 0) call cuda_failure("cublasDgemm x-deriv",istat)

    istat = cublas_dgemm_strided_batched_impl(0, 0, Nq, Nq, Nq, 1.0_c_double, &
      flux_y, Nq, stride_plane, D1D_tr, Nq, stride_zero, 0.0_c_double, &
      deriv_y, Nq, stride_plane, plane_batch)
    if (istat /= 0) call cuda_failure("cublasDgemm y-deriv",istat)

    istat = cublas_dgemm_strided_batched_impl(0, 0, nq2, Nq, Nq, 1.0_c_double, &
      flux_z, nq2, stride_vol, D1D_tr, Nq, stride_zero, 0.0_c_double, &
      deriv_z, nq2, stride_vol, Ne)
    if (istat /= 0) call cuda_failure("cublasDgemm z-deriv",istat)

    if (use_side) call dg_side_join()

    call separable_lift_kernel<<<nblock,CUDA_BLOCK_SIZE,0,dg_stream>>>( &
      lift_out, flux_bnd, Lift1D, Nq, Np, npoint )

    call dqdt_assembly_kernel<<<nblock,CUDA_BLOCK_SIZE,0,dg_stream>>>( &
      dqdt, Escale, deriv_x, deriv_y, deriv_z, lift_out, npoint )

    istat = cudaGetLastError()
    if (istat /= cudaSuccess) call cuda_failure("CUDAFORTRAN_GEMM kernels",istat)
    call dg_ev_record(2)
    call dg_ev_end(DG_EV_SINGLE)

    kernel_time(1) = dg_kernel_time(1)
    kernel_time(2) = dg_kernel_time(2)
  end subroutine cuda_cal_dqdt_gemm

  subroutine cuda_cal_dqdt_gemm_cute( &
    dqdt, q, u, v, w, D1D, D1D_tr, Lift1D, VMapM, VMapP, &
    normal_fn, Fscale, Escale, flux_bnd, &
    flux_x, flux_y, flux_z, deriv_x, deriv_y, deriv_z, lift_out, &
    Nq, Np, NfpTot, Ne, NeA, kernel_time )
    implicit none
    integer, intent(in) :: Nq, Np, NfpTot, Ne, NeA
    real(RP), device, intent(out) :: dqdt(Np,NeA)
    real(RP), device, intent(in) :: q(Np,NeA)
    real(RP), device, intent(in) :: u(Np,NeA), v(Np,NeA), w(Np,NeA)
    real(RP), device, intent(in) :: D1D(Nq,Nq), D1D_tr(Nq,Nq)
    real(RP), device, intent(in) :: Lift1D(Nq,6)
    integer, device, intent(in) :: VMapM(NfpTot,Ne), VMapP(NfpTot,Ne)
    real(RP), device, intent(in) :: normal_fn(NfpTot,Ne,3)
    real(RP), device, intent(in) :: Fscale(NfpTot,Ne)
    real(RP), device, intent(in) :: Escale(Np,Ne,3)
    real(RP), device, intent(out) :: flux_bnd(NfpTot,Ne)
    real(RP), device, intent(out) :: flux_x(Np,Ne), flux_y(Np,Ne), flux_z(Np,Ne)
    real(RP), device, intent(out) :: deriv_x(Np,Ne), deriv_y(Np,Ne), deriv_z(Np,Ne)
    real(RP), device, intent(out) :: lift_out(Np,Ne)
    real(RP), intent(out) :: kernel_time(2)

    integer :: istat, nface, npoint, nblock, nblock_face
    integer :: nq2, plane_batch
    integer(c_long_long) :: stride_plane, stride_elem, stride_zero, stride_vol

    if (Nq /= CUDA_P255_NQ) then
      error stop "cuda_cal_dqdt_gemm_cute currently requires PolyOrder=255"
    end if
    if (.not. gemm_inited) then
      call cuda_gemm_setup(.false.)
    end if

    call dg_ev_begin()

    nq2 = Nq*Nq
    nface = NfpTot*Ne
    npoint = Np*Ne
    nblock = (npoint+CUDA_BLOCK_SIZE-1)/CUDA_BLOCK_SIZE
    nblock_face = (nface+CUDA_BLOCK_SIZE-1)/CUDA_BLOCK_SIZE
    plane_batch = Nq*Ne
    stride_plane = int(nq2,c_long_long)
    stride_elem = int(NfpTot,c_long_long)
    stride_zero = 0_c_long_long
    stride_vol = int(Np,c_long_long)

    call dg_ev_record(1)

    ! flux_bnd is not read until the lift, so the boundary flux runs on the
    ! second stream underneath the volume GEMMs.  See cuda_cal_dqdt_gemm_fused.
    ! Keep the original order when the second stream is off: the boundary flux
    ! reads q through VMapM / VMapP, and it is measurably cheaper before the
    ! volume flux has streamed q, u, v and w past it through L2.
    if (.not. dg_side_enabled) then
      call elembnd_flux_kernel<<<nblock_face,CUDA_BLOCK_SIZE,0,dg_stream>>>( &
        flux_bnd, q, u, v, w, VMapM, VMapP, normal_fn, Fscale, nface )
    end if

    call launch_volume_flux( &
      flux_x, flux_y, flux_z, q, u, v, w, npoint )

    call dg_ev_record(2)

    if (dg_side_enabled) then
      call dg_side_fork()
      call elembnd_flux_kernel<<<nblock_face,CUDA_BLOCK_SIZE,0,dg_side_stream>>>( &
        flux_bnd, q, u, v, w, VMapM, VMapP, normal_fn, Fscale, nface )
    end if

    istat = launch_volume_gemm_cute( &
      deriv_x, deriv_y, deriv_z, flux_x, flux_y, flux_z, D1D, D1D_tr, Nq, Ne, &
      cutlass_mma_shape_id )
    if (istat /= 0) call cuda_failure("launch_volume_gemm_cute",istat)

    call dg_ev_record(3)

    if (dg_side_enabled) call dg_side_join()

    call separable_lift_kernel<<<nblock,CUDA_BLOCK_SIZE,0,dg_stream>>>( &
      lift_out, flux_bnd, Lift1D, Nq, Np, npoint )

    call dqdt_assembly_kernel<<<nblock,CUDA_BLOCK_SIZE,0,dg_stream>>>( &
      dqdt, Escale, deriv_x, deriv_y, deriv_z, lift_out, npoint )

    istat = cudaGetLastError()
    if (istat /= cudaSuccess) call cuda_failure("CUDAFORTRAN_GEMM_CUTE kernels",istat)
    call dg_ev_record(4)
    call dg_ev_end(DG_EV_CUTE)

    kernel_time(1) = dg_kernel_time(1)
    kernel_time(2) = dg_kernel_time(2)
  end subroutine cuda_cal_dqdt_gemm_cute

  subroutine cuda_cal_dqdt_gemm_fused( &
    dqdt, q, u, v, w, D1D, D1D_tr, Lift1D, VMapM, VMapP, &
    normal_fn, Fscale, Escale, flux_bnd, &
    flux_x, flux_y, flux_z, deriv_x, deriv_y, &
    Nq, Np, NfpTot, Ne, NeA, kernel_time )
    implicit none
    integer, intent(in) :: Nq, Np, NfpTot, Ne, NeA
    real(RP), device, intent(out) :: dqdt(Np,NeA)
    real(RP), device, intent(in) :: q(Np,NeA)
    real(RP), device, intent(in) :: u(Np,NeA), v(Np,NeA), w(Np,NeA)
    real(RP), device, intent(in) :: D1D(Nq,Nq), D1D_tr(Nq,Nq)
    real(RP), device, intent(in) :: Lift1D(Nq,6)
    integer, device, intent(in) :: VMapM(NfpTot,Ne), VMapP(NfpTot,Ne)
    real(RP), device, intent(in) :: normal_fn(NfpTot,Ne,3)
    real(RP), device, intent(in) :: Fscale(NfpTot,Ne)
    real(RP), device, intent(in) :: Escale(Np,Ne,3)
    real(RP), device, intent(out) :: flux_bnd(NfpTot,Ne)
    real(RP), device, intent(out) :: flux_x(Np,Ne), flux_y(Np,Ne), flux_z(Np,Ne)
    real(RP), device, intent(out) :: deriv_x(Np,Ne), deriv_y(Np,Ne)
    real(RP), intent(out) :: kernel_time(2)

    integer :: istat, nface, npoint, nblock, nblock_face
    integer :: nq2, plane_batch
    integer(c_long_long) :: stride_plane, stride_elem, stride_zero, stride_vol

    if (Nq /= CUDA_P255_NQ) then
      error stop "cuda_cal_dqdt_gemm_fused currently requires PolyOrder=255"
    end if
    if (.not. gemm_inited) then
      call cuda_gemm_setup(.false.)
    end if

    call dg_ev_begin()

    nq2 = Nq*Nq
    nface = NfpTot*Ne
    npoint = Np*Ne
    nblock = (npoint+CUDA_BLOCK_SIZE-1)/CUDA_BLOCK_SIZE
    nblock_face = (nface+CUDA_BLOCK_SIZE-1)/CUDA_BLOCK_SIZE
    plane_batch = Nq*Ne
    stride_plane = int(nq2,c_long_long)
    stride_elem = int(NfpTot,c_long_long)
    stride_zero = 0_c_long_long
    stride_vol = int(Np,c_long_long)

    call dg_ev_record(1)

    ! flux_bnd is not read until the z GEMM epilogue evaluates the lift, so the
    ! element boundary flux runs on the second stream underneath the volume
    ! GEMMs.  On nsys it lands entirely inside the x GEMM, which holds the SM
    ! at 88% SM throughput but only 10% DRAM throughput: the boundary flux
    ! slots into the tail of its block waves.  Splitting the volume flux the
    ! same way does not work, see the note in the reports.
    ! Keep the original order when the second stream is off: the boundary flux
    ! reads q through VMapM / VMapP, and it is measurably cheaper before the
    ! volume flux has streamed q, u, v and w past it through L2.
    if (.not. dg_side_enabled) then
      call elembnd_flux_kernel<<<nblock_face,CUDA_BLOCK_SIZE,0,dg_stream>>>( &
        flux_bnd, q, u, v, w, VMapM, VMapP, normal_fn, Fscale, nface )
    end if

    call launch_volume_flux( &
      flux_x, flux_y, flux_z, q, u, v, w, npoint )

    call dg_ev_record(2)

    if (dg_side_enabled) then
      call dg_side_fork()
      call elembnd_flux_kernel<<<nblock_face,CUDA_BLOCK_SIZE,0,dg_side_stream>>>( &
        flux_bnd, q, u, v, w, VMapM, VMapP, normal_fn, Fscale, nface )
    end if

    istat = launch_volume_gemm_xy( &
      deriv_x, deriv_y, flux_x, flux_y, D1D, D1D_tr, Nq, Ne, &
      cutlass_mma_shape_id )
    if (istat /= 0) call cuda_failure("launch_volume_gemm_xy",istat)

    call dg_ev_record(3)

    if (dg_side_enabled) call dg_side_join()

    call dg_ev_record(4)

    ! The lift is evaluated inside the z epilogue, so lift_out is never formed.
    istat = launch_z_gemm_assembly( &
      dqdt, flux_z, D1D_tr, deriv_x, deriv_y, flux_bnd, Lift1D, Escale, Nq, Ne, &
      cutlass_mma_shape_id )
    if (istat /= 0) call cuda_failure("launch_z_gemm_assembly",istat)

    istat = cudaGetLastError()
    if (istat /= cudaSuccess) call cuda_failure("CUDAFORTRAN_GEMM_FUSED kernels",istat)
    call dg_ev_record(5)
    call dg_ev_end(DG_EV_GEMM_FUSED)

    kernel_time(1) = dg_kernel_time(1)
    kernel_time(2) = dg_kernel_time(2)
  end subroutine cuda_cal_dqdt_gemm_fused

  subroutine cuda_cal_dqdt_split( &
    flux_x, flux_y, flux_z, deriv_x, deriv_y, deriv_z, lift_out, dqdt, &
    q, u, v, w, D1D, D1D_tr, Lift_mat, flux_bnd, Escale, &
    Nq, Np, NfpTot, Ne, NeA, kernel_time )
    implicit none
    integer, intent(in) :: Nq, Np, NfpTot, Ne, NeA
    real(RP), device, intent(out) :: flux_x(Np,Ne), flux_y(Np,Ne), flux_z(Np,Ne)
    real(RP), device, intent(out) :: deriv_x(Np,Ne), deriv_y(Np,Ne), deriv_z(Np,Ne)
    real(RP), device, intent(out) :: lift_out(Np,Ne), dqdt(Np,NeA)
    real(RP), device, intent(in) :: q(Np,NeA), u(Np,NeA), v(Np,NeA), w(Np,NeA)
    real(RP), device, intent(in) :: D1D(Nq,Nq), D1D_tr(Nq,Nq)
    real(RP), device, intent(in) :: Lift_mat(Nq,Nq,Nq,6), flux_bnd(NfpTot,Ne)
    real(RP), device, intent(in) :: Escale(Np,Ne,3)
    real(RP), intent(out) :: kernel_time(4)

    integer :: istat, npoint, nblock

    call dg_ev_begin()

    npoint = Np*Ne
    nblock = (npoint+CUDA_BLOCK_SIZE-1)/CUDA_BLOCK_SIZE
    call dg_ev_record(1)

    call launch_volume_flux( &
      flux_x, flux_y, flux_z, q, u, v, w, npoint )
    istat = cudaGetLastError()
    if (istat /= cudaSuccess) call cuda_failure("volume_flux_kernel",istat)
    call dg_ev_record(2)

    if (Nq == 8) then
      call volume_deriv_p7_kernel<<<Ne,CUDA_P7_BLOCK_SIZE,0,dg_stream>>>( &
        deriv_x, deriv_y, deriv_z, D1D, D1D_tr, flux_x, flux_y, flux_z, Ne )
    else
      call volume_deriv_kernel<<<nblock,CUDA_BLOCK_SIZE,0,dg_stream>>>( &
        deriv_x, deriv_y, deriv_z, D1D, D1D_tr, &
        flux_x, flux_y, flux_z, Nq, Np, npoint )
    end if
    istat = cudaGetLastError()
    if (istat /= cudaSuccess) call cuda_failure("volume_deriv_kernel",istat)
    call dg_ev_record(3)

    if (Nq == 8) then
      call surface_lift_p7_kernel<<<Ne,CUDA_P7_BLOCK_SIZE,0,dg_stream>>>( &
        lift_out, Lift_mat, flux_bnd, Ne )
    else
      call surface_lift_kernel<<<nblock,CUDA_BLOCK_SIZE,0,dg_stream>>>( &
        lift_out, Lift_mat, flux_bnd, Nq, Np, NfpTot, npoint )
    end if
    istat = cudaGetLastError()
    if (istat /= cudaSuccess) call cuda_failure("surface_lift_kernel",istat)
    call dg_ev_record(4)

    call dqdt_assembly_kernel<<<nblock,CUDA_BLOCK_SIZE,0,dg_stream>>>( &
      dqdt, Escale, deriv_x, deriv_y, deriv_z, lift_out, npoint )
    istat = cudaGetLastError()
    if (istat /= cudaSuccess) call cuda_failure("dqdt_assembly_kernel",istat)
    call dg_ev_record(5)
    call dg_ev_end(DG_EV_SPLIT)

    kernel_time(1:4) = dg_kernel_time(1:4)
  end subroutine cuda_cal_dqdt_split
  ! Separable surface lift. Lift1D(:,f) is the 1D lift profile of face f and
  ! flux_bnd holds the six face planes, so the lift at node (i,j,k) is the sum
  ! of three rank-2 terms. Writing lift_out once replaces the three K=2 GEMMs,
  ! which read and rewrote the whole volume twice to accumulate into it.
  attributes(global) subroutine separable_lift_kernel( &
    lift_out, flux_bnd, Lift1D, Nq, Np, npoint )
    implicit none
    integer, value :: Nq, Np, npoint
    real(RP), device :: lift_out(*)
    real(RP), device :: flux_bnd(*), Lift1D(*)

    integer :: idx, node, elem, nq2, base
    integer :: i, j, k
    real(RP) :: lx, ly, lz

    idx = (blockIdx%x-1)*blockDim%x + threadIdx%x
    if (idx <= npoint) then
      nq2 = Nq*Nq
      node = mod(idx-1,Np)
      elem = (idx-1)/Np
      i = mod(node,Nq)
      j = mod(node/Nq,Nq)
      k = node/nq2
      base = elem*6*nq2

      lx = Lift1D(  Nq+i+1)*flux_bnd(base+  nq2+j+k*Nq+1) &
         + Lift1D(3*Nq+i+1)*flux_bnd(base+3*nq2+j+k*Nq+1)
      ly = Lift1D(     j+1)*flux_bnd(base+      i+k*Nq+1) &
         + Lift1D(2*Nq+j+1)*flux_bnd(base+2*nq2+i+k*Nq+1)
      lz = Lift1D(4*Nq+k+1)*flux_bnd(base+4*nq2+i+j*Nq+1) &
         + Lift1D(5*Nq+k+1)*flux_bnd(base+5*nq2+i+j*Nq+1)

      lift_out(idx) = (lx + ly) + lz
    end if
  end subroutine separable_lift_kernel

  ! The four operands are read into registers before any store is issued.
  ! Written as three q(idx)*vel expressions instead, nvfortran interleaved the
  ! loads with the stores and reloaded q for each one: ncu measured 6 global
  ! load instructions per warp instead of 4, DRAM throughput 65.7% with no unit
  ! saturated (L1 52.5%, SM 33.7%), i.e. latency bound.  Batching the loads
  ! took the kernel from 150.6 to 125.9 us at p=255 (DRAM 83.4%, 7.1 TB/s).
  ! Hoisting only q changes nothing; the store-free load window is the point.
  attributes(global) subroutine volume_flux_kernel( &
    flux_x, flux_y, flux_z, q, u, v, w, npoint )
    implicit none
    integer, value :: npoint
    real(RP), device :: flux_x(*), flux_y(*), flux_z(*)
    real(RP), device :: q(*), u(*), v(*), w(*)

    integer :: idx
    real(RP) :: qi, ui, vi, wi

    idx = (blockIdx%x-1)*blockDim%x + threadIdx%x
    if (idx <= npoint) then
      qi = q(idx)
      ui = u(idx)
      vi = v(idx)
      wi = w(idx)
      flux_x(idx) = qi*ui
      flux_y(idx) = qi*vi
      flux_z(idx) = qi*wi
    end if
  end subroutine volume_flux_kernel

  subroutine launch_volume_flux( &
    flux_x, flux_y, flux_z, q, u, v, w, npoint )
    implicit none
    integer, intent(in) :: npoint
    real(RP), device :: flux_x(*), flux_y(*), flux_z(*)
    real(RP), device :: q(*), u(*), v(*), w(*)

    integer :: nblock_flux

    nblock_flux = (npoint+CUDA_BLOCK_SIZE-1)/CUDA_BLOCK_SIZE
    call volume_flux_kernel<<<nblock_flux,CUDA_BLOCK_SIZE,0,dg_stream>>>( &
      flux_x, flux_y, flux_z, q, u, v, w, npoint )
  end subroutine launch_volume_flux

  attributes(global) subroutine volume_deriv_kernel( &
    deriv_x, deriv_y, deriv_z, D1D, D1D_tr, &
    flux_x, flux_y, flux_z, Nq, Np, npoint )
    implicit none
    integer, value :: Nq, Np, npoint
    real(RP), device :: deriv_x(*), deriv_y(*), deriv_z(*)
    real(RP), device :: D1D(*), D1D_tr(*)
    real(RP), device :: flux_x(*), flux_y(*), flux_z(*)

    integer :: idx, node, elem_offset
    integer :: i, j, k, l, nq2
    integer :: ix, iy, iz
    real(RP) :: sum_x, sum_y, sum_z

    idx = (blockIdx%x-1)*blockDim%x + threadIdx%x
    nq2 = Nq*Nq

    if (idx <= npoint) then
      node = mod(idx-1,Np) + 1
      elem_offset = idx - node
      i = mod(node-1,Nq) + 1
      j = mod((node-1)/Nq,Nq) + 1
      k = (node-1)/nq2 + 1

      sum_x = 0.0_RP
      sum_y = 0.0_RP
      sum_z = 0.0_RP
      do l = 1, Nq
        ix = elem_offset + l + (j-1)*Nq + (k-1)*nq2
        iy = elem_offset + i + (l-1)*Nq + (k-1)*nq2
        iz = elem_offset + i + (j-1)*Nq + (l-1)*nq2
        sum_x = sum_x + D1D(i+(l-1)*Nq)*flux_x(ix)
        sum_y = sum_y + D1D_tr(l+(j-1)*Nq)*flux_y(iy)
        sum_z = sum_z + D1D_tr(l+(k-1)*Nq)*flux_z(iz)
      end do

      deriv_x(idx) = sum_x
      deriv_y(idx) = sum_y
      deriv_z(idx) = sum_z
    end if
  end subroutine volume_deriv_kernel

  !> Polynomial-order-7 derivative kernel.  One CUDA block owns one
  !! element, so values reused by the three tensor contractions are read
  !! from global memory once and then served from shared memory.
  attributes(global) subroutine volume_deriv_p7_kernel( &
    deriv_x, deriv_y, deriv_z, D1D, D1D_tr, &
    flux_x, flux_y, flux_z, Ne )
    implicit none
    integer, value :: Ne
    real(RP), device :: deriv_x(*), deriv_y(*), deriv_z(*)
    real(RP), device :: D1D(*), D1D_tr(*)
    real(RP), device :: flux_x(*), flux_y(*), flux_z(*)

    real(RP), shared :: sD1D(64), sD1D_tr(64)
    real(RP), shared :: sflux_x(512), sflux_y(512), sflux_z(512)
    integer :: elem, elem_offset, tid, node, i, j, k, l
    integer :: ix, iy, iz
    real(RP) :: sum_x, sum_y, sum_z

    elem = blockIdx%x
    if (elem > Ne) return

    tid = threadIdx%x
    elem_offset = (elem-1)*512

    if (tid <= 64) then
      sD1D(tid) = D1D(tid)
      sD1D_tr(tid) = D1D_tr(tid)
    end if
    node = tid
    sflux_x(node) = flux_x(elem_offset+node)
    sflux_y(node) = flux_y(elem_offset+node)
    sflux_z(node) = flux_z(elem_offset+node)
    call syncthreads()

    i = mod(node-1,8) + 1
    j = mod((node-1)/8,8) + 1
    k = (node-1)/64 + 1

    sum_x = 0.0_RP
    sum_y = 0.0_RP
    sum_z = 0.0_RP
    do l = 1, 8
      ix = l + (j-1)*8 + (k-1)*64
      iy = i + (l-1)*8 + (k-1)*64
      iz = i + (j-1)*8 + (l-1)*64
      sum_x = sum_x + sD1D(i+(l-1)*8)*sflux_x(ix)
      sum_y = sum_y + sD1D_tr(l+(j-1)*8)*sflux_y(iy)
      sum_z = sum_z + sD1D_tr(l+(k-1)*8)*sflux_z(iz)
    end do

    deriv_x(elem_offset+node) = sum_x
    deriv_y(elem_offset+node) = sum_y
    deriv_z(elem_offset+node) = sum_z
  end subroutine volume_deriv_p7_kernel

  !> Form the p=7 volume fluxes directly in shared memory and immediately
  !! apply the tensor-product derivative, avoiding three global work arrays.
  attributes(global) subroutine volume_flux_deriv_p7_kernel( &
    deriv_x, deriv_y, deriv_z, D1D, D1D_tr, q, u, v, w, Ne )
    implicit none
    integer, value :: Ne
    real(RP), device :: deriv_x(*), deriv_y(*), deriv_z(*)
    real(RP), device :: D1D(*), D1D_tr(*)
    real(RP), device :: q(*), u(*), v(*), w(*)

    real(RP), shared :: sD1D(64), sD1D_tr(64)
    real(RP), shared :: sflux_x(512), sflux_y(512), sflux_z(512)
    integer :: elem, elem_offset, tid, node1, node2, i, j, k1, k2, l
    integer :: ix1, iy1, iz, ix2, iy2
    real(RP) :: q_node, mat_x, mat_y, mat_z1, mat_z2
    real(RP) :: sum_x1, sum_y1, sum_z1, sum_x2, sum_y2, sum_z2

    elem = blockIdx%x
    if (elem > Ne) return

    tid = threadIdx%x
    node1 = tid
    node2 = tid + 256
    elem_offset = (elem-1)*512

    if (tid <= 64) then
      sD1D(tid) = D1D(tid)
      sD1D_tr(tid) = D1D_tr(tid)
    end if
    q_node = q(elem_offset+node1)
    sflux_x(node1) = q_node*u(elem_offset+node1)
    sflux_y(node1) = q_node*v(elem_offset+node1)
    sflux_z(node1) = q_node*w(elem_offset+node1)
    q_node = q(elem_offset+node2)
    sflux_x(node2) = q_node*u(elem_offset+node2)
    sflux_y(node2) = q_node*v(elem_offset+node2)
    sflux_z(node2) = q_node*w(elem_offset+node2)
    call syncthreads()

    i = mod(node1-1,8) + 1
    j = mod((node1-1)/8,8) + 1
    k1 = (node1-1)/64 + 1
    k2 = k1 + 4

    sum_x1 = 0.0_RP
    sum_y1 = 0.0_RP
    sum_z1 = 0.0_RP
    sum_x2 = 0.0_RP
    sum_y2 = 0.0_RP
    sum_z2 = 0.0_RP
    do l = 1, 8
      ix1 = l + (j-1)*8 + (k1-1)*64
      iy1 = i + (l-1)*8 + (k1-1)*64
      iz = i + (j-1)*8 + (l-1)*64
      ix2 = ix1 + 256
      iy2 = iy1 + 256
      mat_x = sD1D(i+(l-1)*8)
      mat_y = sD1D_tr(l+(j-1)*8)
      mat_z1 = sD1D_tr(l+(k1-1)*8)
      mat_z2 = sD1D_tr(l+(k2-1)*8)
      sum_x1 = sum_x1 + mat_x*sflux_x(ix1)
      sum_y1 = sum_y1 + mat_y*sflux_y(iy1)
      sum_z1 = sum_z1 + mat_z1*sflux_z(iz)
      sum_x2 = sum_x2 + mat_x*sflux_x(ix2)
      sum_y2 = sum_y2 + mat_y*sflux_y(iy2)
      sum_z2 = sum_z2 + mat_z2*sflux_z(iz)
    end do

    deriv_x(elem_offset+node1) = sum_x1
    deriv_y(elem_offset+node1) = sum_y1
    deriv_z(elem_offset+node1) = sum_z1
    deriv_x(elem_offset+node2) = sum_x2
    deriv_y(elem_offset+node2) = sum_y2
    deriv_z(elem_offset+node2) = sum_z2
  end subroutine volume_flux_deriv_p7_kernel

  !> Form volume fluxes, differentiate, lift surface fluxes, and assemble dqdt.
  !! Two nodes with common x/y contraction coefficients are handled per thread.
  attributes(global) subroutine volume_flux_deriv_lift_assembly_p7_kernel( &
    dqdt, Escale, D1D, D1D_tr, Lift_mat, flux_bnd, q, u, v, w, Ne )
    implicit none
    integer, value :: Ne
    real(RP), device :: dqdt(*), Escale(*), D1D(*), D1D_tr(*)
    real(RP), device :: Lift_mat(*), flux_bnd(*), q(*), u(*), v(*), w(*)

    real(RP), shared :: sD1D(64), sD1D_tr(64)
    real(RP), shared :: sflux_x(512), sflux_y(512), sflux_z(512)
    integer :: elem, elem_offset, face_offset, tid, node1, node2
    integer :: i, j, k1, k2, l, ix1, iy1, iz, ix2, iy2
    integer :: face11, face12, face13, face14, face15, face16
    integer :: face21, face22, face23, face24, face25, face26
    integer :: idx1, idx2, npoint
    real(RP) :: q_node, mat_x, mat_y, mat_z1, mat_z2
    real(RP) :: sum_x1, sum_y1, sum_z1, sum_x2, sum_y2, sum_z2
    real(RP) :: lift1, lift2

    elem = blockIdx%x
    if (elem > Ne) return

    tid = threadIdx%x
    node1 = tid
    node2 = tid + 256
    elem_offset = (elem-1)*512
    face_offset = (elem-1)*384

    if (tid <= 64) then
      sD1D(tid) = D1D(tid)
      sD1D_tr(tid) = D1D_tr(tid)
    end if
    q_node = q(elem_offset+node1)
    sflux_x(node1) = q_node*u(elem_offset+node1)
    sflux_y(node1) = q_node*v(elem_offset+node1)
    sflux_z(node1) = q_node*w(elem_offset+node1)
    q_node = q(elem_offset+node2)
    sflux_x(node2) = q_node*u(elem_offset+node2)
    sflux_y(node2) = q_node*v(elem_offset+node2)
    sflux_z(node2) = q_node*w(elem_offset+node2)
    call syncthreads()

    i = mod(node1-1,8) + 1
    j = mod((node1-1)/8,8) + 1
    k1 = (node1-1)/64 + 1
    k2 = k1 + 4

    sum_x1 = 0.0_RP
    sum_y1 = 0.0_RP
    sum_z1 = 0.0_RP
    sum_x2 = 0.0_RP
    sum_y2 = 0.0_RP
    sum_z2 = 0.0_RP
    do l = 1, 8
      ix1 = l + (j-1)*8 + (k1-1)*64
      iy1 = i + (l-1)*8 + (k1-1)*64
      iz = i + (j-1)*8 + (l-1)*64
      ix2 = ix1 + 256
      iy2 = iy1 + 256
      mat_x = sD1D(i+(l-1)*8)
      mat_y = sD1D_tr(l+(j-1)*8)
      mat_z1 = sD1D_tr(l+(k1-1)*8)
      mat_z2 = sD1D_tr(l+(k2-1)*8)
      sum_x1 = sum_x1 + mat_x*sflux_x(ix1)
      sum_y1 = sum_y1 + mat_y*sflux_y(iy1)
      sum_z1 = sum_z1 + mat_z1*sflux_z(iz)
      sum_x2 = sum_x2 + mat_x*sflux_x(ix2)
      sum_y2 = sum_y2 + mat_y*sflux_y(iy2)
      sum_z2 = sum_z2 + mat_z2*sflux_z(iz)
    end do

    face11 = i + (k1-1)*8
    face12 = 64 + j + (k1-1)*8
    face13 = 128 + i + (k1-1)*8
    face14 = 192 + j + (k1-1)*8
    face15 = 256 + i + (j-1)*8
    face16 = 320 + i + (j-1)*8
    face21 = i + (k2-1)*8
    face22 = 64 + j + (k2-1)*8
    face23 = 128 + i + (k2-1)*8
    face24 = 192 + j + (k2-1)*8
    face25 = face15
    face26 = face16

    lift1 = &
        Lift_mat(node1)       *flux_bnd(face_offset+face11) &
      + Lift_mat(node1+512)   *flux_bnd(face_offset+face12) &
      + Lift_mat(node1+1024)  *flux_bnd(face_offset+face13) &
      + Lift_mat(node1+1536)  *flux_bnd(face_offset+face14) &
      + Lift_mat(node1+2048)  *flux_bnd(face_offset+face15) &
      + Lift_mat(node1+2560)  *flux_bnd(face_offset+face16)
    lift2 = &
        Lift_mat(node2)       *flux_bnd(face_offset+face21) &
      + Lift_mat(node2+512)   *flux_bnd(face_offset+face22) &
      + Lift_mat(node2+1024)  *flux_bnd(face_offset+face23) &
      + Lift_mat(node2+1536)  *flux_bnd(face_offset+face24) &
      + Lift_mat(node2+2048)  *flux_bnd(face_offset+face25) &
      + Lift_mat(node2+2560)  *flux_bnd(face_offset+face26)

    idx1 = elem_offset + node1
    idx2 = elem_offset + node2
    npoint = 512*Ne
    dqdt(idx1) = -(Escale(idx1)*sum_x1 + Escale(idx1+npoint)*sum_y1 &
      + Escale(idx1+2*npoint)*sum_z1 + lift1)
    dqdt(idx2) = -(Escale(idx2)*sum_x2 + Escale(idx2+npoint)*sum_y2 &
      + Escale(idx2+2*npoint)*sum_z2 + lift2)
  end subroutine volume_flux_deriv_lift_assembly_p7_kernel

  !> Complete p=7 element tendency for pointwise velocity and geometry fields.
  !! The three volume fluxes and all six face fluxes are staged in shared
  !! memory before differentiation, lifting, and pointwise metric assembly.
  attributes(global) launch_bounds(256,8) subroutine tendency_fused_p7_kernel( &
    dqdt, D1D, Lift1D, q, u, v, w, VMapM, VMapP, &
    normal_fn, Fscale, Escale, Ne )
    implicit none
    integer, value :: Ne
    real(RP), device :: dqdt(*), D1D(*)
    real(RP), device :: Lift1D(*), q(*), u(*), v(*), w(*)
    integer, device :: VMapM(*), VMapP(*)
    real(RP), device :: normal_fn(*), Fscale(*), Escale(*)

    real(RP), shared :: sD1D(64)
    real(RP), shared :: sLift(48)
    real(RP), shared :: sflux_bnd(384)
    real(RP), shared :: sFluxX(512), sFluxY(512), sFluxZ(512)
    integer :: elem, elem_offset, face_offset, tid, node1, node2
    integer :: i, j, k1, k2, l, ix1, iy1, iz, ix2, iy2
    integer :: face11, face12, face13, face14, face15, face16
    integer :: face21, face22, face23, face24, face25, face26
    integer :: idx1, idx2, fp, fidx, iM, iP, npoint, nface
    real(RP) :: mat_x, mat_y, mat_z1, mat_z2
    real(RP) :: sum_x1, sum_y1, sum_z1, sum_x2, sum_y2, sum_z2
    real(RP) :: lift1, lift2, qM, qP, VelM, VelP, alpha

    elem = blockIdx%x
    if (elem > Ne) return

    tid = threadIdx%x
    node1 = tid
    node2 = tid + 256
    elem_offset = (elem-1)*512
    face_offset = (elem-1)*384
    npoint = 512*Ne
    nface = 384*Ne

    if (tid <= 64) then
      sD1D(tid) = D1D(tid)
    else if (tid <= 112) then
      sLift(tid-64) = Lift1D(tid-64)
    end if
    idx1 = elem_offset + node1
    idx2 = elem_offset + node2
    sFluxX(node1) = q(idx1)*u(idx1)
    sFluxY(node1) = q(idx1)*v(idx1)
    sFluxZ(node1) = q(idx1)*w(idx1)
    sFluxX(node2) = q(idx2)*u(idx2)
    sFluxY(node2) = q(idx2)*v(idx2)
    sFluxZ(node2) = q(idx2)*w(idx2)

    fp = tid
    fidx = face_offset + fp
    iM = VMapM(fidx)
    iP = VMapP(fidx)
    qM = q(iM)
    qP = q(iP)
    VelM = u(iM)*normal_fn(fidx) + v(iM)*normal_fn(fidx+nface) &
      + w(iM)*normal_fn(fidx+2*nface)
    VelP = u(iP)*normal_fn(fidx) + v(iP)*normal_fn(fidx+nface) &
      + w(iP)*normal_fn(fidx+2*nface)
    alpha = 0.5_RP*abs(VelP+VelM)
    sflux_bnd(fp) = 0.5_RP*Fscale(fidx)*( &
      qP*VelP-qM*VelM-alpha*(qP-qM))
    if (tid <= 128) then
      fp = tid + 256
      fidx = face_offset + fp
      iM = VMapM(fidx)
      iP = VMapP(fidx)
      qM = q(iM)
      qP = q(iP)
      VelM = u(iM)*normal_fn(fidx) + v(iM)*normal_fn(fidx+nface) &
        + w(iM)*normal_fn(fidx+2*nface)
      VelP = u(iP)*normal_fn(fidx) + v(iP)*normal_fn(fidx+nface) &
        + w(iP)*normal_fn(fidx+2*nface)
      alpha = 0.5_RP*abs(VelP+VelM)
      sflux_bnd(fp) = 0.5_RP*Fscale(fidx)*( &
        qP*VelP-qM*VelM-alpha*(qP-qM))
    end if
    call syncthreads()

    i = mod(node1-1,8) + 1
    j = mod((node1-1)/8,8) + 1
    k1 = (node1-1)/64 + 1
    k2 = k1 + 4
    sum_x1 = 0.0_RP
    sum_y1 = 0.0_RP
    sum_z1 = 0.0_RP
    sum_x2 = 0.0_RP
    sum_y2 = 0.0_RP
    sum_z2 = 0.0_RP
    do l = 1, 8
      ix1 = l + (j-1)*8 + (k1-1)*64
      iy1 = i + (l-1)*8 + (k1-1)*64
      iz = i + (j-1)*8 + (l-1)*64
      ix2 = ix1 + 256
      iy2 = iy1 + 256
      mat_x = sD1D(i+(l-1)*8)
      mat_y = sD1D(j+(l-1)*8)
      mat_z1 = sD1D(k1+(l-1)*8)
      mat_z2 = sD1D(k2+(l-1)*8)
      sum_x1 = sum_x1 + mat_x*sFluxX(ix1)
      sum_y1 = sum_y1 + mat_y*sFluxY(iy1)
      sum_z1 = sum_z1 + mat_z1*sFluxZ(iz)
      sum_x2 = sum_x2 + mat_x*sFluxX(ix2)
      sum_y2 = sum_y2 + mat_y*sFluxY(iy2)
      sum_z2 = sum_z2 + mat_z2*sFluxZ(iz)
    end do

    face11 = i + (k1-1)*8
    face12 = 64 + j + (k1-1)*8
    face13 = 128 + i + (k1-1)*8
    face14 = 192 + j + (k1-1)*8
    face15 = 256 + i + (j-1)*8
    face16 = 320 + i + (j-1)*8
    face21 = i + (k2-1)*8
    face22 = 64 + j + (k2-1)*8
    face23 = 128 + i + (k2-1)*8
    face24 = 192 + j + (k2-1)*8
    face25 = face15
    face26 = face16
    lift1 = sLift(j)*sflux_bnd(face11) &
      + sLift(i+8)*sflux_bnd(face12) &
      + sLift(j+16)*sflux_bnd(face13) &
      + sLift(i+24)*sflux_bnd(face14) &
      + sLift(k1+32)*sflux_bnd(face15) &
      + sLift(k1+40)*sflux_bnd(face16)
    lift2 = sLift(j)*sflux_bnd(face21) &
      + sLift(i+8)*sflux_bnd(face22) &
      + sLift(j+16)*sflux_bnd(face23) &
      + sLift(i+24)*sflux_bnd(face24) &
      + sLift(k2+32)*sflux_bnd(face25) &
      + sLift(k2+40)*sflux_bnd(face26)

    dqdt(idx1) = -(Escale(idx1)*sum_x1 + Escale(idx1+npoint)*sum_y1 &
      + Escale(idx1+2*npoint)*sum_z1 + lift1)
    dqdt(idx2) = -(Escale(idx2)*sum_x2 + Escale(idx2+npoint)*sum_y2 &
      + Escale(idx2+2*npoint)*sum_z2 + lift2)
  end subroutine tendency_fused_p7_kernel

  !> x-direction p=255 tensor-product derivative and x-face lift.
  attributes(global) subroutine tendency_x_p255_kernel( &
    dqdt, q, velocity, D1D, Lift1D, flux_bnd, Escale, Ne )
    implicit none
    integer, value :: Ne
    real(RP), device :: dqdt(*), q(*), velocity(*)
    real(RP), device :: D1D(*), Lift1D(*), flux_bnd(*), Escale(*)

    real(RP), shared :: sD(16,16), sQ(16,16)
    integer :: tx, ty, block0, elem, local_block, k, tile_i, tile_j
    integer :: i, j, ltile, l, t, idx, fp
    integer :: elem_offset, elem_face_offset
    real(RP) :: sum, lift_value

    tx = threadIdx%x
    ty = threadIdx%y
    block0 = blockIdx%x-1
    elem = block0/65536
    if (elem >= Ne) return
    local_block = mod(block0,65536)
    k = local_block/256 + 1
    local_block = mod(local_block,256)
    tile_j = local_block/16
    tile_i = mod(local_block,16)
    i = tile_i*16 + tx
    j = tile_j*16 + ty
    elem_offset = elem*16777216

    sum = 0.0_RP
    do ltile = 0, 15
      l = ltile*16 + ty
      sD(tx,ty) = D1D(i+(l-1)*256)
      l = ltile*16 + tx
      idx = elem_offset+l+(j-1)*256+(k-1)*65536
      sQ(tx,ty) = q(idx)*velocity(idx)
      call syncthreads()
      do t = 1, 16
        sum = sum + sD(tx,t)*sQ(t,ty)
      end do
      call syncthreads()
    end do

    idx = elem_offset+i+(j-1)*256+(k-1)*65536
    fp = j+(k-1)*256
    elem_face_offset = elem*6*65536
    lift_value = Lift1D(i+256)*flux_bnd(elem_face_offset+65536+fp) &
      + Lift1D(i+3*256)*flux_bnd(elem_face_offset+3*65536+fp)
    dqdt(idx) = -(Escale(idx)*sum+lift_value)
  end subroutine tendency_x_p255_kernel

  !> y-direction p=255 tensor-product derivative and y-face lift.
  attributes(global) subroutine tendency_y_p255_kernel( &
    dqdt, q, velocity, D1D, Lift1D, flux_bnd, Escale, Ne )
    implicit none
    integer, value :: Ne
    real(RP), device :: dqdt(*), q(*), velocity(*)
    real(RP), device :: D1D(*), Lift1D(*), flux_bnd(*), Escale(*)

    real(RP), shared :: sD(16,16), sQ(16,16)
    integer :: tx, ty, block0, elem, local_block, k, tile_i, tile_j
    integer :: i, j, ltile, l, t, idx, fp, npoint
    integer :: elem_offset, elem_face_offset
    real(RP) :: sum, lift_value

    tx = threadIdx%x
    ty = threadIdx%y
    block0 = blockIdx%x-1
    elem = block0/65536
    if (elem >= Ne) return
    local_block = mod(block0,65536)
    k = local_block/256 + 1
    local_block = mod(local_block,256)
    tile_j = local_block/16
    tile_i = mod(local_block,16)
    i = tile_i*16 + tx
    j = tile_j*16 + ty
    elem_offset = elem*16777216

    sum = 0.0_RP
    do ltile = 0, 15
      l = ltile*16 + ty
      idx = elem_offset+i+(l-1)*256+(k-1)*65536
      sQ(tx,ty) = q(idx)*velocity(idx)
      sD(tx,ty) = D1D(tile_j*16+tx+(l-1)*256)
      call syncthreads()
      do t = 1, 16
        sum = sum + sQ(tx,t)*sD(ty,t)
      end do
      call syncthreads()
    end do

    idx = elem_offset+i+(j-1)*256+(k-1)*65536
    fp = i+(k-1)*256
    elem_face_offset = elem*6*65536
    lift_value = Lift1D(j)*flux_bnd(elem_face_offset+fp) &
      + Lift1D(j+2*256)*flux_bnd(elem_face_offset+2*65536+fp)
    npoint = 16777216*Ne
    dqdt(idx) = dqdt(idx)-(Escale(idx+npoint)*sum+lift_value)
  end subroutine tendency_y_p255_kernel

  !> z-direction p=255 tensor-product derivative and z-face lift.
  attributes(global) subroutine tendency_z_p255_kernel( &
    dqdt, q, velocity, D1D, Lift1D, flux_bnd, Escale, Ne )
    implicit none
    integer, value :: Ne
    real(RP), device :: dqdt(*), q(*), velocity(*)
    real(RP), device :: D1D(*), Lift1D(*), flux_bnd(*), Escale(*)

    real(RP), shared :: sD(16,16), sQ(16,16)
    integer :: tx, ty, block0, elem, local_block, tile_line, tile_k
    integer :: line, i, j, k, ltile, l, t, idx, fp, npoint
    integer :: elem_offset, elem_face_offset
    real(RP) :: sum, lift_value

    tx = threadIdx%x
    ty = threadIdx%y
    block0 = blockIdx%x-1
    elem = block0/65536
    if (elem >= Ne) return
    local_block = mod(block0,65536)
    tile_k = local_block/4096
    tile_line = mod(local_block,4096)
    line = tile_line*16 + tx
    k = tile_k*16 + ty
    i = mod(line-1,256) + 1
    j = (line-1)/256 + 1
    elem_offset = elem*16777216

    sum = 0.0_RP
    do ltile = 0, 15
      l = ltile*16 + ty
      idx = elem_offset+line+(l-1)*65536
      sQ(tx,ty) = q(idx)*velocity(idx)
      sD(tx,ty) = D1D(tile_k*16+tx+(l-1)*256)
      call syncthreads()
      do t = 1, 16
        sum = sum + sQ(tx,t)*sD(ty,t)
      end do
      call syncthreads()
    end do

    idx = elem_offset+line+(k-1)*65536
    fp = line
    elem_face_offset = elem*6*65536
    lift_value = Lift1D(k+4*256)*flux_bnd(elem_face_offset+4*65536+fp) &
      + Lift1D(k+5*256)*flux_bnd(elem_face_offset+5*65536+fp)
    npoint = 16777216*Ne
    dqdt(idx) = dqdt(idx)-(Escale(idx+2*npoint)*sum+lift_value)
  end subroutine tendency_z_p255_kernel

  attributes(global) subroutine surface_lift_kernel( &
    lift_out, Lift_mat, flux_bnd, Nq, Np, NfpTot, npoint )
    implicit none
    integer, value :: Nq, Np, NfpTot, npoint
    real(RP), device :: lift_out(*), Lift_mat(*), flux_bnd(*)

    integer :: idx, node, elem, elem_face_offset
    integer :: i, j, k, nq2
    integer :: face1, face2, face3, face4, face5, face6

    idx = (blockIdx%x-1)*blockDim%x + threadIdx%x
    nq2 = Nq*Nq

    if (idx <= npoint) then
      node = mod(idx-1,Np) + 1
      elem = (idx-1)/Np + 1
      elem_face_offset = (elem-1)*NfpTot
      i = mod(node-1,Nq) + 1
      j = mod((node-1)/Nq,Nq) + 1
      k = (node-1)/nq2 + 1

      face1 = elem_face_offset + i + (k-1)*Nq
      face2 = elem_face_offset + nq2 + j + (k-1)*Nq
      face3 = elem_face_offset + 2*nq2 + i + (k-1)*Nq
      face4 = elem_face_offset + 3*nq2 + j + (k-1)*Nq
      face5 = elem_face_offset + 4*nq2 + i + (j-1)*Nq
      face6 = elem_face_offset + 5*nq2 + i + (j-1)*Nq

      lift_out(idx) = &
          Lift_mat(node)       * flux_bnd(face1) &
        + Lift_mat(node+Np)    * flux_bnd(face2) &
        + Lift_mat(node+2*Np)  * flux_bnd(face3) &
        + Lift_mat(node+3*Np)  * flux_bnd(face4) &
        + Lift_mat(node+4*Np)  * flux_bnd(face5) &
        + Lift_mat(node+5*Np)  * flux_bnd(face6)
    end if
  end subroutine surface_lift_kernel

  !> Polynomial-order-7 lifting kernel using the read-only cache for face data.
  attributes(global) subroutine surface_lift_p7_kernel( &
    lift_out, Lift_mat, flux_bnd, Ne )
    implicit none
    integer, value :: Ne
    real(RP), device :: lift_out(*), Lift_mat(*), flux_bnd(*)

    integer :: elem, elem_offset, elem_face_offset, tid, node
    integer :: i, j, k
    integer :: face1, face2, face3, face4, face5, face6

    elem = blockIdx%x
    if (elem > Ne) return

    tid = threadIdx%x
    elem_offset = (elem-1)*512
    elem_face_offset = (elem-1)*384

    node = tid
    i = mod(node-1,8) + 1
    j = mod((node-1)/8,8) + 1
    k = (node-1)/64 + 1

    face1 = i + (k-1)*8
    face2 = 64 + j + (k-1)*8
    face3 = 128 + i + (k-1)*8
    face4 = 192 + j + (k-1)*8
    face5 = 256 + i + (j-1)*8
    face6 = 320 + i + (j-1)*8

    lift_out(elem_offset+node) = &
        Lift_mat(node)        * flux_bnd(elem_face_offset+face1) &
      + Lift_mat(node+512)    * flux_bnd(elem_face_offset+face2) &
      + Lift_mat(node+1024)   * flux_bnd(elem_face_offset+face3) &
      + Lift_mat(node+1536)   * flux_bnd(elem_face_offset+face4) &
      + Lift_mat(node+2048)   * flux_bnd(elem_face_offset+face5) &
      + Lift_mat(node+2560)   * flux_bnd(elem_face_offset+face6)
  end subroutine surface_lift_p7_kernel

  !> Polynomial-order-7 lifting and final tendency assembly in one kernel.
  attributes(global) subroutine surface_lift_assembly_p7_kernel( &
    dqdt, Escale, deriv_x, deriv_y, deriv_z, Lift_mat, flux_bnd, Ne )
    implicit none
    integer, value :: Ne
    real(RP), device :: dqdt(*), Escale(*)
    real(RP), device :: deriv_x(*), deriv_y(*), deriv_z(*)
    real(RP), device :: Lift_mat(*), flux_bnd(*)

    integer :: elem, elem_offset, elem_face_offset, tid, node, idx, npoint
    integer :: i, j, k
    integer :: face1, face2, face3, face4, face5, face6
    real(RP) :: lift_value

    elem = blockIdx%x
    if (elem > Ne) return

    tid = threadIdx%x
    elem_offset = (elem-1)*512
    elem_face_offset = (elem-1)*384

    node = tid
    i = mod(node-1,8) + 1
    j = mod((node-1)/8,8) + 1
    k = (node-1)/64 + 1

    face1 = i + (k-1)*8
    face2 = 64 + j + (k-1)*8
    face3 = 128 + i + (k-1)*8
    face4 = 192 + j + (k-1)*8
    face5 = 256 + i + (j-1)*8
    face6 = 320 + i + (j-1)*8

    lift_value = &
        Lift_mat(node)        * flux_bnd(elem_face_offset+face1) &
      + Lift_mat(node+512)    * flux_bnd(elem_face_offset+face2) &
      + Lift_mat(node+1024)   * flux_bnd(elem_face_offset+face3) &
      + Lift_mat(node+1536)   * flux_bnd(elem_face_offset+face4) &
      + Lift_mat(node+2048)   * flux_bnd(elem_face_offset+face5) &
      + Lift_mat(node+2560)   * flux_bnd(elem_face_offset+face6)

    idx = elem_offset + node
    npoint = 512*Ne
    dqdt(idx) = -( &
        Escale(idx)*deriv_x(idx) &
      + Escale(idx+npoint)*deriv_y(idx) &
      + Escale(idx+2*npoint)*deriv_z(idx) &
      + lift_value )
  end subroutine surface_lift_assembly_p7_kernel

  attributes(global) subroutine dqdt_assembly_kernel( &
    dqdt, Escale, deriv_x, deriv_y, deriv_z, lift_in, npoint )
    implicit none
    integer, value :: npoint
    real(RP), device :: dqdt(*), Escale(*)
    real(RP), device :: deriv_x(*), deriv_y(*), deriv_z(*), lift_in(*)

    integer :: idx

    idx = (blockIdx%x-1)*blockDim%x + threadIdx%x
    if (idx <= npoint) then
      dqdt(idx) = -( &
          Escale(idx)*deriv_x(idx) &
        + Escale(idx+npoint)*deriv_y(idx) &
        + Escale(idx+2*npoint)*deriv_z(idx) &
        + lift_in(idx) )
    end if
  end subroutine dqdt_assembly_kernel

  attributes(global) subroutine elembnd_flux_kernel( &
    flux, q, u, v, w, VMapM, VMapP, normal_fn, Fscale, nface )
    implicit none
    integer, value :: nface
    real(RP), device :: flux(*), q(*), u(*), v(*), w(*)
    integer, device :: VMapM(*), VMapP(*)
    real(RP), device :: normal_fn(*), Fscale(*)

    integer :: idx, iM, iP
    real(RP) :: qM, qP, VelM, VelP, alpha

    idx = (blockIdx%x-1)*blockDim%x + threadIdx%x
    if (idx <= nface) then
      iM = VMapM(idx)
      iP = VMapP(idx)
      qM = q(iM)
      qP = q(iP)
      VelM = u(iM)*normal_fn(idx) &
           + v(iM)*normal_fn(idx+nface) &
           + w(iM)*normal_fn(idx+2*nface)
      VelP = u(iP)*normal_fn(idx) &
           + v(iP)*normal_fn(idx+nface) &
           + w(iP)*normal_fn(idx+2*nface)
      alpha = 0.5_RP*abs(VelP+VelM)
      flux(idx) = 0.5_RP*Fscale(idx)*( &
        qP*VelP-qM*VelM-alpha*(qP-qM) )
    end if
  end subroutine elembnd_flux_kernel

  subroutine cuda_cal_volume_flux( &
    flux_x, flux_y, flux_z, q, u, v, w, Np, Ne, NeA )
    implicit none
    integer, intent(in) :: Np, Ne, NeA
    real(RP), device, intent(out) :: flux_x(Np,Ne), flux_y(Np,Ne), flux_z(Np,Ne)
    real(RP), device, intent(in) :: q(Np,NeA)
    real(RP), device, intent(in) :: u(Np,NeA), v(Np,NeA), w(Np,NeA)

    integer :: npoint, nblock

    npoint = Np*Ne
    nblock = (npoint+CUDA_BLOCK_SIZE-1)/CUDA_BLOCK_SIZE
    call launch_volume_flux( &
      flux_x, flux_y, flux_z, q, u, v, w, npoint )
    call synchronize_cuda_kernel("volume_flux_kernel")
  end subroutine cuda_cal_volume_flux

  subroutine cuda_cal_volume_deriv( &
    deriv_x, deriv_y, deriv_z, D1D, D1D_tr, &
    flux_x, flux_y, flux_z, Nq, Np, Ne )
    implicit none
    integer, intent(in) :: Nq, Np, Ne
    real(RP), device, intent(out) :: deriv_x(Np,Ne), deriv_y(Np,Ne), deriv_z(Np,Ne)
    real(RP), device, intent(in) :: D1D(Nq,Nq), D1D_tr(Nq,Nq)
    real(RP), device, intent(in) :: flux_x(Np,Ne), flux_y(Np,Ne), flux_z(Np,Ne)

    integer :: npoint, nblock

    if (Nq == 8) then
      call volume_deriv_p7_kernel<<<Ne,CUDA_P7_BLOCK_SIZE,0,dg_stream>>>( &
        deriv_x, deriv_y, deriv_z, D1D, D1D_tr, &
        flux_x, flux_y, flux_z, Ne )
      call synchronize_cuda_kernel("volume_deriv_p7_kernel")
    else
      npoint = Np*Ne
      nblock = (npoint+CUDA_BLOCK_SIZE-1)/CUDA_BLOCK_SIZE
      call volume_deriv_kernel<<<nblock,CUDA_BLOCK_SIZE,0,dg_stream>>>( &
        deriv_x, deriv_y, deriv_z, D1D, D1D_tr, &
        flux_x, flux_y, flux_z, Nq, Np, npoint )
      call synchronize_cuda_kernel("volume_deriv_kernel")
    end if
  end subroutine cuda_cal_volume_deriv

  subroutine cuda_cal_surface_lift( &
    lift_out, Lift_mat, flux_bnd, Nq, Np, NfpTot, Ne )
    implicit none
    integer, intent(in) :: Nq, Np, NfpTot, Ne
    real(RP), device, intent(out) :: lift_out(Np,Ne)
    real(RP), device, intent(in) :: Lift_mat(Nq,Nq,Nq,6)
    real(RP), device, intent(in) :: flux_bnd(NfpTot,Ne)

    integer :: npoint, nblock

    if (Nq == 8) then
      call surface_lift_p7_kernel<<<Ne,CUDA_P7_BLOCK_SIZE,0,dg_stream>>>( &
        lift_out, Lift_mat, flux_bnd, Ne )
      call synchronize_cuda_kernel("surface_lift_p7_kernel")
    else
      npoint = Np*Ne
      nblock = (npoint+CUDA_BLOCK_SIZE-1)/CUDA_BLOCK_SIZE
      call surface_lift_kernel<<<nblock,CUDA_BLOCK_SIZE,0,dg_stream>>>( &
        lift_out, Lift_mat, flux_bnd, Nq, Np, NfpTot, npoint )
      call synchronize_cuda_kernel("surface_lift_kernel")
    end if
  end subroutine cuda_cal_surface_lift

  subroutine cuda_assemble_dqdt( &
    dqdt, Escale, deriv_x, deriv_y, deriv_z, lift_in, Np, Ne, NeA )
    implicit none
    integer, intent(in) :: Np, Ne, NeA
    real(RP), device, intent(out) :: dqdt(Np,NeA)
    real(RP), device, intent(in) :: Escale(Np,Ne,3)
    real(RP), device, intent(in) :: deriv_x(Np,Ne), deriv_y(Np,Ne), deriv_z(Np,Ne)
    real(RP), device, intent(in) :: lift_in(Np,Ne)

    integer :: npoint, nblock

    npoint = Np*Ne
    nblock = (npoint+CUDA_BLOCK_SIZE-1)/CUDA_BLOCK_SIZE
    call dqdt_assembly_kernel<<<nblock,CUDA_BLOCK_SIZE,0,dg_stream>>>( &
      dqdt, Escale, deriv_x, deriv_y, deriv_z, lift_in, npoint )
    call synchronize_cuda_kernel("dqdt_assembly_kernel")
  end subroutine cuda_assemble_dqdt

  subroutine cuda_failure(operation,istat)
    implicit none
    character(len=*), intent(in) :: operation
    integer, intent(in) :: istat

    write(*,*) trim(operation), ": ", trim(cudaGetErrorString(istat))
    error stop
  end subroutine cuda_failure

  subroutine synchronize_cuda_kernel(kernel_name)
    implicit none
    character(len=*), intent(in) :: kernel_name
    integer :: istat

    istat = cudaGetLastError()
    if (istat /= cudaSuccess) then
      write(*,*) trim(kernel_name), ": launch failed: ", trim(cudaGetErrorString(istat))
      error stop
    end if
    istat = cudaDeviceSynchronize()
    if (istat /= cudaSuccess) then
      write(*,*) trim(kernel_name), ": execution failed: ", trim(cudaGetErrorString(istat))
      error stop
    end if
  end subroutine synchronize_cuda_kernel
end module mod_cuda_dg_kernels
