      flux_bnd, q, u, v, w, VMapM, VMapP, normal_fn, Fscale, nface, 0 )
    call launch_tendency_xyz_p255_tc( &
      dqdt, q, u, v, w, D1D, Lift1D, flux_bnd, Escale, int(Ne,c_int) )
    istat = cudaGetLastError()
    if (istat /= cudaSuccess) call cuda_failure("p=255 TC tendency kernels",istat)
    call dg_ev_record(2)
    call dg_ev_end(DG_EV_SINGLE)

    kernel_time(1) = dg_kernel_time(1)
    kernel_time(2) = dg_kernel_time(2)
  end subroutine cuda_cal_dqdt_fused_p255_tc

  !> Select the MMA instruction shape of the CUTLASS volume GEMMs.
  !!
  !! 0 = SM80 8x8x4 (the default), 1 = SM90 16x8x4, 2 = SM90 16x8x8,
  !! 3 = SM90 16x8x16. The
  !! matching kernels are all instantiated in cuda_cutlass_gemm_fused.cu, so
  !! this only picks which one is launched.
  subroutine cuda_cutlass_set_mma_shape(shape_id)
    implicit none
    integer, intent(in) :: shape_id

    if (shape_id < 0 .or. shape_id > 3) then
      write(*,*) "cuda_cutlass_set_mma_shape: unsupported shape id ", shape_id
      error stop
    end if
    cutlass_mma_shape_id = int(shape_id, c_int)
  end subroutine cuda_cutlass_set_mma_shape

  subroutine cuda_gemm_setup(emulate, mantissa_fixed, mantissa_bits)
    implicit none
    logical, intent(in) :: emulate
    logical, intent(in), optional :: mantissa_fixed
    integer, intent(in), optional :: mantissa_bits
    integer :: istat
    integer(c_int) :: emulate_flag, fixed_flag, bits_flag

    emulate_flag = 0
    if (emulate) emulate_flag = 1
    fixed_flag = 1
    if (present(mantissa_fixed)) then
      fixed_flag = 0
      if (mantissa_fixed) fixed_flag = 1
    end if
    bits_flag = 55
    if (present(mantissa_bits)) bits_flag = int(mantissa_bits, c_int)
    istat = cublas_gemm_init(emulate_flag, fixed_flag, bits_flag)
    if (istat /= 0) call cuda_failure("cublas_gemm_init",istat)
    gemm_inited = .true.
  end subroutine cuda_gemm_setup

  subroutine cuda_gemm_finalize()
    implicit none
    integer :: istat

    if (gemm_inited) then
      istat = cublas_gemm_finalize()
      if (istat /= 0) call cuda_failure("cublas_gemm_finalize",istat)
      gemm_inited = .false.
    end if
  end subroutine cuda_gemm_finalize

  ! Volume derivatives only.  z is stored in dqdt (beta=0); assembly overwrites
  ! that buffer.  Ozaki backends share this layout with cuBLAS native GEMM.
  subroutine gemm_volume_xyz(backend, Nq, Ne, nq2, plane_batch, &
    stride_plane, stride_zero, stride_vol, D1D, D1D_tr, &
    flux_x, flux_y, flux_z, deriv_x, deriv_y, dqdt)
    implicit none
    integer, intent(in) :: backend, Nq, Ne, nq2, plane_batch
    integer(c_long_long), intent(in) :: stride_plane, stride_zero, stride_vol
    real(RP), device, intent(in) :: D1D(*), D1D_tr(*)
    real(RP), device, intent(in) :: flux_x(*), flux_y(*), flux_z(*)
    real(RP), device, intent(out) :: deriv_x(*), deriv_y(*), dqdt(*)
    integer :: istat

    select case (backend)
    case (GEMM_VOL_CUBLAS)
      istat = cublas_dgemm_impl(0, 0, Nq, nq2*Ne, Nq, 1.0_c_double, &
        D1D, Nq, flux_x, Nq, 0.0_c_double, deriv_x, Nq)
      if (istat /= 0) call cuda_failure("cublasDgemm x-deriv",istat)
      istat = cublas_dgemm_strided_batched_impl(0, 0, Nq, Nq, Nq, 1.0_c_double, &
        flux_y, Nq, stride_plane, D1D_tr, Nq, stride_zero, 0.0_c_double, &
        deriv_y, Nq, stride_plane, plane_batch)
      if (istat /= 0) call cuda_failure("cublasDgemm y-deriv",istat)
      istat = cublas_dgemm_strided_batched_impl(0, 0, nq2, Nq, Nq, 1.0_c_double, &
        flux_z, nq2, stride_vol, D1D_tr, Nq, stride_zero, 0.0_c_double, &
        dqdt, nq2, stride_vol, Ne)
      if (istat /= 0) call cuda_failure("cublasDgemm z-deriv",istat)
    case (GEMM_VOL_OZAKI1)
      istat = ozaki1_dgemm(0, 0, Nq, nq2*Ne, Nq, D1D, Nq, flux_x, Nq, deriv_x, Nq)
      if (istat /= 0) call cuda_failure("ozaki1_dgemm x-deriv", istat)
      istat = ozaki1_dgemm_strided_batched(0, 0, Nq, Nq, Nq, &
        flux_y, Nq, stride_plane, D1D_tr, Nq, stride_zero, &
        deriv_y, Nq, stride_plane, plane_batch)
      if (istat /= 0) call cuda_failure("ozaki1_dgemm y-deriv", istat)
      istat = ozaki1_dgemm_strided_batched(0, 0, nq2, Nq, Nq, &
        flux_z, nq2, stride_vol, D1D_tr, Nq, stride_zero, &
        dqdt, nq2, stride_vol, Ne)
      if (istat /= 0) call cuda_failure("ozaki1_dgemm z-deriv", istat)
    case (GEMM_VOL_OZAKI2)
      istat = ozaki2_dgemm(0, 0, Nq, nq2*Ne, Nq, D1D, Nq, flux_x, Nq, deriv_x, Nq)
      if (istat /= 0) call cuda_failure("ozaki2_dgemm x-deriv", istat)
      istat = ozaki2_dgemm_strided_batched(0, 0, Nq, Nq, Nq, &
        flux_y, Nq, stride_plane, D1D_tr, Nq, stride_zero, &
        deriv_y, Nq, stride_plane, plane_batch)
      if (istat /= 0) call cuda_failure("ozaki2_dgemm y-deriv", istat)
      istat = ozaki2_dgemm_strided_batched(0, 0, nq2, Nq, Nq, &
        flux_z, nq2, stride_vol, D1D_tr, Nq, stride_zero, &
        dqdt, nq2, stride_vol, Ne)
      if (istat /= 0) call cuda_failure("ozaki2_dgemm z-deriv", istat)
    case default
      error stop "gemm_volume_xyz: unknown volume GEMM backend"
    end select
  end subroutine gemm_volume_xyz

  subroutine cuda_cal_dqdt_gemm_unfused( backend, &
    dqdt, q, u, v, w, D1D, D1D_tr, Lift1D, VMapM, VMapP, &
    normal_fn, Fscale, Escale, flux_bnd, &
    flux_x, flux_y, flux_z, deriv_x, deriv_y, &
    Nq, Np, NfpTot, Ne, NeA, kernel_time )
    implicit none
    integer, intent(in) :: backend
    integer, intent(in) :: Nq, Np, NfpTot, Ne, NeA
    real(RP), device, intent(out) :: dqdt(Np,Ne)
    real(RP), device, intent(in) :: q(Np,NeA)
    real(RP), device, intent(in) :: u(Np,NeA), v(Np,NeA), w(Np,NeA)
    real(RP), device, intent(in) :: D1D(Nq,Nq), D1D_tr(Nq,Nq)
    real(RP), device, intent(in) :: Lift1D(Nq,6)
    integer, device, intent(in) :: VMapM(NfpTot,Ne), VMapP(NfpTot,Ne)
    real(RP), device, intent(in) :: normal_fn(NfpTot,Ne,3)
    real(RP), device, intent(in) :: Fscale(NfpTot,Ne)
    real(RP), device, intent(in) :: Escale(Np,Ne,3)
    real(RP), device, intent(out) :: flux_bnd(NfpTot,Ne)
    real(RP), device, intent(out) :: flux_x(Np,Ne), flux_y(Np,Ne), flux_z(Np,Ne)
    real(RP), device, intent(out) :: deriv_x(Np,Ne), deriv_y(Np,Ne)
    real(RP), intent(out) :: kernel_time(2)

    integer :: istat, nface, npoint, nblock, nblock_face
    integer :: nq2, plane_batch
    integer(c_long_long) :: stride_plane, stride_elem, stride_zero, stride_vol
    logical :: use_side

    if (.not. gemm_inited) then
      call cuda_gemm_setup(.false.)
    end if

    call dg_ev_begin()

    nq2 = Nq*Nq
    nface = NfpTot*Ne
    npoint = Np*Ne
    nblock = (npoint+CUDA_BLOCK_SIZE-1)/CUDA_BLOCK_SIZE
    nblock_face = (nface+CUDA_BLOCK_SIZE-1)/CUDA_BLOCK_SIZE
    plane_batch = Nq*Ne
    stride_plane = int(nq2,c_long_long)
    stride_elem = int(NfpTot,c_long_long)
    stride_zero = 0_c_long_long
    stride_vol = int(Np,c_long_long)

    call dg_ev_record(1)

    ! flux_bnd is not read until the lift, so the boundary flux can run on the
    ! second stream underneath the volume GEMMs.  See cuda_cal_dqdt_gemm_fused.
    ! At p=7 it must not: there the boundary flux is 181 us while the volume
    ! GEMMs are 24 launches of 8x8 matrices, so it is far larger than the
    ! window it would hide in and overlapping the two loses 3.1%.
    ! The window is wide enough from Nq=64 on: measured at p=7 (loss), p=63
    ! (-1.4% on Main) and p=255 (-1.3%, overall_summary_report.md 8.7).
    use_side = dg_side_enabled .and. (Nq >= 64)

    if (.not. use_side) then
      call elembnd_flux_kernel<<<nblock_face,CUDA_BLOCK_SIZE,0,dg_stream>>>( &
        flux_bnd, q, u, v, w, VMapM, VMapP, normal_fn, Fscale, nface, 0 )
    end if

    call launch_volume_flux( &
      flux_x, flux_y, flux_z, q, u, v, w, npoint )

    if (use_side) then
      call dg_side_fork(.false.)
      call elembnd_flux_kernel<<<nblock_face,CUDA_BLOCK_SIZE,0,dg_side_stream>>>( &
        flux_bnd, q, u, v, w, VMapM, VMapP, normal_fn, Fscale, nface, 0 )
    end if

    call gemm_volume_xyz(backend, Nq, Ne, nq2, plane_batch, &
      stride_plane, stride_zero, stride_vol, D1D, D1D_tr, &
      flux_x, flux_y, flux_z, deriv_x, deriv_y, dqdt)

    if (use_side) call dg_side_join(.false.)

    call separable_lift_assembly_kernel<<<nblock,CUDA_BLOCK_SIZE,0,dg_stream>>>( &
      dqdt, Escale(1,1,1), Escale(1,1,2), Escale(1,1,3), &
      deriv_x, deriv_y, dqdt, flux_bnd, Lift1D, &
      Nq, Np, npoint )

    istat = cudaGetLastError()
    if (istat /= cudaSuccess) then
      select case (backend)
      case (GEMM_VOL_OZAKI1)
        call cuda_failure("CUDAFORTRAN_GEMM_OZAKI1 kernels",istat)
      case (GEMM_VOL_OZAKI2)
        call cuda_failure("CUDAFORTRAN_GEMM_OZAKI2 kernels",istat)
      case default
        call cuda_failure("CUDAFORTRAN_GEMM kernels",istat)
      end select
    end if
    call dg_ev_record(2)
    call dg_ev_end(DG_EV_SINGLE)

    kernel_time(1) = dg_kernel_time(1)
    kernel_time(2) = dg_kernel_time(2)
  end subroutine cuda_cal_dqdt_gemm_unfused

  subroutine cuda_cal_dqdt_gemm( &
    dqdt, q, u, v, w, D1D, D1D_tr, Lift1D, VMapM, VMapP, &
    normal_fn, Fscale, Escale, flux_bnd, &
    flux_x, flux_y, flux_z, deriv_x, deriv_y, &
    Nq, Np, NfpTot, Ne, NeA, kernel_time )
    implicit none
    integer, intent(in) :: Nq, Np, NfpTot, Ne, NeA
    real(RP), device, intent(out) :: dqdt(Np,Ne)
    real(RP), device, intent(in) :: q(Np,NeA)
    real(RP), device, intent(in) :: u(Np,NeA), v(Np,NeA), w(Np,NeA)
    real(RP), device, intent(in) :: D1D(Nq,Nq), D1D_tr(Nq,Nq)
    real(RP), device, intent(in) :: Lift1D(Nq,6)
    integer, device, intent(in) :: VMapM(NfpTot,Ne), VMapP(NfpTot,Ne)
    real(RP), device, intent(in) :: normal_fn(NfpTot,Ne,3)
    real(RP), device, intent(in) :: Fscale(NfpTot,Ne)
    real(RP), device, intent(in) :: Escale(Np,Ne,3)
    real(RP), device, intent(out) :: flux_bnd(NfpTot,Ne)
    real(RP), device, intent(out) :: flux_x(Np,Ne), flux_y(Np,Ne), flux_z(Np,Ne)
    real(RP), device, intent(out) :: deriv_x(Np,Ne), deriv_y(Np,Ne)
    real(RP), intent(out) :: kernel_time(2)

    call cuda_cal_dqdt_gemm_unfused( GEMM_VOL_CUBLAS, &
      dqdt, q, u, v, w, D1D, D1D_tr, Lift1D, VMapM, VMapP, &
      normal_fn, Fscale, Escale, flux_bnd, &
      flux_x, flux_y, flux_z, deriv_x, deriv_y, &
      Nq, Np, NfpTot, Ne, NeA, kernel_time )
  end subroutine cuda_cal_dqdt_gemm

  subroutine cuda_ozaki2_init(moduli_count, fixed_mantissa)
    implicit none
    integer, intent(in) :: moduli_count
    logical, intent(in), optional :: fixed_mantissa
