    real(RP), device, intent(in) :: Escale(Np,Ne,3)
    real(RP), device, intent(out) :: flux_bnd(NfpTot,Ne)
    real(RP), intent(out) :: kernel_time(2)

    integer :: istat, nface, nblock_face

    if (Nq /= CUDA_FUSED_P127_NQ .or. Np /= CUDA_FUSED_P127_NQ**3) then
      error stop "cuda_cal_dqdt_fused_p127 requires PolyOrder=127"
    end if
    call dg_ev_begin()

    nface = NfpTot*Ne
    nblock_face = (nface+CUDA_BLOCK_SIZE-1)/CUDA_BLOCK_SIZE

    call dg_ev_record(1)
    call elembnd_flux_kernel<<<nblock_face,CUDA_BLOCK_SIZE,0,dg_stream>>>( &
      flux_bnd, q, u, v, w, VMapM, VMapP, normal_fn, Fscale, nface, 0 )
    istat = cudaGetLastError()
    if (istat /= cudaSuccess) call cuda_failure("elembnd_flux_kernel",istat)
    call launch_tendency_fused_p127( &
      dqdt, D1D, Lift1D, q, u, v, w, flux_bnd, Escale, int(Ne,c_int) )
    istat = cudaGetLastError()
    if (istat /= cudaSuccess) call cuda_failure("p=127 CC tendency kernels",istat)
    call dg_ev_record(2)
    call dg_ev_end(DG_EV_SINGLE)

    kernel_time(1) = dg_kernel_time(1)
    kernel_time(2) = dg_kernel_time(2)
  end subroutine cuda_cal_dqdt_fused_p127

  subroutine cuda_cal_dqdt_fused_p255( &
    dqdt, q, u, v, w, D1D, Lift1D, VMapM, VMapP, &
    normal_fn, Fscale, Escale, flux_bnd, &
    Nq, Np, NfpTot, Ne, NeA, kernel_time )
    implicit none
    integer, intent(in) :: Nq, Np, NfpTot, Ne, NeA
    real(RP), device, intent(out) :: dqdt(Np,Ne)
    real(RP), device, intent(in) :: q(Np,NeA)
    real(RP), device, intent(in) :: u(Np,NeA), v(Np,NeA), w(Np,NeA)
    real(RP), device, intent(in) :: D1D(Nq,Nq)
    real(RP), device, intent(in) :: Lift1D(Nq,6)
    integer, device, intent(in) :: VMapM(NfpTot,Ne)
    integer, device, intent(in) :: VMapP(NfpTot,Ne)
    real(RP), device, intent(in) :: normal_fn(NfpTot,Ne,3)
    real(RP), device, intent(in) :: Fscale(NfpTot,Ne)
    real(RP), device, intent(in) :: Escale(Np,Ne,3)
    real(RP), device, intent(out) :: flux_bnd(NfpTot,Ne)
    real(RP), intent(out) :: kernel_time(2)

    integer :: istat, nface, nblock_face

    if (Nq /= CUDA_P255_NQ .or. Np /= CUDA_P255_NQ**3) then
      error stop "cuda_cal_dqdt_fused_p255 requires PolyOrder=255"
    end if
