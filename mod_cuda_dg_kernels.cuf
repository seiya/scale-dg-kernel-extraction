!> CUDA Fortran implementation of the split tendency kernels.
module mod_cuda_dg_kernels
  use cudafor
  use, intrinsic :: iso_c_binding, only: c_int, c_double, c_long_long
  use mod_common, only: RP
  implicit none
  private

  logical, public, parameter :: cuda_dg_kernels_available = .true.

  integer, parameter :: CUDA_BLOCK_SIZE = 256
  integer, parameter :: CUDA_P7_BLOCK_SIZE = 512
  ! Nq checks only; launch geometry lives in fused_kernel_geom.h.
  integer, parameter :: CUDA_FUSED_P31_NQ = 32
  integer, parameter :: CUDA_FUSED_P63_NQ = 64
  integer, parameter :: CUDA_FUSED_P127_NQ = 128
  integer, parameter :: CUDA_P255_NQ = 256
  !- The tile-type fused kernels of cuda_dg_kernels_tc.cu carry Nq only in the
  !  grid and the chunk count, so the same source also serves Nq = 512.  See
  !  reports/p511_gap_study.md sections 14.3 and 15.
  integer, parameter :: CUDA_P511_NQ = 512
  integer, parameter :: GEMM_VOL_CUBLAS = 0
  integer, parameter :: GEMM_VOL_OZAKI1 = 1
  integer, parameter :: GEMM_VOL_OZAKI2 = 2

  !- Device-time measurement -------------------------------------------------
  !
  !  The tendency wrappers bracket their kernels with CUDA events.  Reading an
  !  event pair back needs the recorded work to be complete, so doing it in the
  !  same call drains the pipeline at every Runge-Kutta stage and exposes the
  !  launch latency of the kernels that follow.  The measurement is therefore
  !  read one call later: the events alternate between two buffers and each
  !  call harvests the buffer of the previous call, which the device has long
  !  finished by then.  cuda_dg_flush_kernel_time collects the last, still
  !  unread measurement at the end of the run.  The measured intervals are
  !  unchanged; only the moment they are read back is.
  integer, parameter :: DG_EV_SINGLE     = 1 ! 2 boundaries, 1 interval
  integer, parameter :: DG_EV_CUTE       = 2 ! 4 boundaries
  integer, parameter :: DG_EV_GEMM_FUSED = 3 ! 5 boundaries
  integer, parameter :: DG_EV_SPLIT      = 4 ! 5 boundaries, 4 intervals

  !> Stream that every kernel and event of this module uses.  It is set to the
  !! stream of the OpenACC queue of the time-stepping loop, so that the CUDA
  !! kernels and the OpenACC regions keep their order without the host
  !! synchronizing between them.  cudaforGetDefaultStream() until then.
  integer(kind=cuda_stream_kind), save :: dg_stream = 0

  !> Second stream used to produce the operands the first GEMM does not need.
  !! The x GEMM reads only flux_x, so flux_y, flux_z and the element boundary
  !! flux can be computed while it runs: it holds the SM for 250 us at 88%
  !! SM throughput but only 10% DRAM throughput, and leaves about 11k of the
  !! 64k registers per SM free, so bandwidth-bound blocks co-schedule with it.
  !! Fork and join are plain events, which stream capture turns into graph
  !! edges, so the CUDA graph path keeps working.
  !! Measured on a CUDA graph replay the same structure is a small loss
  !! instead of a gain, so the host turns it off before capturing a step.
  integer(kind=cuda_stream_kind), save :: dg_side_stream = 0
  integer(kind=cuda_stream_kind), save :: dg_side2_stream = 0
  type(cudaEvent), save :: dg_side_fork_ev, dg_side_join_ev, dg_side2_join_ev
  logical, save :: dg_side_ready = .false.
  logical, save :: dg_side_enabled = .true.
  ! Lift1D columns 5 and 6 interleaved, so that the p>64 GEMM_FUSED z epilogue
  ! reads both z-face coefficients of a row in one 16-byte load.  Lift1D is a
  ! mesh operator and does not change during a run, so this is built once.
  real(RP), device, allocatable, save :: dg_lift_zpair(:)
  integer, save :: dg_lift_zpair_nq = -1
  !- Packed lift-coefficient pairs for the x carrier's 16-byte lift: three
  !- interleaved pairs of length Nq, (col1,col3) then (col2,col4) then
  !- (col5,col6).  See cutlass_x_gemm_assembly.h.
  real(RP), device, allocatable, save :: dg_lift_xpair(:)
  integer, save :: dg_lift_xpair_nq = -1

  type(cudaEvent), save :: split_events(5,2)
  logical, save :: split_events_initialized = .false.
  integer, save :: ev_buf = 2         ! buffer the current call records into
  integer, save :: ev_pending = 0     ! buffer holding an unread measurement
  integer, save :: ev_pending_mode = 0
  real(RP), save :: dg_kernel_time(4) = 0.0_RP ! result of the last harvest

  !> .false. suppresses the event records entirely.  A graph replay does not
  !! run the Fortran wrapper that reads the events back, so the per-kernel
  !! device time cannot be reported in graph mode; recording events that
  !! nobody reads would only add nodes to the graph.
  logical, save :: dg_ev_enabled = .true.

  !- CUDA Graph -------------------------------------------------------------
  !
  !  One Runge-Kutta step is captured from dg_stream once and replayed for
  !  every later step.  All the step's work is queued on that one stream, so
  !  the capture is a plain linear graph; what it removes is the per-launch
  !  turnaround the host pays nine times a step, not any device work.
  type(cudaGraph), save :: dg_graph
  type(cudaGraphExec), save :: dg_graph_exec
  logical, save :: dg_graph_ready = .false.

  logical, save :: gemm_inited = .false.
  ! cuBLAS FP64 emulation shares ONE handle and ONE 8 GiB workspace
  ! (cuda_cublas_gemm.cu g_handle / g_workspace).  Two volume GEMMs in
  ! flight at once would use that scratch concurrently, which produces
  ! +/-Inf in dqdt.  gemm_volume_xyz forces the serial schedule when it
  ! is on, the same way it does for the Ozaki backends.
  logical, save :: gemm_emulation_on = .false.
  !- MMA instruction shape of the CUTLASS volume GEMMs; see
  !- cuda_cutlass_set_mma_shape. 0 = SM80 8x8x4, 1 = SM90 16x8x4,
  !- 2 = SM90 16x8x8, 3 = SM90 16x8x16.
  integer(c_int), save :: cutlass_mma_shape_id = 0
  ! ------------------------------------------------------------------
  ! Adopted volume-GEMM configuration for CUDAFORTRAN_GEMM_FUSED and
  ! CUDAFORTRAN_GEMM_CUTE, plus the measurement overrides layered on it.
  !
  ! The library assignment and the mainloop tiles below are SHARED by the two
  ! paths, as AGENTS.md requires; only the epilogue differs (GEMM_FUSED fuses
  ! the final weighting and the surface lift into its carrier GEMM, GEMM_CUTE
  ! keeps unweighted epilogues and a separate separable_lift_assembly).
  ! With no SCALE_DG_* variable set, nothing below reads the environment:
  ! dg_gemm_defaults is a pure per-order table.
  !
  !   Nq   x GEMM           y GEMM   carrier   z GEMM    sched   epi package
  !    8   CUTLASS tile 9   cuBLAS   x         CUTLASS   y||z    xpkg 5
  !   16   CUTLASS tile 5   CUTLASS  x         CUTLASS   y||z    xpkg 4
  !   32   CUTLASS tile 7   CUTLASS  x         cuBLAS    y||z    xpkg 4
  !   64   CUTLASS tile 3   CUTLASS  z         CUTLASS   default zpkg 5
  !  128   CUTLASS tile 0   CUTLASS  z         CUTLASS   default (Nq>64 pkg)
  !  256   CUTLASS tile 0   CUTLASS  z         CUTLASS   default (Nq>64 pkg)
  ! >256   generic CUTLASS  CUTLASS  z         CUTLASS   default (as before)
  !
  ! Epilogue package: bit 0 clamp aggregation, bit 1 16-byte lift, bit 2
  ! 16-byte epilogue.  So xpkg 4 is the wide epilogue alone and xpkg/zpkg 5
  ! is the wide epilogue plus clamp aggregation; the 16-byte lift is off
  ! everywhere.  No Escale factor is forwarded at any order any more.
  !
  ! Nq = 128 and 256 tile 0 IS the generic 64x128 tile (warp 32x64, TileK 16,
  ! three stages) that launch_volume_gemm_x has always run, so naming it here
  ! does not change the mainloop of either path.  What it changes is GEMM_CUTE's
  ! x EPILOGUE: the tiled launcher goes through run_gemm_nn_scaled_repad, which
  ! pads the accumulator staging tile by 8 the way every other GEMM in this file
  ! already does, while the untiled launch_volume_gemm_x used the stock,
  ! unpadded epilogue.  GEMM_FUSED's x already had the pad (it goes through
  ! run_volume_gemm_x_scale), so this REMOVES a divergence rather than creating
  ! one.  Worth -0.24% at p=127 and -0.22% at p=255 on GEMM_CUTE, 12/12 with
  ! disjoint ranges (exclusive GB200, Slurm job 77137).  Above 256 the table
  ! still says "generic": no tile list exists there, and at Nq >= 512 the x GEMM
  ! deliberately borrows the batched y tile (run_volume_gemm_x).
  !
  ! Nq > 64 keeps the z CARRIER.  Both alternatives were measured at p=127 and
  ! p=255 and both lose; see the note at the end of the carrier entry below.
  !
  ! What the table is worth (CUDA device us/stage, login-node GB200, 12-pair
  ! interleaved medians; before -> after, ranges disjoint unless noted):
  !
  !   p=7   GEMM_FUSED 1747.1 -> 1482.0  (-15.2%)
  !         GEMM_CUTE  1727.4 -> 1478.9  (-14.4%)
  !   p=15  GEMM_FUSED  658.0 ->  597.9  ( -9.1%)
  !         GEMM_CUTE   700.1 ->  655.2  ( -6.4%)
  !   p=31  GEMM_FUSED  708.0 ->  545.4  (-23.0%)
  !         GEMM_CUTE   668.1 ->  605.6  ( -9.3%)
  !   p=63  GEMM_FUSED  571.1 ->  564.3  ( -1.2%)
  !         GEMM_CUTE   630.4 ->  628.4  (-0.31%, marginal, ranges touching)
  !
  ! GEMM_FUSED beats GEMM_CUTE at Nq = 16, 32 and 64 but NOT at Nq = 8, where
  ! it is 0.21% behind.  That is a structural limit, not an unexplained gap:
  ! see the Nq = 8 note under the carrier entry below.
  !
  ! Component by component:
  !
  ! * x on CUTLASS with an order-specialized tile.  C is column major, so
  !   device::Gemm solves the transposed problem and the threadblock's N
  !   extent is Nq; the generic 64x128 tile therefore predicated away
  !   (128-Nq)/128 of its N columns.  The old "Nq <= 64 uses cuBLAS for x"
  !   switch was a symptom of x never having had a tile of its own, not a
  !   structural cuBLAS advantage.  x kernel alone: 189.4 -> 97.1 us (Nq=8),
  !   102.0 -> 56.7 (Nq=16, CUTE), 76.7 -> 65.8 (Nq=32, CUTE), 89.4 -> 87.5
  !   (Nq=64, CUTE) -- the gain fades exactly as the predicated fraction
  !   1 - Nq/128 does.
  !
  ! * y on cuBLAS at Nq = 8 only: the y kernel goes 960.9 -> 807.2 us
  !   (-16.0%).  CUTLASS FP64 multistage needs at least two warps, so against
  !   an 8x8x8 batch the smallest tile it can build loses 31/32 of its output
  !   tile and half of K to predication.  At Nq = 16 cuBLAS y is 2.27x
  !   SLOWER, so this is specific to Nq = 8, not a "small Nq" rule.
  !
  ! * x as the fused carrier at Nq = 32, replacing the y carrier that held
  !   this slot before: 609.0 -> 590.7 us/stage (-3.0%, 12/12, disjoint).
  !   The carrier kernel alone is 223.9 (y) -> 215.8 (x) by the CSKIP
  !   ablation, and the plain GEMM that the carrier frees is cheaper on the
  !   x side than on the y side.  For the record the same three-way at
  !   Nq = 32, carrier kernel priced by CSKIP: z 338.1, y 223.9, x 215.8 us.
  !   The x carrier's tile is the one tile that fits at EVERY order -- the
  !   problem's N extent after the transpose is exactly Nq -- but it is also
  !   the only carrier whose rows are the packed index j + Nq*k + Nq*Nq*elem,
  !   so it pays two integer divisions per row iteration.  Replacing them with
  !   shifts (every Nq here is a power of two) is worth 2.7-3.2% of the stage
  !   and takes the carrier from 130 to 96 registers; without it the x carrier
  !   LOSES 9.7% at Nq = 32.  Under a NARROW epilogue the x carrier also lost
  !   +4.0% at Nq = 8 and +4.1% at Nq = 16; the 16-byte epilogue (below)
  !   reverses both, so x now carries at Nq = 8, 16 and 32.  It stays rejected
  !   at Nq = 64: ceiling 671.4 us/stage, +17.7%.  What binds that is not
  !   spill -- forwarding both Escale factors drives the spill to zero and it
  !   still loses 18% -- but the register file as an occupancy cap, 128
  !   threads x 254 registers being exactly 2 CTAs/SM.  Forcing 3 CTAs makes
  !   ptxas spill 680/964 bytes for +110%.
  !
  !   The last lever on that ceiling was measured and REJECTED: fold Ey*Dy
  !   into the z GEMM's epilogue (SCALE_DG_XFWD bit 3, run_volume_gemm_z_
  !   scaleadd, the mirror of the deriv_x-into-y fold the Nq > 64 z carrier
  !   uses) so the carrier reads ONE volume tensor instead of two.  Exclusive
  !   GB200, 12 interleaved pairs, CUDA device us/stage: z carrier 564.4,
  !   best unfolded x carrier 670.5 (+18.80%), best folded x carrier 664.1
  !   (+17.66%).  The fold is worth 6.4 us, i.e. 6% of the 106 us gap.
  !   By the CSKIP ablation it moves 27.9 us out of the carrier and pays
  !   11.2 us for it in the z GEMM, and the two close to 0.0 us against the
  !   16.7 us the totals moved.  It does what it is for and still loses:
  !   ncu (mechanism only) has the carrier at 667 -> 527 MB of DRAM, exactly
  !   the z carrier's 526, and 60.2 -> 51.5 M instructions, BELOW the z
  !   carrier's 58.9 M -- and the kernel is still 336.8 us against 237.6.
  !   The whole residual is latency cover at an unchanged occupancy: warp
  !   latency per issued instruction 8.10 against the z carrier's 4.97, long
  !   scoreboard 2.98 against 0.88, both at 2 CTAs/SM and 12% achieved.  The
  !   fold frees 2 registers (254 -> 252, no spill either way); 3 CTAs would
  !   need 170, so the occupancy cap does not move and cannot be bought back
  !   this way.  The x carrier at Nq = 64 is not an instruction or a traffic
  !   problem any more; it is a latency-cover problem, and the fold is off by
  !   default.
  !
  !   At Nq = 8 the x carrier is why GEMM_FUSED trails GEMM_CUTE.  N = 8 does
  !   not build (the FP64 multistage B iterator static-asserts on zero
  !   contiguous iterations), so Nq = 8 is the ONE order whose carrier tile
  !   has TbN = 16 against a problem N of 8; every other order matches Nq
  !   exactly.  Each CTA therefore computes and lifts a full 64x16 tile and
  !   the OutputTileIterator masks the dead half only at store time --
  !   thread_inst/inst is 32 at both Nq = 8 and 16, i.e. no lane predication
  !   saves the work.  Measured (ncu, both orders in one job, identical tile):
  !   32768 vs 16384 CTAs, 169.3 vs 88.9 M instructions (1.90x) for the same
  !   DRAM bytes (1031 vs 981 MB) and the same occupancy (24.1%).  The
  !   epilogue inside the carrier costs 182.1 us at Nq = 8 against 119.8 at
  !   Nq = 16 and 118.8 at Nq = 32 for the same 16.78 M output points.  The
  !   differential +62.3 us is 1.34x the 46.5 us that fusing saves, and the
  !   full accounting closes to 0.1 us at all three orders.  An early exit for
  !   the dead threads was built, validated bit-identical and rejected: the
  !   dead columns are lanes of the same warp, so the guard becomes SASS
  !   predication rather than a branch and saves no issue slots (instructions
  !   went UP, 170.5 -> 171.0 M; 3/12 pairs, ranges overlapping).  A
  !   carrier-only narrower tile is not available -- the tile is shared with
  !   GEMM_CUTE, and run_x_gemm_assembly static_asserts that.
  ! * y as the fused carrier at Nq = 32, the previous holder of this slot:
  !   the epilogue alone goes 218.1 -> 159.2 us (-27%).  With k fixed per
  !   batch, two of the three lift face-point pairs are constant along a tile
  !   direction (per-element face loads 4 -> 2) against one pair for the z
  !   carrier.  Registers were NOT the constraint there: the y carrier uses
  !   128-134 registers with zero spill against the z carrier's 254.  The
  !   same move LOSES 24.8% at Nq = 16, where the 16x32 y tile
  !   half-predicates a (16,16) problem and runs 4x the CTAs, and 157% at
  !   Nq = 8, where the smallest buildable tile is 32x64 against an 8x8
  !   output and the kernel takes 255 registers with spill.
  !
  ! * The carrier at Nq = 128 and 256: BOTH alternatives measured, BOTH
  !   rejected, and the z carrier keeps the slot.  Exclusive GB200, Slurm job
  !   77137, 12 interleaved pairs, ranges disjoint, CUDA device us/stage:
  !
  !                     p=127 (Nq=128)          p=255 (Nq=256)
  !     z carrier        639.6 (adopted)         943.0 (adopted)
  !     x carrier        680.7  +6.43%  0/12    977.1  +3.63%  0/12
  !     y carrier        685.2  +7.09%  0/12   1014.4  +7.62%  0/12
  !
  !   The x carrier lost as a CARRIER, not as an untuned one.  A first cut on
  !   the shared 64x128 tile was +59% at p=127, and a 20-tile sweep on both
  !   paths took that to +6.4% -- so the tile was worth 52 points and the
  !   remaining 6 are the carrier itself.  The mechanism of the first cut is
  !   the epilogue fragment: it is TbM*TbN/threads elements and the x carrier
  !   holds five of them (accumulator, Dy, Dz, Ex, lift), so 64x128 over 128
  !   threads gives 64 doubles each and takes 255 registers with 304 B of
  !   spill.  The winning shapes are the 32-doubles ones -- tile 18
  !   (64x64, warp 32x32, four stages) at 230 registers and ZERO spill, tile 5
  !   the same with three stages -- which is the same fragment size the
  !   Nq > 64 z carrier's 64x32 tile has at 254 registers and no spill.  At
  !   equal occupancy (2 CTAs/SM, 12.5% theoretical, both) and zero spill on
  !   both sides the x carrier is still 231.4 us against the z carrier's
  !   191.6 at p=127 and 318.0 against 287.6 at p=255.  The ablation
  !   accounting closes to 0.0 us at both orders: the whole loss is inside the
  !   carrier kernel (rest of stage +1.1 us at p=127, +3.4 at p=255).
  !
  !   What the x carrier gives up is the Nq > 64 fusion package.  Escale_y
  !   CAN still be forwarded (-0.60% at p=127, -0.65% at p=255) and Escale_z
  !   cannot pay for itself (+0.75% / -0.34%), but folding deriv_x into the y
  !   GEMM is impossible for it -- that fold needs x to run BEFORE y, and the
  !   carrier runs last -- so its epilogue reads three volume tensors where
  !   the z carrier reads two.  The narrower tile the x carrier needs is also
  !   NOT free on the other path: tile 18 costs GEMM_CUTE +1.23% at p=127 and
  !   +1.35% at p=255 (tile 5 +1.16% / +0.74%), and the tiles must be shared.
  !
  !   The y carrier fits the tile perfectly here -- 64x64 against a 128x128 or
  !   256x256 batch, nothing predicated, which is exactly the fit that won it
  !   the Nq = 32 slot -- and still loses more than x.  It has no 16-byte
  !   epilogue and no clamp aggregation (cutlass_y_gemm_assembly.h has
  !   neither), and on the x carrier at these orders the 16-byte epilogue
  !   alone is worth -5.2%.
  !
  !   Two findings from that sweep that are about the ORDER, not the carrier:
  !   the shift/mask row split (see the x-carrier entry above) is worth only
  !   0.8-1.3% at Nq > 64 against 2.7-3.2% at Nq <= 64 -- it decays as the row
  !   gets longer, the opposite of what was expected -- and the 16-byte lift
  !   loses on the x carrier here too (+2.5% at p=255, +3.5% at p=127) even
  !   though the z carrier at the same orders has it ON.  Its sign follows the
  !   carrier, not the order.
  !
  ! * cuBLAS z at Nq = 32, legal only because z is no longer the carrier (a
  !   carrier cannot be cuBLAS: cuBLAS has no epilogue).  Plain z goes
  !   119.7 -> 68.6 us, because the CUTLASS GemmZ 64x32 tile wastes half its
  !   rows on n = Nq = 32.
  !
  ! * The 16-byte epilogue, opened from Nq > 64 down to every order here.  It
  !   is the largest single item in the table: -7.28% at Nq = 32 (12/12), and
  !   it is what reverses the x carrier at Nq = 8 and 16.  The carrier kernel
  !   goes 216.2 -> 172.6 us at Nq = 32 with the rest of the stage unmoved,
  !   at 124 registers and no spill.  p31_gap_study.md 28 had rejected the
  !   Nq > 64 package here at +69.1%, but that was the z carrier's 64x32 tile
  !   at 254 registers spilling 16.3 M times -- a property of the tile, not of
  !   the order.
  !
  !   The other two ingredients of that package stay off.  The 16-byte lift
  !   loses at all four orders by 2.1-3.2%: it does what it is for (global
  !   load requests -27 to -34%, instructions -10 to -15%) and pays 124 -> 154
  !   registers, which costs a CTA per SM at Nq <= 32 and lengthens the
  !   dependent chain at Nq = 64.  Clamp aggregation is worth +-0.25% and
  !   changes sign: adopted at Nq = 8 (-0.24%) and Nq = 64 (-0.12%), rejected
  !   at Nq = 16 and 32.  It is register-neutral and cuts instructions 4.7%
  !   without changing global load requests at all, and it pays in latency
  !   cover -- the min() chain it removes was standing between the face
  !   gathers' issue and their use, so stall_long_scoreboard rises at every
  !   order.  Which orders that trade pays at IS closed now, and the index is
  !   not a property of the baseline: it is the ratio of the two INCREMENTS.
  !   Every one of these kernels obeys
  !
  !       duration  =  K * instructions * (warp latency per issued
  !                    instruction) / (resident warps per scheduler)
  !
  !   -- the three ncu factors reproduce the measured kernel time to 0.4
  !   points in all six configurations below -- so the clamp wins exactly
  !   when the instructions it removes outweigh the latency cover it costs.
  !   Measured on one exclusive GB200 (12 interleaved pairs, pkg 4 -> 5) with
  !   the mechanism from one ncu job (* = out-of-role ablation, kept out of
  !   dispatch, run through SCALE_DG_CARRIER):
  !
  !     carrier    base issue%   d(inst)   d(latency)   d(kernel)   d(stage)
  !     x  Nq=8       61.3        -4.72      +3.26        -1.57      -0.15
  !     x  Nq=16      56.7        -4.72      +4.15        -1.12      -0.06
  !     x  Nq=32      54.0        -4.67      +4.29        +0.26      -0.02
  !     z  Nq=64      39.8        -1.59      +1.64        -0.14      -0.30
  !     z  Nq=16 *    40.8        -1.35      +9.93        +7.27      +2.70
  !     x  Nq=64 *    18.4       -14.66      +1.82       -12.97      -5.70
  !
  !   Within the x carrier the instruction saving is the same -4.7% at all
  !   three orders and the ordering is set entirely by the latency term,
  !   which is monotone: 3.26 < 4.15 < 4.29.  The prediction that the Nq = 8
  !   carrier is the most issue-bound of the three holds (issue 61.3 > 56.7 >
  !   54.0) and it does bank the saving best.  The four ADOPTED orders do not
  !   line up on one index because Nq = 64 is a different kernel: on the z
  !   carrier the clamp removes only 1.6% of the instructions and only 1.6%
  !   of the cover, and that lands just on the winning side.  The sign
  !   follows neither the order nor the carrier on its own -- crossing the
  !   two shows both flipping (z loses 2.70% at Nq = 16 and wins at 64; x is
  !   a wash at 32 and wins 5.70% at 64).
  !
  ! * Escale forwarding is off at every order.  It was adopted at Nq = 32
  !   under the narrow epilogue, where it was worth 17.4 us: the extra volume
  !   tensor cost the y GEMM 10.3 us and saved the carrier 27.6 us.  The
  !   16-byte epilogue cuts a volume tensor's marginal cost in the carrier to
  !   8.5 us, 3.2x cheaper, and the trade inverts (+0.32%, 12/12).  At Nq = 16
  !   the two factors only ever paid as a pair, and under the wide epilogue
  !   the pair is +8.58%.  At Nq = 8 forwarding was +0.53% even under a z
  !   carrier.
  ! * Escale_x forwarded out of the x epilogue is what the Nq = 32 y carrier
  !   used and is meaningless with x as the carrier (the carrier applies every
  !   weight itself).  The same forwarding at Nq = 8 under a z carrier is
  !   +0.53%, i.e. a loss -- the extra volume tensor costs x 21.8 us and
  !   saves the z epilogue only 13.5 us -- so Nq = 8 keeps the plain form.
  !
  ! Environment overrides.  These are measurement infrastructure, not
  ! production knobs.  UNSET always means the table above; an override
  ! applies to GEMM_CUTE and GEMM_FUSED alike, and is still subject to the
  ! legality clamps in dg_gemm_plan.  Entries marked "ablation" deliberately
  ! produce wrong numbers and exist only to price a launch off the stage
  ! time.
  !
  !   SCALE_DG_XCUTLASS  x library / weighting.  0 = cuBLAS, 1 = CUTLASS
  !                      unweighted, 2 = CUTLASS with Escale_x folded into
  !                      its epilogue (GEMM_FUSED only; GEMM_CUTE demotes it
  !                      to 1 so the library assignment stays shared),
  !                      3 = skip x (ablation), 4 = skip x but keep the
  !                      partially weighted assembly epilogue (ablation;
  !                      3 and 4 together separate the x GEMM cost from the
  !                      epilogue saving).   Default: per-order table.
  !   SCALE_DG_XTILE     index into that order's CUTLASS x tile list in
  !                      cuda_cutlass_gemm_fused.cu.  Default: per-order
  !                      table (9 / 5 / 7 / 3 at Nq = 8 / 16 / 32 / 64).
  !   SCALE_DG_YCUBLAS   y library.  0 = CUTLASS, 1 = cuBLAS strided
  !                      batched, 2 = skip y (ablation).
  !                      Default: cuBLAS at Nq = 8, CUTLASS elsewhere.
  !   SCALE_DG_ZCUBLAS   z library, for a z that is NOT the carrier.
  !                      0 = CUTLASS, 1 = cuBLAS strided batched.
  !                      Default: cuBLAS at Nq = 32, CUTLASS elsewhere.
  !   SCALE_DG_CARRIER   which volume GEMM carries the GEMM_FUSED assembly
  !                      epilogue.  0 = z, 1 = y (Nq = 8, 16 and 32 have a y
  !                      assembly kernel), 2 = x (Nq = 8, 16, 32 and 64, on
  !                      that order's adopted x tile).  AGENTS.md fixes that
  !                      the LAST volume GEMM must fuse the weighting and the
  !                      surface lift, not which GEMM runs last.
  !                      Default: x at Nq = 8, 16 and 32, z elsewhere.
  !   SCALE_DG_XFWD     x carrier only.  Which Escale factors the two plain
  !                      GEMMs fold into their own epilogues: bit 0 = Escale_y
  !                      into y, bit 1 = Escale_z into z, bit 2 = ablation,
  !                      force the general integer-division row-index split in
  !                      the carrier instead of the shift/mask one, bit 3 =
  !                      fold Escale_y*Dy into the z GEMM's epilogue as well
  !                      (Nq = 64 only), so the carrier reads ONE volume
  !                      tensor instead of two; it implies bits 0 and 1 and
  !                      forces the serial y-then-z schedule.  A bit is
  !                      cleared when that GEMM is on cuBLAS, which has no
  !                      epilogue.  Default: 0 at every order.
  !   SCALE_DG_XPKG     x carrier only.  The three Nq > 64 epilogue
  !                      ingredients the z carrier bundles: bit 0 = clamp
  !                      aggregation (hoist the index clamps onto the tile
  !                      origin), bit 1 = 16-byte lift (interleaved face
  !                      layout plus packed lift-coefficient pairs), bit 2 =
  !                      16-byte epilogue accesses (GemmXWide, same mainloop
  !                      tile).  All three are epilogue-side only.
  !                      Default: 5 at Nq = 8, 4 at Nq = 16 and 32, and 0 at
  !                      the orders where x does not carry.
  !   SCALE_DG_ZPKG      z carrier only, Nq = 16 and 64: the same three
  !                      epilogue ingredients as SCALE_DG_XPKG, on the z
  !                      carrier.  Unset keeps the order's adopted form: -1,
  !                      which is the z carrier's own per-order default (at
  !                      Nq = 64 that is 5, the 16-byte epilogue plus clamp
  !                      aggregation, with the 16-byte lift off).  Nq = 16
  !                      does not use a z carrier at all any more, so a value
  !                      there is an out-of-role ablation.
  !   SCALE_DG_ZTILE     index into the order's plain-z CUTLASS tile list in
  !                      cuda_cutlass_gemm_fused.cu (Nq = 16 only so far).
  !                      Applies to GEMM_CUTE and GEMM_FUSED alike, since both
  !                      reach the plain z through launch_volume_gemm_z.
  !                      Default: -1, the order's adopted set.
  !   SCALE_DG_YSCHED    schedule when the carrier is not z.  With a y carrier,
  !                      0 = x then z on the main stream, 1 = z on the second
  !                      side stream concurrently with x.  With an x carrier,
  !                      0 = y then z on the main stream, 1 = y on the second
  !                      side stream concurrently with z.  The carrier itself
  !                      always runs after the join; it reads the other two
  !                      derivatives.  SCALE_DG_XFWD bit 3 forces 0, because
  !                      the folded z reads y's output.
  !                      Default: 1 at Nq = 8, 16 and 32, 0 elsewhere.
  !   SCALE_DG_ZSKIP     ablation: skip the plain z volume GEMM. Default 0.
  !   SCALE_DG_CSKIP     ablation: skip the launch that carries the assembly
  !                      epilogue -- the fused carrier on GEMM_FUSED, the
  !                      separate separable_lift_assembly kernel on
  !                      GEMM_CUTE.  Default 0.
  !   SCALE_DG_FSKIP     ablation: skip the elembnd face flux.    Default 0.
  !   SCALE_DG_VSKIP     ablation: skip the volume flux.          Default 0.
  !   SCALE_DG_CUTEPAR   OUT-OF-ROLE ablation, GEMM_CUTE only: spread the
  !                      three (independent, because unfused) volume GEMMs
  !                      over streams, the way SCALE_DG_GVOLPAR does on the
  !                      unfused cuBLAS driver.  0 = serial (the shipped
  !                      GEMM_CUTE), 1 = y beside x, 2 = all three.
  !                      Default 0; never set from any DqdtKernel_Type.
  !
  ! Each variable is read once and cached in the matching *_env slot below;
  ! -2 means "not read yet" and -1 means "unset, use the table".
  ! ------------------------------------------------------------------

  !- The resolved configuration for one launch.  dg_gemm_defaults fills it
  !- from the static table with no environment access; dg_gemm_plan then
  !- applies the overrides and the legality clamps.
  type :: dg_gemm_plan_t
    integer :: x_mode  = 0   ! 0 cuBLAS, 1 CUTLASS, 2 CUTLASS+Escale_x, 3/4 skip
    integer :: x_tile  = 0   ! index into the order's CUTLASS x tile list
    integer :: y_lib   = 0   ! 0 CUTLASS, 1 cuBLAS, 2 skip
    integer :: carrier = 0   ! 0 = z carries the fused epilogue, 1 = y, 2 = x
    integer :: z_lib   = 0   ! 0 CUTLASS, 1 cuBLAS (a plain z only)
    integer :: ysched  = 0   ! 0 = x then z, 1 = z beside x on side2
    integer :: xfwd    = 0   ! x carrier only: bit 0 Escale_y into y,
                             ! bit 1 Escale_z into z
    integer :: xpkg    = 0   ! x carrier only: bit 0 clamp aggregation,
                             ! bit 1 16-byte lift, bit 2 16-byte epilogue
    integer :: z_tile  = -1  ! plain-z CUTLASS tile index, -1 = order default
    integer :: zpkg    = -1  ! z carrier only: -1 = order default, else
                             ! bit 0 clamp aggregation, bit 1 16-byte lift,
                             ! bit 2 16-byte epilogue
  end type dg_gemm_plan_t

  !- Cached environment slots for the overrides documented above.
  integer, save :: x_pkg_env = -2, z_tile_env = -2, z_pkg_env = -2
  integer, save :: x_mode_env = -2, x_tile_env = -2, y_cublas_env = -2
  integer, save :: zcublas_env = -2, carrier_env = -2, ysched_env = -2
  integer, save :: xfwd_env = -2
  integer, save :: zskip_env = -2, cskip_env = -2, fskip_env = -2, vskip_env = -2
  integer, save :: fluxfuse_env = -2, gvolpar_env = -2
  integer, save :: cutepar_env = -2

  public :: cuda_cal_volume_flux
  public :: cuda_cal_volume_deriv
  public :: cuda_cal_surface_lift
  public :: cuda_assemble_dqdt
