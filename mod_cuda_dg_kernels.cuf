      bind(C, name="launch_volume_gemm_cute")
      import
      integer(c_int), value :: Nq, Ne, mma_shape
      real(c_double), device :: deriv_x(*), deriv_y(*), deriv_z(*)
      real(c_double), device :: flux_x(*), flux_y(*), flux_z(*)
      real(c_double), device :: D1D(*), D1D_tr(*)
      integer(c_int) :: launch_volume_gemm_cute
    end function launch_volume_gemm_cute
  end interface

contains

  !> Launch the kernels of this module on the stream of an OpenACC queue.
  !!
  !! The OpenACC regions of the time-stepping loop are put on queue `queue`.
  !! Sharing its stream keeps the order of the two kinds of kernels exactly as
  !! it was when every OpenACC region synchronized on its own, but lets the
  !! host queue the launches without blocking in between.
  subroutine cuda_dg_bind_acc_stream(queue)
    use openacc, only: acc_get_cuda_stream
    implicit none
    integer, intent(in) :: queue
    !------------------------------------------------------------

    dg_stream = acc_get_cuda_stream(queue)
    call dg_set_cuda_stream(dg_stream)

    return
  end subroutine cuda_dg_bind_acc_stream

  !> Turn the second stream on or off.  Overlapping the element boundary flux
  !! with the volume GEMMs is worth about 15 us per tendency call when the
  !! kernels are launched one by one, but on a CUDA graph replay the same
  !! structure costs about 5 us per call instead, so the host turns it off
  !! before capturing.
  subroutine cuda_dg_set_side_stream(on)
    implicit none
    logical, intent(in) :: on
    !------------------------------------------------------------

    dg_side_enabled = on

    return
  end subroutine cuda_dg_set_side_stream

  !> Turn the per-kernel CUDA event timing on or off.
  subroutine cuda_dg_set_event_timing(on)
    implicit none
    logical, intent(in) :: on
    !------------------------------------------------------------

    dg_ev_enabled = on

    return
  end subroutine cuda_dg_set_event_timing

  !> Create the second stream and its two events on first use.
  subroutine dg_side_stream_init()
    implicit none

    integer :: istat
    !------------------------------------------------------------

    if (dg_side_ready) return

    istat = cudaStreamCreateWithFlags(dg_side_stream,cudaStreamNonBlocking)
    if (istat /= cudaSuccess) call cuda_failure("cudaStreamCreateWithFlags",istat)
    istat = cudaEventCreateWithFlags(dg_side_fork_ev,cudaEventDisableTiming)
    if (istat /= cudaSuccess) call cuda_failure("cudaEventCreateWithFlags",istat)
    istat = cudaEventCreateWithFlags(dg_side_join_ev,cudaEventDisableTiming)
    if (istat /= cudaSuccess) call cuda_failure("cudaEventCreateWithFlags",istat)
    dg_side_ready = .true.

    return
  end subroutine dg_side_stream_init

  !> Let the second stream start on what the main stream has queued so far.
  subroutine dg_side_fork()
    implicit none

    integer :: istat
    !------------------------------------------------------------

    call dg_side_stream_init()

    istat = cudaEventRecord(dg_side_fork_ev,dg_stream)
    if (istat /= cudaSuccess) call cuda_failure("cudaEventRecord(fork)",istat)
    istat = cudaStreamWaitEvent(dg_side_stream,dg_side_fork_ev,0)
    if (istat /= cudaSuccess) call cuda_failure("cudaStreamWaitEvent(fork)",istat)

    return
  end subroutine dg_side_fork

  !> Hold the main stream until the second stream has finished its work.
  subroutine dg_side_join()
    implicit none

    integer :: istat
    !------------------------------------------------------------

    istat = cudaEventRecord(dg_side_join_ev,dg_side_stream)
    if (istat /= cudaSuccess) call cuda_failure("cudaEventRecord(join)",istat)
    istat = cudaStreamWaitEvent(dg_stream,dg_side_join_ev,0)
    if (istat /= cudaSuccess) call cuda_failure("cudaStreamWaitEvent(join)",istat)

    return
  end subroutine dg_side_join

  !> Record one measurement boundary on the kernel stream.
  subroutine dg_ev_record(iev)
    implicit none
    integer, intent(in) :: iev

    integer :: istat
    !------------------------------------------------------------

    if (.not. dg_ev_enabled) return

    istat = cudaEventRecord(split_events(iev,ev_buf),dg_stream)
    if (istat /= cudaSuccess) call cuda_failure("cudaEventRecord",istat)

    return
  end subroutine dg_ev_record

  !> Start a measurement: create the events on first use, read back the
  !! measurement of the previous call and switch to the other event buffer.
  subroutine dg_ev_begin()
    implicit none

    integer :: istat, iev, ibuf
    !------------------------------------------------------------

    if (.not. dg_ev_enabled) return

    if (.not. split_events_initialized) then
      do ibuf = 1, 2
        do iev = 1, 5
          istat = cudaEventCreate(split_events(iev,ibuf))
          if (istat /= cudaSuccess) call cuda_failure("cudaEventCreate",istat)
        end do
      end do
      split_events_initialized = .true.
    end if

    call dg_ev_harvest()
    ev_buf = 3 - ev_buf

    return
  end subroutine dg_ev_begin

  !> Mark the events just recorded as the measurement to read back next time.
  subroutine dg_ev_end(mode)
    implicit none
    integer, intent(in) :: mode
    !------------------------------------------------------------

    if (.not. dg_ev_enabled) return

    ev_pending = ev_buf
    ev_pending_mode = mode

    return
  end subroutine dg_ev_end

  !> Read the pending measurement into dg_kernel_time (zero if there is none).
  subroutine dg_ev_harvest()
    implicit none

    integer :: istat, nb, i
    real :: ms(4)
    !------------------------------------------------------------

    dg_kernel_time(:) = 0.0_RP
    if (ev_pending == 0) return

    select case (ev_pending_mode)
    case (DG_EV_SINGLE)
      nb = 2
    case (DG_EV_CUTE)
      nb = 4
    case default
      nb = 5
    end select

    istat = cudaEventSynchronize(split_events(nb,ev_pending))
    if (istat /= cudaSuccess) call cuda_failure("cudaEventSynchronize",istat)

    ms(:) = 0.0
    do i = 1, nb-1
      istat = cudaEventElapsedTime(ms(i), &
        split_events(i,ev_pending),split_events(i+1,ev_pending))
      if (istat /= cudaSuccess) call cuda_failure("cudaEventElapsedTime",istat)
    end do

    select case (ev_pending_mode)
    case (DG_EV_SINGLE)
      dg_kernel_time(1) = real(ms(1),RP)*1.0e-3_RP
    case (DG_EV_CUTE)
      dg_kernel_time(1) = real(ms(1)+ms(2)+ms(3),RP)*1.0e-3_RP
      dg_kernel_time(2) = real(ms(2),RP)*1.0e-3_RP
    case (DG_EV_GEMM_FUSED)
      dg_kernel_time(1) = real(ms(1)+ms(2)+ms(3)+ms(4),RP)*1.0e-3_RP
      dg_kernel_time(2) = real(ms(2)+ms(4),RP)*1.0e-3_RP
    case (DG_EV_SPLIT)
      do i = 1, 4
        dg_kernel_time(i) = real(ms(i),RP)*1.0e-3_RP
      end do
    end select

    ev_pending = 0

    return
  end subroutine dg_ev_harvest

  !> Read back the measurement of the last tendency call, which no later call
  !! harvested.  Call it once, after the time-stepping loop.
  subroutine cuda_dg_flush_kernel_time(kernel_time)
    implicit none
    real(RP), intent(out) :: kernel_time(4)
    !------------------------------------------------------------

    call dg_ev_harvest()
    kernel_time(:) = dg_kernel_time(:)

    return
  end subroutine cuda_dg_flush_kernel_time

  !> Begin capturing the kernel stream into a CUDA graph.  Nothing queued
  !! between here and cuda_dg_graph_capture_end() executes; it becomes graph
  !! nodes instead.
  !!
  !! The capture is relaxed rather than thread-local because the OpenACC
  !! regions of the step are queued through the OpenACC runtime, which is not
  !! written with capture in mind and would otherwise have to be audited for
  !! every call it makes while a capture of this thread is open.  What the
  !! stricter modes buy is a diagnostic, not correctness: the step queues
  !! nothing but kernels on this one stream, and the captured result is
  !! checked against the directly launched one field by field.
  subroutine cuda_dg_graph_capture_begin()
    implicit none

    integer :: istat
    !------------------------------------------------------------

    istat = cudaStreamBeginCapture(dg_stream,cudaStreamCaptureModeRelaxed)
    if (istat /= cudaSuccess) &
      call cuda_failure("cudaStreamBeginCapture",istat)

    return
  end subroutine cuda_dg_graph_capture_begin

  !> End the capture and instantiate the executable graph.
  subroutine cuda_dg_graph_capture_end()
    implicit none

    integer :: istat
    !------------------------------------------------------------

    istat = cudaStreamEndCapture(dg_stream,dg_graph)
    if (istat /= cudaSuccess) call cuda_failure("cudaStreamEndCapture",istat)

    istat = cudaGraphInstantiate(dg_graph_exec,dg_graph,0)
    if (istat /= cudaSuccess) call cuda_failure("cudaGraphInstantiate",istat)

    dg_graph_ready = .true.

    return
  end subroutine cuda_dg_graph_capture_end

  !> Replay the captured step on the kernel stream.
  subroutine cuda_dg_graph_launch()
    implicit none

    integer :: istat
    !------------------------------------------------------------

    istat = cudaGraphLaunch(dg_graph_exec,dg_stream)
    if (istat /= cudaSuccess) call cuda_failure("cudaGraphLaunch",istat)

    return
  end subroutine cuda_dg_graph_launch

  logical function cuda_dg_graph_is_ready()
    implicit none
    !------------------------------------------------------------

    cuda_dg_graph_is_ready = dg_graph_ready

    return
  end function cuda_dg_graph_is_ready

  subroutine cuda_dg_graph_finalize()
    implicit none

    integer :: istat
    !------------------------------------------------------------

    if (.not. dg_graph_ready) return

    istat = cudaGraphExecDestroy(dg_graph_exec)
    if (istat /= cudaSuccess) call cuda_failure("cudaGraphExecDestroy",istat)
    istat = cudaGraphDestroy(dg_graph)
    if (istat /= cudaSuccess) call cuda_failure("cudaGraphDestroy",istat)
    dg_graph_ready = .false.

    return
  end subroutine cuda_dg_graph_finalize

  subroutine cuda_cal_elembnd_flux( &
    flux, q, u, v, w, VMapM, VMapP, normal_fn, Fscale, &
    Np, NfpTot, Ne, NeA )
    implicit none
    integer, intent(in) :: Np, NfpTot, Ne, NeA
    real(RP), device, intent(out) :: flux(NfpTot,Ne)
    real(RP), device, intent(in) :: q(Np,NeA), u(Np,NeA), v(Np,NeA), w(Np,NeA)
    integer, device, intent(in) :: VMapM(NfpTot,Ne), VMapP(NfpTot,Ne)
    real(RP), device, intent(in) :: normal_fn(NfpTot,Ne,3), Fscale(NfpTot,Ne)

    integer :: nface, nblock

    nface = NfpTot*Ne
    nblock = (nface+CUDA_BLOCK_SIZE-1)/CUDA_BLOCK_SIZE
    call elembnd_flux_kernel<<<nblock,CUDA_BLOCK_SIZE,0,dg_stream>>>( &
      flux, q, u, v, w, VMapM, VMapP, normal_fn, Fscale, nface, 0 )
    call synchronize_cuda_kernel("elembnd_flux_kernel")
  end subroutine cuda_cal_elembnd_flux

  subroutine cuda_cal_dqdt_fused( &
    dqdt, q, u, v, w, D1D, Lift1D, VMapM, VMapP, &
    normal_fn, Fscale, Escale, &
    Nq, Np, NfpTot, Ne, NeA, kernel_time )
    implicit none
    integer, intent(in) :: Nq, Np, NfpTot, Ne, NeA
    real(RP), device, intent(out) :: dqdt(Np,NeA)
    real(RP), device, intent(in) :: q(Np,NeA)
    real(RP), device, intent(in) :: u(Np,NeA), v(Np,NeA), w(Np,NeA)
    real(RP), device, intent(in) :: D1D(Nq,Nq)
    real(RP), device, intent(in) :: Lift1D(Nq,6)
    integer, device, intent(in) :: VMapM(NfpTot,Ne)
    integer, device, intent(in) :: VMapP(NfpTot,Ne)
    real(RP), device, intent(in) :: normal_fn(NfpTot,Ne,3)
    real(RP), device, intent(in) :: Fscale(NfpTot,Ne)
    real(RP), device, intent(in) :: Escale(Np,Ne,3)
    real(RP), intent(out) :: kernel_time(2)

    integer :: istat

    if (Nq /= 8 .and. Nq /= 16 .and. Nq /= CUDA_FUSED_P31_NQ) then
      write(*,*) "CUDAFORTRAN_FUSED currently requires PolyOrder=7, 15 or 31"
      error stop
    end if
    call dg_ev_begin()

    call dg_ev_record(1)
    select case (Nq)
    case (8)
      call tendency_fused_p7_kernel<<<Ne,CUDA_FUSED_P7_BLOCK_SIZE,0,dg_stream>>>( &
        dqdt, D1D, Lift1D, q, u, v, w, VMapM, VMapP, &
        normal_fn, Fscale, Escale, Ne )
      istat = cudaGetLastError()
      if (istat /= cudaSuccess) call cuda_failure( &
        "tendency_fused_p7_kernel",istat)
    case (16)
      call tendency_fused_p15_kernel<<<Ne,CUDA_FUSED_P15_BLOCK_SIZE,0,dg_stream>>>( &
        dqdt, D1D, Lift1D, q, u, v, w, VMapM, VMapP, &
        normal_fn, Fscale, Escale, Ne )
      istat = cudaGetLastError()
      if (istat /= cudaSuccess) call cuda_failure( &
        "tendency_fused_p15_kernel",istat)
    case default
      ! Nq = 32.  The x and z volume terms and all six face lifts run first,
      ! then the y term is accumulated on top; see the kernel comments for why
      ! the two thread mappings cannot be merged.
      call tendency_fused_p31_xz_kernel<<<Ne,CUDA_FUSED_P31_BLOCK_SIZE,0,dg_stream>>>( &
        dqdt, D1D, Lift1D, q, u, v, w, VMapM, VMapP, &
        normal_fn, Fscale, Escale, Ne )
      call tendency_fused_p31_y_kernel<<<Ne,CUDA_FUSED_P31_BLOCK_SIZE,0,dg_stream>>>( &
        dqdt, D1D, q, v, Escale, Ne )
      istat = cudaGetLastError()
      if (istat /= cudaSuccess) call cuda_failure( &
        "tendency_fused_p31 kernels",istat)
    end select
    call dg_ev_record(2)
    call dg_ev_end(DG_EV_SINGLE)

    kernel_time(1) = dg_kernel_time(1)
    kernel_time(2) = dg_kernel_time(2)
  end subroutine cuda_cal_dqdt_fused

  !> p=255 variable-coefficient tendency. Each element is decomposed into
  !! 16x16 tensor-product tiles, so the same kernels support Ne > 1.
  !> p=63 fused tendency.  The six face fluxes are evaluated once into
  !! flux_bnd, then the x and z volume terms plus all six lifts write dqdt and
  !! the y term is accumulated on top.
  subroutine cuda_cal_dqdt_fused_p63( &
    dqdt, q, u, v, w, D1D, Lift1D, VMapM, VMapP, &
    normal_fn, Fscale, Escale, flux_bnd, &
    Nq, Np, NfpTot, Ne, NeA, kernel_time )
    implicit none
    integer, intent(in) :: Nq, Np, NfpTot, Ne, NeA
    real(RP), device, intent(out) :: dqdt(Np,NeA)
    real(RP), device, intent(in) :: q(Np,NeA)
    real(RP), device, intent(in) :: u(Np,NeA), v(Np,NeA), w(Np,NeA)
    real(RP), device, intent(in) :: D1D(Nq,Nq)
    real(RP), device, intent(in) :: Lift1D(Nq,6)
    integer, device, intent(in) :: VMapM(NfpTot,Ne)
    integer, device, intent(in) :: VMapP(NfpTot,Ne)
    real(RP), device, intent(in) :: normal_fn(NfpTot,Ne,3)
    real(RP), device, intent(in) :: Fscale(NfpTot,Ne)
    real(RP), device, intent(in) :: Escale(Np,Ne,3)
    real(RP), device, intent(out) :: flux_bnd(NfpTot,Ne)
    real(RP), intent(out) :: kernel_time(2)

    integer :: istat, nface, nblock_face, nblock_vol

    if (Nq /= CUDA_FUSED_P63_NQ .or. Np /= CUDA_FUSED_P63_NQ**3) then
      error stop "cuda_cal_dqdt_fused_p63 requires PolyOrder=63"
    end if
    call dg_ev_begin()

    nface = NfpTot*Ne
    nblock_face = (nface+CUDA_BLOCK_SIZE-1)/CUDA_BLOCK_SIZE
    nblock_vol = CUDA_FUSED_P63_BLOCKS_PER_ELEMENT*Ne

    call dg_ev_record(1)
    call elembnd_flux_kernel<<<nblock_face,CUDA_BLOCK_SIZE,0,dg_stream>>>( &
      flux_bnd, q, u, v, w, VMapM, VMapP, normal_fn, Fscale, nface, 0 )
    call tendency_fused_p63_xz_kernel &
      <<<nblock_vol,CUDA_FUSED_P63_BLOCK_SIZE,0,dg_stream>>>( &
      dqdt, D1D, Lift1D, q, u, w, flux_bnd, Escale, Ne )
    call tendency_fused_p63_y_kernel &
      <<<nblock_vol,CUDA_FUSED_P63_BLOCK_SIZE,0,dg_stream>>>( &
      dqdt, D1D, q, v, Escale, Ne )
    istat = cudaGetLastError()
    if (istat /= cudaSuccess) call cuda_failure("p=63 tendency kernels",istat)
    call dg_ev_record(2)
    call dg_ev_end(DG_EV_SINGLE)

    kernel_time(1) = dg_kernel_time(1)
    kernel_time(2) = dg_kernel_time(2)
  end subroutine cuda_cal_dqdt_fused_p63


  !> p=127 fused tendency.  Same three-kernel shape as cuda_cal_dqdt_fused_p63;
  !! the volume kernels tile the 128x128 plane into four 64x64 blocks.
  subroutine cuda_cal_dqdt_fused_p127( &
    dqdt, q, u, v, w, D1D, Lift1D, VMapM, VMapP, &
    normal_fn, Fscale, Escale, flux_bnd, &
    Nq, Np, NfpTot, Ne, NeA, kernel_time )
    implicit none
    integer, intent(in) :: Nq, Np, NfpTot, Ne, NeA
    real(RP), device, intent(out) :: dqdt(Np,NeA)
    real(RP), device, intent(in) :: q(Np,NeA)
    real(RP), device, intent(in) :: u(Np,NeA), v(Np,NeA), w(Np,NeA)
    real(RP), device, intent(in) :: D1D(Nq,Nq)
    real(RP), device, intent(in) :: Lift1D(Nq,6)
    integer, device, intent(in) :: VMapM(NfpTot,Ne)
    integer, device, intent(in) :: VMapP(NfpTot,Ne)
    real(RP), device, intent(in) :: normal_fn(NfpTot,Ne,3)
    real(RP), device, intent(in) :: Fscale(NfpTot,Ne)
    real(RP), device, intent(in) :: Escale(Np,Ne,3)
    real(RP), device, intent(out) :: flux_bnd(NfpTot,Ne)
    real(RP), intent(out) :: kernel_time(2)

    integer :: istat, nface, nblock_face, nblock_vol

    if (Nq /= CUDA_FUSED_P127_NQ .or. Np /= CUDA_FUSED_P127_NQ**3) then
      error stop "cuda_cal_dqdt_fused_p127 requires PolyOrder=127"
    end if
    call dg_ev_begin()

    nface = NfpTot*Ne
    nblock_face = (nface+CUDA_BLOCK_SIZE-1)/CUDA_BLOCK_SIZE
    nblock_vol = CUDA_FUSED_P127_BLOCKS_PER_ELEMENT*Ne

    call dg_ev_record(1)
    call elembnd_flux_kernel<<<nblock_face,CUDA_BLOCK_SIZE,0,dg_stream>>>( &
      flux_bnd, q, u, v, w, VMapM, VMapP, normal_fn, Fscale, nface, 0 )
    call tendency_fused_p127_xz_kernel &
      <<<nblock_vol,CUDA_FUSED_P127_BLOCK_SIZE,0,dg_stream>>>( &
      dqdt, D1D, Lift1D, q, u, w, flux_bnd, Escale, Ne )
    call tendency_fused_p127_y_kernel &
      <<<nblock_vol,CUDA_FUSED_P127_BLOCK_SIZE,0,dg_stream>>>( &
      dqdt, D1D, q, v, Escale, Ne )
    istat = cudaGetLastError()
    if (istat /= cudaSuccess) call cuda_failure("p=127 tendency kernels",istat)
    call dg_ev_record(2)
    call dg_ev_end(DG_EV_SINGLE)

    kernel_time(1) = dg_kernel_time(1)
    kernel_time(2) = dg_kernel_time(2)
  end subroutine cuda_cal_dqdt_fused_p127

  subroutine cuda_cal_dqdt_fused_p255( &
    dqdt, q, u, v, w, D1D, Lift1D, VMapM, VMapP, &
    normal_fn, Fscale, Escale, flux_bnd, &
    Nq, Np, NfpTot, Ne, NeA, kernel_time )
    implicit none
    integer, intent(in) :: Nq, Np, NfpTot, Ne, NeA
    real(RP), device, intent(out) :: dqdt(Np,NeA)
    real(RP), device, intent(in) :: q(Np,NeA)
    real(RP), device, intent(in) :: u(Np,NeA), v(Np,NeA), w(Np,NeA)
    real(RP), device, intent(in) :: D1D(Nq,Nq)
    real(RP), device, intent(in) :: Lift1D(Nq,6)
    integer, device, intent(in) :: VMapM(NfpTot,Ne)
    integer, device, intent(in) :: VMapP(NfpTot,Ne)
    real(RP), device, intent(in) :: normal_fn(NfpTot,Ne,3)
    real(RP), device, intent(in) :: Fscale(NfpTot,Ne)
    real(RP), device, intent(in) :: Escale(Np,Ne,3)
    real(RP), device, intent(out) :: flux_bnd(NfpTot,Ne)
    real(RP), intent(out) :: kernel_time(2)

    integer :: istat, nface, nblock_face, nblock_deriv
    type(dim3) :: tile_threads

    if (Nq /= CUDA_P255_NQ .or. Np /= CUDA_P255_NQ**3) then
      error stop "cuda_cal_dqdt_fused_p255 requires PolyOrder=255"
    end if
    call dg_ev_begin()

    nface = NfpTot*Ne
    nblock_face = (nface+CUDA_BLOCK_SIZE-1)/CUDA_BLOCK_SIZE
    nblock_deriv = CUDA_P255_BLOCKS_PER_ELEMENT*Ne
    tile_threads = dim3(CUDA_P255_TILE,CUDA_P255_TILE,1)

    call dg_ev_record(1)
    call elembnd_flux_kernel<<<nblock_face,CUDA_BLOCK_SIZE,0,dg_stream>>>( &
      flux_bnd, q, u, v, w, VMapM, VMapP, normal_fn, Fscale, nface, 0 )
    call tendency_x_p255_kernel<<<nblock_deriv,tile_threads,0,dg_stream>>>( &
      dqdt, q, u, D1D, Lift1D, flux_bnd, Escale, Ne )
    call tendency_y_p255_kernel<<<nblock_deriv,tile_threads,0,dg_stream>>>( &
      dqdt, q, v, D1D, Lift1D, flux_bnd, Escale, Ne )
    call tendency_z_p255_kernel<<<nblock_deriv,tile_threads,0,dg_stream>>>( &
      dqdt, q, w, D1D, Lift1D, flux_bnd, Escale, Ne )
    istat = cudaGetLastError()
    if (istat /= cudaSuccess) call cuda_failure("p=255 tendency kernels",istat)
    call dg_ev_record(2)
    call dg_ev_end(DG_EV_SINGLE)

    kernel_time(1) = dg_kernel_time(1)
    kernel_time(2) = dg_kernel_time(2)
  end subroutine cuda_cal_dqdt_fused_p255

  subroutine cuda_cal_dqdt_fused_tc( &
    dqdt, q, u, v, w, D1D, Lift1D, VMapM, VMapP, &
    normal_fn, Fscale, Escale, &
    Nq, Np, NfpTot, Ne, NeA, kernel_time )
    implicit none
    integer, intent(in) :: Nq, Np, NfpTot, Ne, NeA
    real(RP), device, intent(out) :: dqdt(Np,NeA)
    real(RP), device, intent(in) :: q(Np,NeA)
    real(RP), device, intent(in) :: u(Np,NeA), v(Np,NeA), w(Np,NeA)
    real(RP), device, intent(in) :: D1D(Nq,Nq)
    real(RP), device, intent(in) :: Lift1D(Nq,6)
    integer, device, intent(in) :: VMapM(NfpTot,Ne)
    integer, device, intent(in) :: VMapP(NfpTot,Ne)
    real(RP), device, intent(in) :: normal_fn(NfpTot,Ne,3)
    real(RP), device, intent(in) :: Fscale(NfpTot,Ne)
    real(RP), device, intent(in) :: Escale(Np,Ne,3)
    real(RP), intent(out) :: kernel_time(2)

    integer :: istat

    if (Nq /= 8 .and. Nq /= 16 .and. Nq /= CUDA_FUSED_P31_NQ) then
      write(*,*) "CUDAFORTRAN_FUSED_TC currently requires PolyOrder=7, 15 or 31"
      error stop
    end if
    call dg_ev_begin()

    call dg_ev_record(1)
    select case (Nq)
    case (8)
      call launch_tendency_fused_p7_tc( &
        dqdt, D1D, Lift1D, q, u, v, w, VMapM, VMapP, &
        normal_fn, Fscale, Escale, int(Ne,c_int) )
      istat = cudaGetLastError()
      if (istat /= cudaSuccess) call cuda_failure( &
        "tendency_fused_p7_tc_kernel",istat)
    case (16)
      call launch_tendency_fused_p15_tc( &
        dqdt, D1D, Lift1D, q, u, v, w, VMapM, VMapP, &
        normal_fn, Fscale, Escale, int(Ne,c_int) )
      istat = cudaGetLastError()
      if (istat /= cudaSuccess) call cuda_failure( &
        "tendency_fused_p15_tc_kernel",istat)
    case default
      ! Nq = 32.  The x and z volume terms and all six face lifts run first,
      ! then the y term is accumulated on top, as on the CUDA-core path.
      call launch_tendency_fused_p31_tc( &
        dqdt, D1D, Lift1D, q, u, v, w, VMapM, VMapP, &
        normal_fn, Fscale, Escale, int(Ne,c_int) )
      istat = cudaGetLastError()
      if (istat /= cudaSuccess) call cuda_failure( &
        "tendency_fused_p31_tc kernels",istat)
    end select
    call dg_ev_record(2)
    call dg_ev_end(DG_EV_SINGLE)

    kernel_time(1) = dg_kernel_time(1)
    kernel_time(2) = dg_kernel_time(2)
  end subroutine cuda_cal_dqdt_fused_tc

  !> p=63 tensor-core fused tendency.  Same three-kernel shape as
  !! cuda_cal_dqdt_fused_p63; only the two volume kernels differ.
  subroutine cuda_cal_dqdt_fused_p63_tc( &
    dqdt, q, u, v, w, D1D, Lift1D, VMapM, VMapP, &
    normal_fn, Fscale, Escale, flux_bnd, &
    Nq, Np, NfpTot, Ne, NeA, kernel_time )
    implicit none
    integer, intent(in) :: Nq, Np, NfpTot, Ne, NeA
    real(RP), device, intent(out) :: dqdt(Np,NeA)
    real(RP), device, intent(in) :: q(Np,NeA)
    real(RP), device, intent(in) :: u(Np,NeA), v(Np,NeA), w(Np,NeA)
    real(RP), device, intent(in) :: D1D(Nq,Nq)
    real(RP), device, intent(in) :: Lift1D(Nq,6)
    integer, device, intent(in) :: VMapM(NfpTot,Ne)
    integer, device, intent(in) :: VMapP(NfpTot,Ne)
    real(RP), device, intent(in) :: normal_fn(NfpTot,Ne,3)
    real(RP), device, intent(in) :: Fscale(NfpTot,Ne)
    real(RP), device, intent(in) :: Escale(Np,Ne,3)
    real(RP), device, intent(out) :: flux_bnd(NfpTot,Ne)
    real(RP), intent(out) :: kernel_time(2)

    integer :: istat, nface, nblock_face

    if (Nq /= CUDA_FUSED_P63_NQ .or. Np /= CUDA_FUSED_P63_NQ**3) then
      error stop "cuda_cal_dqdt_fused_p63_tc requires PolyOrder=63"
    end if
    call dg_ev_begin()

    nface = NfpTot*Ne
    nblock_face = (nface+CUDA_BLOCK_SIZE-1)/CUDA_BLOCK_SIZE

    call dg_ev_record(1)
    call elembnd_flux_kernel<<<nblock_face,CUDA_BLOCK_SIZE,0,dg_stream>>>( &
      flux_bnd, q, u, v, w, VMapM, VMapP, normal_fn, Fscale, nface, 0 )
    istat = cudaGetLastError()
    if (istat /= cudaSuccess) call cuda_failure("elembnd_flux_kernel",istat)
    call launch_tendency_fused_p63_tc( &
      dqdt, D1D, Lift1D, q, u, v, w, flux_bnd, Escale, int(Ne,c_int) )
    istat = cudaGetLastError()
    if (istat /= cudaSuccess) call cuda_failure( &
      "tendency_fused_p63_tc kernels",istat)
    call dg_ev_record(2)
    call dg_ev_end(DG_EV_SINGLE)

    kernel_time(1) = dg_kernel_time(1)
    kernel_time(2) = dg_kernel_time(2)
  end subroutine cuda_cal_dqdt_fused_p63_tc


  !> p=127 tensor-core fused tendency.  Same three-kernel shape as
  !! cuda_cal_dqdt_fused_p127; only the two volume kernels differ.
  subroutine cuda_cal_dqdt_fused_p127_tc( &
    dqdt, q, u, v, w, D1D, Lift1D, VMapM, VMapP, &
    normal_fn, Fscale, Escale, flux_bnd, &
    Nq, Np, NfpTot, Ne, NeA, kernel_time )
    implicit none
    integer, intent(in) :: Nq, Np, NfpTot, Ne, NeA
    real(RP), device, intent(out) :: dqdt(Np,NeA)
    real(RP), device, intent(in) :: q(Np,NeA)
    real(RP), device, intent(in) :: u(Np,NeA), v(Np,NeA), w(Np,NeA)
    real(RP), device, intent(in) :: D1D(Nq,Nq)
    real(RP), device, intent(in) :: Lift1D(Nq,6)
    integer, device, intent(in) :: VMapM(NfpTot,Ne)
    integer, device, intent(in) :: VMapP(NfpTot,Ne)
    real(RP), device, intent(in) :: normal_fn(NfpTot,Ne,3)
    real(RP), device, intent(in) :: Fscale(NfpTot,Ne)
    real(RP), device, intent(in) :: Escale(Np,Ne,3)
    real(RP), device, intent(out) :: flux_bnd(NfpTot,Ne)
    real(RP), intent(out) :: kernel_time(2)

    integer :: istat, nface, nblock_face

    if (Nq /= CUDA_FUSED_P127_NQ .or. Np /= CUDA_FUSED_P127_NQ**3) then
      error stop "cuda_cal_dqdt_fused_p127_tc requires PolyOrder=127"
    end if
    call dg_ev_begin()

    nface = NfpTot*Ne
    nblock_face = (nface+CUDA_BLOCK_SIZE-1)/CUDA_BLOCK_SIZE

    call dg_ev_record(1)
    call elembnd_flux_kernel<<<nblock_face,CUDA_BLOCK_SIZE,0,dg_stream>>>( &
      flux_bnd, q, u, v, w, VMapM, VMapP, normal_fn, Fscale, nface, 0 )
    istat = cudaGetLastError()
    if (istat /= cudaSuccess) call cuda_failure("elembnd_flux_kernel",istat)
    call launch_tendency_fused_p127_tc( &
      dqdt, D1D, Lift1D, q, u, v, w, flux_bnd, Escale, int(Ne,c_int) )
    istat = cudaGetLastError()
    if (istat /= cudaSuccess) call cuda_failure( &
      "tendency_fused_p127_tc kernels",istat)
    call dg_ev_record(2)
    call dg_ev_end(DG_EV_SINGLE)

    kernel_time(1) = dg_kernel_time(1)
    kernel_time(2) = dg_kernel_time(2)
  end subroutine cuda_cal_dqdt_fused_p127_tc

  subroutine cuda_cal_dqdt_fused_p255_tc( &
    dqdt, q, u, v, w, D1D, Lift1D, VMapM, VMapP, &
    normal_fn, Fscale, Escale, flux_bnd, &
    Nq, Np, NfpTot, Ne, NeA, kernel_time )
    implicit none
    integer, intent(in) :: Nq, Np, NfpTot, Ne, NeA
    real(RP), device, intent(out) :: dqdt(Np,NeA)
    real(RP), device, intent(in) :: q(Np,NeA)
    real(RP), device, intent(in) :: u(Np,NeA), v(Np,NeA), w(Np,NeA)
    real(RP), device, intent(in) :: D1D(Nq,Nq)
    real(RP), device, intent(in) :: Lift1D(Nq,6)
    integer, device, intent(in) :: VMapM(NfpTot,Ne)
    integer, device, intent(in) :: VMapP(NfpTot,Ne)
    real(RP), device, intent(in) :: normal_fn(NfpTot,Ne,3)
    real(RP), device, intent(in) :: Fscale(NfpTot,Ne)
    real(RP), device, intent(in) :: Escale(Np,Ne,3)
    real(RP), device, intent(out) :: flux_bnd(NfpTot,Ne)
    real(RP), intent(out) :: kernel_time(2)

    integer :: istat, nface, nblock_face

    if (Nq /= CUDA_P255_NQ .or. Np /= CUDA_P255_NQ**3) then
      error stop "cuda_cal_dqdt_fused_p255_tc requires PolyOrder=255"
    end if
    call dg_ev_begin()

    nface = NfpTot*Ne
    nblock_face = (nface+CUDA_BLOCK_SIZE-1)/CUDA_BLOCK_SIZE

    call dg_ev_record(1)
    call elembnd_flux_kernel<<<nblock_face,CUDA_BLOCK_SIZE,0,dg_stream>>>( &
      flux_bnd, q, u, v, w, VMapM, VMapP, normal_fn, Fscale, nface, 0 )
    call launch_tendency_xyz_p255_tc( &
      dqdt, q, u, v, w, D1D, Lift1D, flux_bnd, Escale, int(Ne,c_int) )
    istat = cudaGetLastError()
    if (istat /= cudaSuccess) call cuda_failure("p=255 TC tendency kernels",istat)
    call dg_ev_record(2)
    call dg_ev_end(DG_EV_SINGLE)

    kernel_time(1) = dg_kernel_time(1)
    kernel_time(2) = dg_kernel_time(2)
  end subroutine cuda_cal_dqdt_fused_p255_tc

  !> Select the MMA instruction shape of the CUTLASS volume GEMMs.
  !!
  !! 0 = SM80 8x8x4 (the default), 1 = SM90 16x8x4, 2 = SM90 16x8x8,
  !! 3 = SM90 16x8x16. The
  !! matching kernels are all instantiated in cuda_cutlass_gemm_fused.cu, so
  !! this only picks which one is launched.
  subroutine cuda_cutlass_set_mma_shape(shape_id)
    implicit none
    integer, intent(in) :: shape_id

    if (shape_id < 0 .or. shape_id > 3) then
      write(*,*) "cuda_cutlass_set_mma_shape: unsupported shape id ", shape_id
      error stop
    end if
    cutlass_mma_shape_id = int(shape_id, c_int)
  end subroutine cuda_cutlass_set_mma_shape

  subroutine cuda_gemm_setup(emulate)
    implicit none
    logical, intent(in) :: emulate
    integer :: istat
    integer(c_int) :: emulate_flag

    emulate_flag = 0
    if (emulate) emulate_flag = 1
    istat = cublas_gemm_init(emulate_flag)
    if (istat /= 0) call cuda_failure("cublas_gemm_init",istat)
    gemm_inited = .true.
  end subroutine cuda_gemm_setup

  subroutine cuda_gemm_finalize()
    implicit none
    integer :: istat

    if (gemm_inited) then
      istat = cublas_gemm_finalize()
      if (istat /= 0) call cuda_failure("cublas_gemm_finalize",istat)
      gemm_inited = .false.
    end if
  end subroutine cuda_gemm_finalize

  subroutine cuda_cal_dqdt_gemm( &
    dqdt, q, u, v, w, D1D, D1D_tr, Lift1D, VMapM, VMapP, &
    normal_fn, Fscale, Escale, flux_bnd, &
    flux_x, flux_y, flux_z, deriv_x, deriv_y, deriv_z, lift_out, &
    Nq, Np, NfpTot, Ne, NeA, kernel_time )
    implicit none
    integer, intent(in) :: Nq, Np, NfpTot, Ne, NeA
    real(RP), device, intent(out) :: dqdt(Np,NeA)
    real(RP), device, intent(in) :: q(Np,NeA)
    real(RP), device, intent(in) :: u(Np,NeA), v(Np,NeA), w(Np,NeA)
    real(RP), device, intent(in) :: D1D(Nq,Nq), D1D_tr(Nq,Nq)
    real(RP), device, intent(in) :: Lift1D(Nq,6)
    integer, device, intent(in) :: VMapM(NfpTot,Ne), VMapP(NfpTot,Ne)
    real(RP), device, intent(in) :: normal_fn(NfpTot,Ne,3)
    real(RP), device, intent(in) :: Fscale(NfpTot,Ne)
    real(RP), device, intent(in) :: Escale(Np,Ne,3)
    real(RP), device, intent(out) :: flux_bnd(NfpTot,Ne)
    real(RP), device, intent(out) :: flux_x(Np,Ne), flux_y(Np,Ne), flux_z(Np,Ne)
    real(RP), device, intent(out) :: deriv_x(Np,Ne), deriv_y(Np,Ne), deriv_z(Np,Ne)
    real(RP), device, intent(out) :: lift_out(Np,Ne)
    real(RP), intent(out) :: kernel_time(2)

    integer :: istat, nface, npoint, nblock, nblock_face
    integer :: nq2, plane_batch
    integer(c_long_long) :: stride_plane, stride_elem, stride_zero, stride_vol
    logical :: use_side

    if (.not. gemm_inited) then
      call cuda_gemm_setup(.false.)
    end if

    call dg_ev_begin()

    nq2 = Nq*Nq
    nface = NfpTot*Ne
    npoint = Np*Ne
    nblock = (npoint+CUDA_BLOCK_SIZE-1)/CUDA_BLOCK_SIZE
    nblock_face = (nface+CUDA_BLOCK_SIZE-1)/CUDA_BLOCK_SIZE
    plane_batch = Nq*Ne
    stride_plane = int(nq2,c_long_long)
    stride_elem = int(NfpTot,c_long_long)
    stride_zero = 0_c_long_long
    stride_vol = int(Np,c_long_long)

    call dg_ev_record(1)

    ! flux_bnd is not read until the lift, so the boundary flux can run on the
    ! second stream underneath the volume GEMMs.  See cuda_cal_dqdt_gemm_fused.
    ! At p=7 it must not: there the boundary flux is 181 us while the volume
    ! GEMMs are 24 launches of 8x8 matrices, so it is far larger than the
    ! window it would hide in and overlapping the two loses 3.1%.
    ! The window is wide enough from Nq=64 on: measured at p=7 (loss), p=63
    ! (-1.4% on Main) and p=255 (-1.3%, overall_summary_report.md 8.7).
    use_side = dg_side_enabled .and. (Nq >= 64)

    if (.not. use_side) then
      call elembnd_flux_kernel<<<nblock_face,CUDA_BLOCK_SIZE,0,dg_stream>>>( &
        flux_bnd, q, u, v, w, VMapM, VMapP, normal_fn, Fscale, nface, 0 )
    end if

    call launch_volume_flux( &
      flux_x, flux_y, flux_z, q, u, v, w, npoint )

    if (use_side) then
      call dg_side_fork()
      call elembnd_flux_kernel<<<nblock_face,CUDA_BLOCK_SIZE,0,dg_side_stream>>>( &
        flux_bnd, q, u, v, w, VMapM, VMapP, normal_fn, Fscale, nface, 0 )
    end if

    istat = cublas_dgemm_impl(0, 0, Nq, nq2*Ne, Nq, 1.0_c_double, &
      D1D, Nq, flux_x, Nq, 0.0_c_double, deriv_x, Nq)
    if (istat /= 0) call cuda_failure("cublasDgemm x-deriv",istat)

    istat = cublas_dgemm_strided_batched_impl(0, 0, Nq, Nq, Nq, 1.0_c_double, &
      flux_y, Nq, stride_plane, D1D_tr, Nq, stride_zero, 0.0_c_double, &
      deriv_y, Nq, stride_plane, plane_batch)
    if (istat /= 0) call cuda_failure("cublasDgemm y-deriv",istat)

    istat = cublas_dgemm_strided_batched_impl(0, 0, nq2, Nq, Nq, 1.0_c_double, &
      flux_z, nq2, stride_vol, D1D_tr, Nq, stride_zero, 0.0_c_double, &
      deriv_z, nq2, stride_vol, Ne)
    if (istat /= 0) call cuda_failure("cublasDgemm z-deriv",istat)

    if (use_side) call dg_side_join()

    call separable_lift_assembly_kernel<<<nblock,CUDA_BLOCK_SIZE,0,dg_stream>>>( &
      dqdt, Escale, deriv_x, deriv_y, deriv_z, flux_bnd, Lift1D, &
      Nq, Np, npoint )

    istat = cudaGetLastError()
    if (istat /= cudaSuccess) call cuda_failure("CUDAFORTRAN_GEMM kernels",istat)
    call dg_ev_record(2)
    call dg_ev_end(DG_EV_SINGLE)

    kernel_time(1) = dg_kernel_time(1)
    kernel_time(2) = dg_kernel_time(2)
  end subroutine cuda_cal_dqdt_gemm

  subroutine cuda_ozaki2_init(moduli_count)
    implicit none
    integer, intent(in) :: moduli_count
    integer :: istat

    istat = ozaki2_init(moduli_count)
    if (istat /= 0) call cuda_failure("ozaki2_init", istat)

    return
  end subroutine cuda_ozaki2_init

  subroutine cuda_ozaki2_alloc_workspace(Nq, Ne, Np)
    implicit none
    integer, intent(in) :: Nq, Ne, Np
    integer :: istat

    istat = ozaki2_alloc_workspace(Nq, Ne, Np)
    if (istat /= 0) call cuda_failure("ozaki2_alloc_workspace", istat)

    return
  end subroutine cuda_ozaki2_alloc_workspace

