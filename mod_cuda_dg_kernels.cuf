    function cublas_dgemm_impl(transa, transb, m, n, k, alpha, A, lda, B, ldb, &
      beta, C, ldc) bind(C, name="cublas_dgemm_impl")
      import
      integer(c_int), value :: transa, transb, m, n, k, lda, ldb, ldc
      real(c_double), value :: alpha, beta
      real(c_double), device :: A(*), B(*), C(*)
      integer(c_int) :: cublas_dgemm_impl
    end function cublas_dgemm_impl

    function cublas_dgemm_strided_batched_impl(transa, transb, m, n, k, alpha, &
      A, lda, strideA, B, ldb, strideB, beta, C, ldc, strideC, batch) &
      bind(C, name="cublas_dgemm_strided_batched_impl")
      import
      integer(c_int), value :: transa, transb, m, n, k, lda, ldb, ldc, batch
      integer(c_long_long), value :: strideA, strideB, strideC
      real(c_double), value :: alpha, beta
      real(c_double), device :: A(*), B(*), C(*)
      integer(c_int) :: cublas_dgemm_strided_batched_impl
    end function cublas_dgemm_strided_batched_impl

    !- The fused-path x and y GEMMs apply Escale in their own epilogues, so
    !- deriv_x and deriv_y come back as Escale_x*Dx and Escale_y*Dy and the z
    !- epilogue reads three volume tensors instead of five.  See
    !- cuda_cutlass_gemm_fused.cu and reports/p255_gap_study.md.
    function ozaki2_init(moduli_count, fixed_mantissa) bind(C, name="ozaki2_init")
      import
      integer(c_int), value :: moduli_count, fixed_mantissa
      integer(c_int) :: ozaki2_init
    end function ozaki2_init

