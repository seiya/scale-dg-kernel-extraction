  subroutine cuda_cal_dqdt_fused_p255_dfma( &
    dqdt, q, u, v, w, D1D, Lift1D, VMapM, VMapP, &
    normal_fn, Fscale, Escale, flux_bnd, &
    Nq, Np, NfpTot, Ne, NeA, kernel_time )
    implicit none
    integer, intent(in) :: Nq, Np, NfpTot, Ne, NeA
    real(RP), device, intent(out) :: dqdt(Np,Ne)
    real(RP), device, intent(in) :: q(Np,NeA)
    real(RP), device, intent(in) :: u(Np,NeA), v(Np,NeA), w(Np,NeA)
    real(RP), device, intent(in) :: D1D(Nq,Nq)
    real(RP), device, intent(in) :: Lift1D(Nq,6)
    integer, device, intent(in) :: VMapM(NfpTot,Ne)
    integer, device, intent(in) :: VMapP(NfpTot,Ne)
    real(RP), device, intent(in) :: normal_fn(NfpTot,Ne,3)
    real(RP), device, intent(in) :: Fscale(NfpTot,Ne)
    real(RP), device, intent(in) :: Escale(Np,Ne,3)
    real(RP), device, intent(out) :: flux_bnd(NfpTot,Ne)
    real(RP), intent(out) :: kernel_time(2)

    integer :: istat, nface, nq2, nblock_rest
    integer(kind=cuda_stream_kind) :: s_rest
    logical :: use_side

    if ((Nq /= CUDA_P255_NQ .and. Nq /= CUDA_P511_NQ) .or. Np /= Nq**3) then
      error stop "cuda_cal_dqdt_fused_p255_dfma requires PolyOrder=255 or 511"
    end if
    call dg_ev_begin()

    nface = NfpTot*Ne
    nq2 = Nq*Nq
    nblock_rest = (4*nq2*Ne+CUDA_BLOCK_SIZE-1)/CUDA_BLOCK_SIZE
    use_side = dg_side_enabled

    call dg_ev_record(1)
    if (use_side) then
      call dg_side_fork(.false.)
      s_rest = dg_side_stream
    else
      s_rest = dg_stream
    end if
    call launch_tendency_dir_p255_dfma( &
      0, dqdt, q, u, v, w, D1D, Lift1D, flux_bnd, Escale, &
      VMapM, VMapP, normal_fn, Fscale, int(Ne,c_int), int(Nq,c_int) )
    call elembnd_flux_group_kernel<<<nblock_rest,CUDA_BLOCK_SIZE,0,s_rest>>>( &
      flux_bnd, q, u, v, w, VMapM, VMapP, normal_fn, Fscale, nface, nq2, 1 )
    if (use_side) call dg_side_join(.false.)
    call launch_tendency_dir_p255_dfma( &
      1, dqdt, q, u, v, w, D1D, Lift1D, flux_bnd, Escale, &
      VMapM, VMapP, normal_fn, Fscale, int(Ne,c_int), int(Nq,c_int) )
    call launch_tendency_dir_p255_dfma( &
      2, dqdt, q, u, v, w, D1D, Lift1D, flux_bnd, Escale, &
      VMapM, VMapP, normal_fn, Fscale, int(Ne,c_int), int(Nq,c_int) )
    istat = cudaGetLastError()
    if (istat /= cudaSuccess) call cuda_failure("p=255 DFMA tendency kernels",istat)
    call dg_ev_record(2)
    call dg_ev_end(DG_EV_SINGLE)

    kernel_time(1) = dg_kernel_time(1)
    kernel_time(2) = dg_kernel_time(2)
  end subroutine cuda_cal_dqdt_fused_p255_dfma

  subroutine cuda_cal_dqdt_fused_tc( &
    dqdt, q, u, v, w, D1D, Lift1D, VMapM, VMapP, &
    normal_fn, Fscale, Escale, &
    Nq, Np, NfpTot, Ne, NeA, kernel_time )
    implicit none
    integer, intent(in) :: Nq, Np, NfpTot, Ne, NeA
    real(RP), device, intent(out) :: dqdt(Np,Ne)
    real(RP), device, intent(in) :: q(Np,NeA)
    real(RP), device, intent(in) :: u(Np,NeA), v(Np,NeA), w(Np,NeA)
    real(RP), device, intent(in) :: D1D(Nq,Nq)
    real(RP), device, intent(in) :: Lift1D(Nq,6)
    integer, device, intent(in) :: VMapM(NfpTot,Ne)
    integer, device, intent(in) :: VMapP(NfpTot,Ne)
    real(RP), device, intent(in) :: normal_fn(NfpTot,Ne,3)
    real(RP), device, intent(in) :: Fscale(NfpTot,Ne)
    real(RP), device, intent(in) :: Escale(Np,Ne,3)
    real(RP), intent(out) :: kernel_time(2)

    integer :: istat

    if (Nq /= 8 .and. Nq /= 16 .and. Nq /= CUDA_FUSED_P31_NQ) then
      write(*,*) "CUDAFORTRAN_FUSED_TC currently requires PolyOrder=7, 15 or 31"
      error stop
    end if
    call dg_ev_begin()

    call dg_ev_record(1)
    select case (Nq)
    case (8)
      call launch_tendency_fused_p7_tc( &
        dqdt, D1D, Lift1D, q, u, v, w, VMapM, VMapP, &
        normal_fn, Fscale, Escale, int(Ne,c_int) )
      istat = cudaGetLastError()
      if (istat /= cudaSuccess) call cuda_failure( &
        "tendency_fused_p7_tc_kernel",istat)
    case (16)
      call launch_tendency_fused_p15_tc( &
        dqdt, D1D, Lift1D, q, u, v, w, VMapM, VMapP, &
        normal_fn, Fscale, Escale, int(Ne,c_int) )
      istat = cudaGetLastError()
      if (istat /= cudaSuccess) call cuda_failure( &
        "tendency_fused_p15_tc_kernel",istat)
    case default
      ! Nq = 32.  The x and z volume terms and all six face lifts run first,
      ! then the y term is accumulated on top, as on the CUDA-core path.
      call launch_tendency_fused_p31_tc( &
        dqdt, D1D, Lift1D, q, u, v, w, VMapM, VMapP, &
        normal_fn, Fscale, Escale, int(Ne,c_int) )
      istat = cudaGetLastError()
      if (istat /= cudaSuccess) call cuda_failure( &
        "tendency_fused_p31_tc kernels",istat)
    end select
    call dg_ev_record(2)
    call dg_ev_end(DG_EV_SINGLE)

    kernel_time(1) = dg_kernel_time(1)
    kernel_time(2) = dg_kernel_time(2)
  end subroutine cuda_cal_dqdt_fused_tc

  !> p=63 tensor-core fused tendency.  Same three-kernel shape as
  !! cuda_cal_dqdt_fused_p63; only the two volume kernels differ.
  subroutine cuda_cal_dqdt_fused_p63_tc( &
    dqdt, q, u, v, w, D1D, Lift1D, VMapM, VMapP, &
    normal_fn, Fscale, Escale, flux_bnd, &
    Nq, Np, NfpTot, Ne, NeA, kernel_time )
    implicit none
    integer, intent(in) :: Nq, Np, NfpTot, Ne, NeA
    real(RP), device, intent(out) :: dqdt(Np,Ne)
    real(RP), device, intent(in) :: q(Np,NeA)
    real(RP), device, intent(in) :: u(Np,NeA), v(Np,NeA), w(Np,NeA)
    real(RP), device, intent(in) :: D1D(Nq,Nq)
    real(RP), device, intent(in) :: Lift1D(Nq,6)
    integer, device, intent(in) :: VMapM(NfpTot,Ne)
    integer, device, intent(in) :: VMapP(NfpTot,Ne)
    real(RP), device, intent(in) :: normal_fn(NfpTot,Ne,3)
    real(RP), device, intent(in) :: Fscale(NfpTot,Ne)
    real(RP), device, intent(in) :: Escale(Np,Ne,3)
    real(RP), device, intent(out) :: flux_bnd(NfpTot,Ne)
    real(RP), intent(out) :: kernel_time(2)

    integer :: istat, nface

    if (Nq /= CUDA_FUSED_P63_NQ .or. Np /= CUDA_FUSED_P63_NQ**3) then
      error stop "cuda_cal_dqdt_fused_p63_tc requires PolyOrder=63"
    end if
    call dg_ev_begin()

    nface = NfpTot*Ne

    call dg_ev_record(1)
    call launch_tendency_fused_p63_tc( &
      dqdt, D1D, Lift1D, q, u, v, w, flux_bnd, Escale, &
      VMapM, VMapP, normal_fn, Fscale, int(nface,c_int), int(Ne,c_int) )
    istat = cudaGetLastError()
    if (istat /= cudaSuccess) call cuda_failure( &
      "tendency_fused_p63_tc kernels",istat)
    call dg_ev_record(2)
    call dg_ev_end(DG_EV_SINGLE)

    kernel_time(1) = dg_kernel_time(1)
    kernel_time(2) = dg_kernel_time(2)
  end subroutine cuda_cal_dqdt_fused_p63_tc


  !> p=127 tensor-core fused tendency.  Same three-kernel shape as
  !! cuda_cal_dqdt_fused_p127; only the two volume kernels differ.
  subroutine cuda_cal_dqdt_fused_p127_tc( &
    dqdt, q, u, v, w, D1D, Lift1D, VMapM, VMapP, &
    normal_fn, Fscale, Escale, flux_bnd, &
    Nq, Np, NfpTot, Ne, NeA, kernel_time )
    implicit none
    integer, intent(in) :: Nq, Np, NfpTot, Ne, NeA
    real(RP), device, intent(out) :: dqdt(Np,NeA)
    real(RP), device, intent(in) :: q(Np,NeA)
    real(RP), device, intent(in) :: u(Np,NeA), v(Np,NeA), w(Np,NeA)
    real(RP), device, intent(in) :: D1D(Nq,Nq)
    real(RP), device, intent(in) :: Lift1D(Nq,6)
    integer, device, intent(in) :: VMapM(NfpTot,Ne)
    integer, device, intent(in) :: VMapP(NfpTot,Ne)
    real(RP), device, intent(in) :: normal_fn(NfpTot,Ne,3)
    real(RP), device, intent(in) :: Fscale(NfpTot,Ne)
    real(RP), device, intent(in) :: Escale(Np,Ne,3)
    real(RP), device, intent(out) :: flux_bnd(NfpTot,Ne)
    real(RP), intent(out) :: kernel_time(2)

    integer :: istat, nface

    if (Nq /= CUDA_FUSED_P127_NQ .or. Np /= CUDA_FUSED_P127_NQ**3) then
      error stop "cuda_cal_dqdt_fused_p127_tc requires PolyOrder=127"
    end if
    call dg_ev_begin()

    nface = NfpTot*Ne

    call dg_ev_record(1)
    call launch_tendency_fused_p127_tc( &
      dqdt, D1D, Lift1D, q, u, v, w, flux_bnd, Escale, &
      VMapM, VMapP, normal_fn, Fscale, int(nface,c_int), int(Ne,c_int) )
    istat = cudaGetLastError()
    if (istat /= cudaSuccess) call cuda_failure( &
      "tendency_fused_p127_tc kernels",istat)
    call dg_ev_record(2)
    call dg_ev_end(DG_EV_SINGLE)

    kernel_time(1) = dg_kernel_time(1)
    kernel_time(2) = dg_kernel_time(2)
  end subroutine cuda_cal_dqdt_fused_p127_tc

  subroutine cuda_cal_dqdt_fused_p255_tc( &
    dqdt, q, u, v, w, D1D, Lift1D, VMapM, VMapP, &
    normal_fn, Fscale, Escale, flux_bnd, &
    Nq, Np, NfpTot, Ne, NeA, kernel_time )
    implicit none
    integer, intent(in) :: Nq, Np, NfpTot, Ne, NeA
    real(RP), device, intent(out) :: dqdt(Np,Ne)
    real(RP), device, intent(in) :: q(Np,NeA)
    real(RP), device, intent(in) :: u(Np,NeA), v(Np,NeA), w(Np,NeA)
    real(RP), device, intent(in) :: D1D(Nq,Nq)
    real(RP), device, intent(in) :: Lift1D(Nq,6)
    integer, device, intent(in) :: VMapM(NfpTot,Ne)
    integer, device, intent(in) :: VMapP(NfpTot,Ne)
    real(RP), device, intent(in) :: normal_fn(NfpTot,Ne,3)
    real(RP), device, intent(in) :: Fscale(NfpTot,Ne)
    real(RP), device, intent(in) :: Escale(Np,Ne,3)
    real(RP), device, intent(out) :: flux_bnd(NfpTot,Ne)
    real(RP), intent(out) :: kernel_time(2)

    integer :: istat, nface, nq2, nblock_rest
    integer(kind=cuda_stream_kind) :: s_rest
    logical :: use_side

    if ((Nq /= CUDA_P255_NQ .and. Nq /= CUDA_P511_NQ) .or. Np /= Nq**3) then
      error stop "cuda_cal_dqdt_fused_p255_tc requires PolyOrder=255 or 511"
    end if
    call dg_ev_begin()

    nface = NfpTot*Ne
    nq2 = Nq*Nq
    nblock_rest = (4*nq2*Ne+CUDA_BLOCK_SIZE-1)/CUDA_BLOCK_SIZE
    use_side = dg_side_enabled

    call dg_ev_record(1)
    if (use_side) then
      call dg_side_fork(.false.)
      s_rest = dg_side_stream
    else
      s_rest = dg_stream
    end if
    call launch_tendency_dir_p255_tc( &
      0, dqdt, q, u, v, w, D1D, Lift1D, flux_bnd, Escale, &
      VMapM, VMapP, normal_fn, Fscale, int(Ne,c_int), int(Nq,c_int) )
    call elembnd_flux_group_kernel<<<nblock_rest,CUDA_BLOCK_SIZE,0,s_rest>>>( &
      flux_bnd, q, u, v, w, VMapM, VMapP, normal_fn, Fscale, nface, nq2, 1 )
    if (use_side) call dg_side_join(.false.)
    call launch_tendency_dir_p255_tc( &
      1, dqdt, q, u, v, w, D1D, Lift1D, flux_bnd, Escale, &
      VMapM, VMapP, normal_fn, Fscale, int(Ne,c_int), int(Nq,c_int) )
    call launch_tendency_dir_p255_tc( &
      2, dqdt, q, u, v, w, D1D, Lift1D, flux_bnd, Escale, &
      VMapM, VMapP, normal_fn, Fscale, int(Ne,c_int), int(Nq,c_int) )
    istat = cudaGetLastError()
    if (istat /= cudaSuccess) call cuda_failure("p=255 TC tendency kernels",istat)
    call dg_ev_record(2)
    call dg_ev_end(DG_EV_SINGLE)

    kernel_time(1) = dg_kernel_time(1)
    kernel_time(2) = dg_kernel_time(2)
  end subroutine cuda_cal_dqdt_fused_p255_tc

  !> Select the MMA instruction shape of the CUTLASS volume GEMMs.
  !!
  !! 0 = SM80 8x8x4 (the default), 1 = SM90 16x8x4, 2 = SM90 16x8x8,
  !! 3 = SM90 16x8x16. The
  !! matching kernels are all instantiated in cuda_cutlass_gemm_fused.cu, so
  !! this only picks which one is launched.
  subroutine cuda_cutlass_set_mma_shape(shape_id)
    implicit none
    integer, intent(in) :: shape_id

    if (shape_id < 0 .or. shape_id > 3) then
      write(*,*) "cuda_cutlass_set_mma_shape: unsupported shape id ", shape_id
      error stop
    end if
    cutlass_mma_shape_id = int(shape_id, c_int)
  end subroutine cuda_cutlass_set_mma_shape

  ! Read an integer environment variable once and cache it.  `slot` is -2
  ! before the first read; `fallback` is what an unset or unparsable value
  ! means.
  integer function dg_env_int(name, slot, fallback)
    implicit none
    character(len=*), intent(in) :: name
    integer, intent(inout) :: slot
    integer, intent(in) :: fallback
    character(len=32) :: envval
    integer :: envlen, envstat, val

    if (slot == -2) then
      slot = fallback
      call get_environment_variable(name, envval, envlen, envstat)
      if (envstat == 0 .and. len_trim(envval) > 0) then
        read(envval,*,iostat=envstat) val
        if (envstat == 0) slot = val
      end if
    end if
    dg_env_int = slot
  end function dg_env_int

  ! The adopted per-order configuration, as a pure table.  No environment
  ! access: this is exactly what "no SCALE_DG_* set" means.  See the block at
  ! the top of the module for what each field is and what it was measured to
  ! be worth.
  subroutine dg_gemm_defaults(Nq, plan)
    implicit none
    integer, intent(in) :: Nq
    type(dg_gemm_plan_t), intent(out) :: plan

    select case (Nq)
    case (8)    !- p=7   x CUTLASS tile 9 and carrier (16-byte epilogue and
                !-        clamp aggregation), y cuBLAS, z CUTLASS, y||z
      plan = dg_gemm_plan_t(x_mode=1, x_tile=9, y_lib=1, carrier=2, &
                            z_lib=0, ysched=1, xfwd=0, xpkg=5, z_tile=-1, zpkg=-1)
    case (16)   !- p=15  x CUTLASS tile 5 and carrier (16-byte epilogue),
                !-        y CUTLASS, z CUTLASS, y||z
      plan = dg_gemm_plan_t(x_mode=1, x_tile=5, y_lib=0, carrier=2, &
                            z_lib=0, ysched=1, xfwd=0, xpkg=4, z_tile=-1, zpkg=-1)
    case (32)   !- p=31  x CUTLASS tile 7 and carrier (16-byte epilogue),
                !-        y CUTLASS, z cuBLAS, y||z
      plan = dg_gemm_plan_t(x_mode=1, x_tile=7, y_lib=0, carrier=2, &
                            z_lib=1, ysched=1, xfwd=0, xpkg=4, z_tile=-1, zpkg=-1)
    case (64)   !- p=63  x CUTLASS tile 3, y CUTLASS, z carrier with the
                !-        16-byte epilogue and clamp aggregation but NOT the
                !-        16-byte lift, z CUTLASS
      plan = dg_gemm_plan_t(x_mode=1, x_tile=3, y_lib=0, carrier=0, &
                            z_lib=0, ysched=0, xfwd=0, xpkg=0, z_tile=-1, zpkg=5)
    case (128, 256)
                !- p=127 / p=255: the z carrier stays (x carrier +6.4% / +3.6%,
                !-        y carrier +7.1% / +7.6%).  x tile 0 is the generic
                !-        64x128 mainloop both paths already ran; naming it here
                !-        only gives GEMM_CUTE's x epilogue the accumulator pad
                !-        GEMM_FUSED's x already had.
      plan = dg_gemm_plan_t(x_mode=1, x_tile=0, y_lib=0, carrier=0, &
                            z_lib=0, ysched=0, xfwd=0, xpkg=0, z_tile=-1, zpkg=-1)
    case default
      !- Nq > 256: generic CUTLASS x through launch_volume_gemm_x / _xy, and
      !- everything else as it has always been.  Untouched by the sweep.
      plan = dg_gemm_plan_t(x_mode=0, x_tile=0, y_lib=0, carrier=0, &
                            z_lib=0, ysched=0, xfwd=0, xpkg=0, z_tile=-1, zpkg=-1)
    end select
  end subroutine dg_gemm_defaults

  ! Resolve one launch: the static table, then the environment overrides,
  ! then the legality clamps.  This is the only place that reads any
  ! SCALE_DG_* configuration variable, so an unset environment can never
  ! reach a different assignment than dg_gemm_defaults states.
  subroutine dg_gemm_plan(Nq, fuse_epilogue, plan)
    implicit none
    integer, intent(in) :: Nq
    logical, intent(in) :: fuse_epilogue
    type(dg_gemm_plan_t), intent(out) :: plan
    integer :: ov

    call dg_gemm_defaults(Nq, plan)

    ov = dg_env_int("SCALE_DG_XCUTLASS", x_mode_env, -1)
    if (ov >= 0) plan%x_mode = ov
    ov = dg_env_int("SCALE_DG_XTILE", x_tile_env, -1)
    if (ov >= 0) plan%x_tile = ov
    ov = dg_env_int("SCALE_DG_YCUBLAS", y_cublas_env, -1)
    if (ov >= 0) plan%y_lib = ov
    ov = dg_env_int("SCALE_DG_ZCUBLAS", zcublas_env, -1)
    if (ov >= 0) plan%z_lib = ov
    ov = dg_env_int("SCALE_DG_CARRIER", carrier_env, -1)
    if (ov >= 0) plan%carrier = ov
    ov = dg_env_int("SCALE_DG_YSCHED", ysched_env, -1)
    if (ov >= 0) plan%ysched = ov
    ov = dg_env_int("SCALE_DG_XFWD", xfwd_env, -1)
    if (ov >= 0) plan%xfwd = ov
    ov = dg_env_int("SCALE_DG_XPKG", x_pkg_env, -1)
    if (ov >= 0) plan%xpkg = ov
    ov = dg_env_int("SCALE_DG_ZTILE", z_tile_env, -1)
    if (ov >= 0) plan%z_tile = ov
    ov = dg_env_int("SCALE_DG_ZPKG", z_pkg_env, -1)
    if (ov >= 0) plan%zpkg = ov

    !- Legality clamps.  They apply to the table and to an override alike.
    !- Only the four swept orders have a CUTLASS x tile list; Nq > 64 takes
    !- launch_volume_gemm_x / _xy and never gets here.
    if (Nq /= 8 .and. Nq /= 16 .and. Nq /= 32 .and. Nq /= 64 .and. &
        Nq /= 128 .and. Nq /= 256) plan%x_mode = 0
    !- Escale_x forwarding belongs to GEMM_FUSED's fusion package and needs
    !- the partially weighted assembly epilogue, which only the Nq = 8, 16 and
    !- 32 carriers instantiate.  At Nq = 64 the y GEMM already applies
    !- Escale_x, so there is nothing left for x to forward.  GEMM_CUTE demotes
    !- 2 -> 1 (and its ablation twin 4 -> 3) so both paths keep one library
    !- assignment and one mainloop tile.
    !- At Nq >= 64 with z carrying, the y GEMM already applies Escale_x, so
    !- there is nothing left for x to forward.  A y carrier at Nq > 64 is the
    !- one case above 64 where forwarding Escale_x into x IS meaningful.
    if (plan%x_mode == 2 .and. (.not. fuse_epilogue .or. &
        (Nq >= 64 .and. plan%carrier /= 1))) plan%x_mode = 1
    if (plan%x_mode == 4 .and. (.not. fuse_epilogue .or. &
        (Nq >= 64 .and. plan%carrier /= 1))) plan%x_mode = 3
    !- Only GEMM_FUSED has a carrier at all, and only Nq = 16 and 32 have a y
    !- assembly kernel.
    if (.not. fuse_epilogue) plan%carrier = 0
    if (plan%carrier == 1 .and. Nq /= 8 .and. Nq /= 16 .and. Nq /= 32 .and. &
        Nq /= 128 .and. Nq /= 256) plan%carrier = 0
    !- The x carrier needs the order's adopted CUTLASS x tile, which is also
    !- the only one launch_x_gemm_assembly instantiates, and it needs x on
    !- CUTLASS at all.  Escale_x forwarding into x is meaningless with x as the
    !- carrier (the carrier applies every weight itself), so mode 2 collapses
    !- to mode 1 there.
    if (plan%carrier == 2) then
      if (Nq /= 8 .and. Nq /= 16 .and. Nq /= 32 .and. Nq /= 64 .and. &
          Nq /= 128 .and. Nq /= 256) plan%carrier = 0
      if (plan%x_mode == 0) plan%carrier = 0
    end if
    if (plan%carrier == 2 .and. plan%x_mode == 2) plan%x_mode = 1
    if (plan%carrier == 2 .and. plan%x_mode == 4) plan%x_mode = 3
    !- Escale forwarding into the non-carriers exists only for the x carrier,
    !- and only for a non-carrier that is CUTLASS (cuBLAS has no epilogue).
    if (plan%carrier /= 2) plan%xfwd = 0
    !- The epilogue package is an x-carrier-only epilogue change.
    if (plan%carrier /= 2) plan%xpkg = 0
    !- The z-carrier package override exists only for the z carrier, and only
    !- at the two orders launch_z_gemm_assembly instantiates it for.
    if (plan%carrier /= 0 .or. .not. fuse_epilogue) plan%zpkg = -1
    if (Nq /= 16 .and. Nq /= 64) plan%zpkg = -1

    !- Bit 2 is the row-index-arithmetic ablation and is never cleared here,
    !- and neither is bit 3, which the block below validates on its own.
    if (plan%y_lib /= 0) plan%xfwd = iand(plan%xfwd, 14)
    if (plan%z_lib /= 0) plan%xfwd = iand(plan%xfwd, 13)
    !- Bit 3 folds Escale_y*Dy into the z GEMM's epilogue so the carrier reads
    !- one volume tensor.  It is instantiated at Nq = 64 on tile 3 only, it
    !- needs both other Escale factors forwarded (the folded tensor carries
    !- them), it needs a CUTLASS z to fold into, and it needs y to run before
    !- z, which rules out the y-beside-z schedule.
    if (iand(plan%xfwd, 8) /= 0) then
      if (Nq /= 64 .or. plan%x_tile /= 3 .or. plan%z_lib /= 0 .or. &
          plan%y_lib /= 0) then
        plan%xfwd = iand(plan%xfwd, 7)
      else
        plan%xfwd = ior(plan%xfwd, 3)
        plan%ysched = 0
      end if
    end if
    !- Nq = 64 x carrier: the folded instantiation (xfwd bit 3) and the
    !- occupancy-floor one (xpkg bits 3-4) are built without kPaired, and
    !- xpkg bit 1 does not only pick a kernel -- it also switches the face
    !- layout elembnd_flux_kernel WRITES.  Leaving it set there would hand an
    !- interleaved face array to a kernel that reads the plain one, which is
    !- silently wrong (4.7e-13 relative, not roundoff).  Clear it.
    if (plan%carrier == 2 .and. Nq == 64 .and. &
        (iand(plan%xfwd, 8) /= 0 .or. iand(plan%xpkg, 24) /= 0)) then
      plan%xpkg = ibclr(plan%xpkg, 1)
    end if

  end subroutine dg_gemm_plan

  ! Shared z mainloop for the paths where z is a plain GEMM: GEMM_CUTE always,
  ! and GEMM_FUSED when the carrier is y.  Keeping the library choice in the
  ! plan keeps the two paths on one assignment, as AGENTS.md requires.
  subroutine launch_volume_gemm_z_common(plan, deriv_z, flux_z, D1D_tr, &
    escale_z, Nq, Np, Ne, istat)
    implicit none
    type(dg_gemm_plan_t), intent(in) :: plan
    integer, intent(in) :: Nq, Np, Ne
    real(RP), device, intent(out) :: deriv_z(*)
    real(RP), device, intent(in) :: flux_z(*), D1D_tr(*), escale_z(*)
    integer, intent(out) :: istat

    if (dg_env_int("SCALE_DG_ZSKIP", zskip_env, 0) /= 0) then
      ! Ablation only: skip the z volume GEMM.  Numerically wrong on purpose.
      istat = 0
    else if (iand(plan%xfwd, 2) /= 0) then
      ! x carrier only: Escale_z folded into this GEMM's own epilogue.  Same
      ! tile, warps and stage count as the plain CUTLASS z above.
      istat = launch_volume_gemm_z_scaled(deriv_z, flux_z, D1D_tr, escale_z, &
        Nq, Ne, cutlass_mma_shape_id)
    else if (plan%z_lib == 1) then
      istat = cublas_dgemm_strided_batched_impl(0, 0, Nq*Nq, Nq, Nq, &
        1.0_c_double, flux_z, Nq*Nq, int(Np,c_long_long), D1D_tr, Nq, &
        0_c_long_long, 0.0_c_double, deriv_z, Nq*Nq, int(Np,c_long_long), Ne)
    else
      istat = launch_volume_gemm_z(deriv_z, flux_z, D1D_tr, Nq, Ne, &
        cutlass_mma_shape_id, plan%z_tile)
    end if
  end subroutine launch_volume_gemm_z_common

  ! Shared y mainloop for GEMM_CUTE and GEMM_FUSED.  Keeping this call in one
  ! place prevents the two comparison paths from silently diverging.
  subroutine launch_volume_gemm_y_common(plan, deriv_y, flux_y, D1D_tr, &
    escale_y, Nq, Ne, istat)
    implicit none
    type(dg_gemm_plan_t), intent(in) :: plan
    integer, intent(in) :: Nq, Ne
    real(RP), device, intent(out) :: deriv_y(*)
    real(RP), device, intent(in) :: flux_y(*), D1D_tr(*), escale_y(*)
    integer, intent(out) :: istat

    if (plan%y_lib == 2) then
      ! Ablation only (SCALE_DG_YCUBLAS=2): skip the y volume GEMM entirely so
      ! its cost can be read off the stage time.  Numerically wrong on purpose.
      istat = 0
    else if (iand(plan%xfwd, 1) /= 0) then
      ! x carrier only: Escale_y folded into this GEMM's own epilogue.  Same
      ! tile, warps and stage count as the plain CUTLASS y below.
      istat = launch_volume_gemm_y_scaled(deriv_y, flux_y, D1D_tr, escale_y, &
        Nq, Ne, cutlass_mma_shape_id)
    else if (plan%y_lib == 1) then
      istat = cublas_dgemm_strided_batched_impl(0, 0, Nq, Nq, Nq, 1.0_c_double, &
        flux_y, Nq, int(Nq*Nq,c_long_long), D1D_tr, Nq, 0_c_long_long, &
        0.0_c_double, deriv_y, Nq, int(Nq*Nq,c_long_long), Nq*Ne)
    else
      istat = launch_volume_gemm_y(deriv_y, flux_y, D1D_tr, Nq, Ne, &
        cutlass_mma_shape_id)
    end if
  end subroutine launch_volume_gemm_y_common

  ! Shared x mainloop for GEMM_CUTE and GEMM_FUSED.  Keeping this call in one
  ! place prevents the two comparison paths from silently diverging: the
  ! library and the tile come from the plan, and only the Escale_x weighting
  ! (plan%x_mode == 2, already demoted for GEMM_CUTE) is path-specific, and it
  ! changes the epilogue output op, not the mainloop.
  subroutine launch_volume_gemm_x_common(plan, deriv_x, flux_x, D1D, Escale, &
    Nq, Np, Ne, istat)
    implicit none
    type(dg_gemm_plan_t), intent(in) :: plan
    integer, intent(in) :: Nq, Np, Ne
    real(RP), device, intent(out) :: deriv_x(*)
    real(RP), device, intent(in) :: flux_x(*), D1D(*), Escale(*)
    integer, intent(out) :: istat

    select case (plan%x_mode)
    case (3, 4)
      ! Ablation only (SCALE_DG_XCUTLASS=3 / 4): skip the x volume GEMM so its
      ! cost can be read off the stage time.  Numerically wrong on purpose.
      ! Mode 4 additionally leaves the assembly epilogue in its partially
      ! weighted form, which is what separates the x cost from the saving.
      istat = 0
    case (1)
      istat = launch_volume_gemm_x_tiled(deriv_x, flux_x, D1D, Escale, 0, &
        Nq, Ne, plan%x_tile)
    case (2)
      istat = launch_volume_gemm_x_tiled(deriv_x, flux_x, D1D, Escale, 1, &
        Nq, Ne, plan%x_tile)
    case default
      istat = cublas_dgemm_impl(0, 0, Nq, (Np/Nq)*Ne, Nq, 1.0_c_double, &
        D1D, Nq, flux_x, Nq, 0.0_c_double, deriv_x, Nq)
    end select
  end subroutine launch_volume_gemm_x_common

  subroutine cuda_gemm_setup(emulate, mantissa_fixed, mantissa_bits)
    implicit none
    logical, intent(in) :: emulate
    logical, intent(in), optional :: mantissa_fixed
    integer, intent(in), optional :: mantissa_bits
    integer :: istat
    integer(c_int) :: emulate_flag, fixed_flag, bits_flag

    emulate_flag = 0
    if (emulate) emulate_flag = 1
    fixed_flag = 1
    if (present(mantissa_fixed)) then
      fixed_flag = 0
      if (mantissa_fixed) fixed_flag = 1
    end if
    bits_flag = 55
    if (present(mantissa_bits)) bits_flag = int(mantissa_bits, c_int)
    istat = cublas_gemm_init(emulate_flag, fixed_flag, bits_flag)
    if (istat /= 0) call cuda_failure("cublas_gemm_init",istat)
    gemm_emulation_on = emulate
    gemm_inited = .true.
  end subroutine cuda_gemm_setup

  subroutine cuda_gemm_finalize()
    implicit none
    integer :: istat

    if (gemm_inited) then
      istat = cublas_gemm_finalize()
      if (istat /= 0) call cuda_failure("cublas_gemm_finalize",istat)
      gemm_inited = .false.
    end if
  end subroutine cuda_gemm_finalize

  ! Volume derivatives only.  z is stored in dqdt (beta=0); assembly overwrites
  ! that buffer.  Ozaki backends share this layout with cuBLAS native GEMM.
  ! gvol_par: how many of the three volume GEMMs run on their own stream.
  !   0  all three on dg_stream (the schedule every measurement before
  !      2026-09-03 used)
  !   1  y beside x on dg_side2_stream, z after the join -- the analogue of
  !      GEMM_FUSED's overlap_y
  !   2  y on dg_side2_stream and z on dg_side_stream, i.e. all three
  !      concurrent.  Only legal when side_free says the face flux is not
  !      already occupying dg_side_stream.
  ! Only the cuBLAS backend takes it.  OZAKI1 / OZAKI2 keep the serial
  ! schedule because their launchers are not stream reentrant: they share one
  ! device workspace per call site and synchronize dg_cuda_stream internally,
  ! so two concurrent calls would race on the split / packing buffers.  That
  ! is a property of those implementations, not a scheduling choice.
  subroutine gemm_volume_xyz(backend, Nq, Ne, nq2, plane_batch, &
    stride_plane, stride_zero, stride_vol, D1D, D1D_tr, &
    flux_x, flux_y, flux_z, deriv_x, deriv_y, dqdt, gvol_par, side_free)
    implicit none
    integer, intent(in) :: backend, Nq, Ne, nq2, plane_batch
    integer(c_long_long), intent(in) :: stride_plane, stride_zero, stride_vol
    real(RP), device, intent(in) :: D1D(*), D1D_tr(*)
    real(RP), device, intent(in) :: flux_x(*), flux_y(*), flux_z(*)
    real(RP), device, intent(out) :: deriv_x(*), deriv_y(*), dqdt(*)
    integer, intent(in) :: gvol_par
    logical, intent(in) :: side_free
    integer :: istat
    integer :: par
    logical :: zpar

    par = gvol_par
    if (backend /= GEMM_VOL_CUBLAS) par = 0
    if (gemm_emulation_on) par = 0
    zpar = (par >= 2) .and. side_free

    select case (backend)
    case (GEMM_VOL_CUBLAS)
      if (par >= 1) then
        call dg_side2_fork()
        call dg_set_cuda_stream(dg_side2_stream)
        istat = cublas_dgemm_strided_batched_impl(0, 0, Nq, Nq, Nq, 1.0_c_double, &
          flux_y, Nq, stride_plane, D1D_tr, Nq, stride_zero, 0.0_c_double, &
          deriv_y, Nq, stride_plane, plane_batch)
        if (istat /= 0) call cuda_failure("cublasDgemm y-deriv(side2)",istat)
        call dg_set_cuda_stream(dg_stream)
      end if
      if (zpar) then
        call dg_side1_fork()
        call dg_set_cuda_stream(dg_side_stream)
        istat = cublas_dgemm_strided_batched_impl(0, 0, nq2, Nq, Nq, 1.0_c_double, &
          flux_z, nq2, stride_vol, D1D_tr, Nq, stride_zero, 0.0_c_double, &
          dqdt, nq2, stride_vol, Ne)
        if (istat /= 0) call cuda_failure("cublasDgemm z-deriv(side1)",istat)
        call dg_set_cuda_stream(dg_stream)
      end if
      istat = cublas_dgemm_impl(0, 0, Nq, nq2*Ne, Nq, 1.0_c_double, &
        D1D, Nq, flux_x, Nq, 0.0_c_double, deriv_x, Nq)
      if (istat /= 0) call cuda_failure("cublasDgemm x-deriv",istat)
      if (par == 0) then
        istat = cublas_dgemm_strided_batched_impl(0, 0, Nq, Nq, Nq, 1.0_c_double, &
          flux_y, Nq, stride_plane, D1D_tr, Nq, stride_zero, 0.0_c_double, &
          deriv_y, Nq, stride_plane, plane_batch)
        if (istat /= 0) call cuda_failure("cublasDgemm y-deriv",istat)
      end if
      if (.not. zpar) then
        istat = cublas_dgemm_strided_batched_impl(0, 0, nq2, Nq, Nq, 1.0_c_double, &
          flux_z, nq2, stride_vol, D1D_tr, Nq, stride_zero, 0.0_c_double, &
          dqdt, nq2, stride_vol, Ne)
        if (istat /= 0) call cuda_failure("cublasDgemm z-deriv",istat)
      end if
      if (zpar) call dg_side1_join()
      if (par >= 1) call dg_side2_join()
    case (GEMM_VOL_OZAKI1)
      istat = ozaki1_dgemm(0, 0, Nq, nq2*Ne, Nq, D1D, Nq, flux_x, Nq, deriv_x, Nq)
      if (istat /= 0) call cuda_failure("ozaki1_dgemm x-deriv", istat)
      istat = ozaki1_dgemm_strided_batched(0, 0, Nq, Nq, Nq, &
        flux_y, Nq, stride_plane, D1D_tr, Nq, stride_zero, &
        deriv_y, Nq, stride_plane, plane_batch)
      if (istat /= 0) call cuda_failure("ozaki1_dgemm y-deriv", istat)
      istat = ozaki1_dgemm_strided_batched(0, 0, nq2, Nq, Nq, &
        flux_z, nq2, stride_vol, D1D_tr, Nq, stride_zero, &
        dqdt, nq2, stride_vol, Ne)
      if (istat /= 0) call cuda_failure("ozaki1_dgemm z-deriv", istat)
    case (GEMM_VOL_OZAKI2)
      istat = ozaki2_dgemm(0, 0, Nq, nq2*Ne, Nq, D1D, Nq, flux_x, Nq, deriv_x, Nq)
      if (istat /= 0) call cuda_failure("ozaki2_dgemm x-deriv", istat)
      istat = ozaki2_dgemm_strided_batched(0, 0, Nq, Nq, Nq, &
        flux_y, Nq, stride_plane, D1D_tr, Nq, stride_zero, &
        deriv_y, Nq, stride_plane, plane_batch)
      if (istat /= 0) call cuda_failure("ozaki2_dgemm y-deriv", istat)
      istat = ozaki2_dgemm_strided_batched(0, 0, nq2, Nq, Nq, &
        flux_z, nq2, stride_vol, D1D_tr, Nq, stride_zero, &
        dqdt, nq2, stride_vol, Ne)
      if (istat /= 0) call cuda_failure("ozaki2_dgemm z-deriv", istat)
    case default
      error stop "gemm_volume_xyz: unknown volume GEMM backend"
    end select
  end subroutine gemm_volume_xyz

  subroutine cuda_cal_dqdt_gemm_unfused( backend, &
    dqdt, q, u, v, w, D1D, D1D_tr, Lift1D, VMapM, VMapP, &
    normal_fn, Fscale, Escale, flux_bnd, &
    flux_x, flux_y, flux_z, deriv_x, deriv_y, &
    Nq, Np, NfpTot, Ne, NeA, kernel_time )
    implicit none
    integer, intent(in) :: backend
    integer, intent(in) :: Nq, Np, NfpTot, Ne, NeA
    real(RP), device, intent(out) :: dqdt(Np,Ne)
    real(RP), device, intent(in) :: q(Np,NeA)
    real(RP), device, intent(in) :: u(Np,NeA), v(Np,NeA), w(Np,NeA)
    real(RP), device, intent(in) :: D1D(Nq,Nq), D1D_tr(Nq,Nq)
    real(RP), device, intent(in) :: Lift1D(Nq,6)
    integer, device, intent(in) :: VMapM(NfpTot,Ne), VMapP(NfpTot,Ne)
    real(RP), device, intent(in) :: normal_fn(NfpTot,Ne,3)
    real(RP), device, intent(in) :: Fscale(NfpTot,Ne)
    real(RP), device, intent(in) :: Escale(Np,Ne,3)
    real(RP), device, intent(out) :: flux_bnd(NfpTot,Ne)
    real(RP), device, intent(out) :: flux_x(Np,Ne), flux_y(Np,Ne), flux_z(Np,Ne)
    real(RP), device, intent(out) :: deriv_x(Np,Ne), deriv_y(Np,Ne)
    real(RP), intent(out) :: kernel_time(2)

    integer :: istat, nface, npoint, nblock, nblock_face
    integer :: nq2, plane_batch
    integer(c_long_long) :: stride_plane, stride_elem, stride_zero, stride_vol
    logical :: use_side, face_fused
    integer :: fluxfuse

    if (.not. gemm_inited) then
      call cuda_gemm_setup(.false.)
    end if

    call dg_ev_begin()

    nq2 = Nq*Nq
    nface = NfpTot*Ne
    npoint = Np*Ne
    nblock = (npoint+CUDA_BLOCK_SIZE-1)/CUDA_BLOCK_SIZE
    nblock_face = (nface+CUDA_BLOCK_SIZE-1)/CUDA_BLOCK_SIZE
    plane_batch = Nq*Ne
    stride_plane = int(nq2,c_long_long)
    stride_elem = int(NfpTot,c_long_long)
    stride_zero = 0_c_long_long
    stride_vol = int(Np,c_long_long)

    call dg_ev_record(1)

    ! flux_bnd is not read until the lift, so the boundary flux can run on the
    ! second stream underneath the volume GEMMs.  See cuda_cal_dqdt_gemm_fused.
    ! At p=7 it must not: there the boundary flux is 181 us while the volume
    ! GEMMs are 24 launches of 8x8 matrices, so it is far larger than the
    ! window it would hide in and overlapping the two loses 3.1%.
    ! The window is wide enough from Nq=64 on: measured at p=7 (loss), p=63
    ! (-1.4% on Main) and p=255 (-1.3%, overall_summary_report.md 8.7).
    use_side = dg_side_enabled .and. (Nq >= 64)

    !- Fuse the two flux kernels into one launch (launch_flux_all).  Mode 1
    !- only where they would be serial on dg_stream anyway; mode 2 also takes
    !- the face flux off the side stream.
    fluxfuse = dg_flux_fuse()
    face_fused = (fluxfuse >= 1 .and. .not. use_side) .or. (fluxfuse >= 2)
    if (face_fused) use_side = .false.

    if (face_fused) then
      call launch_flux_all( &
        flux_x, flux_y, flux_z, flux_bnd, q, u, v, w, VMapM, VMapP, &
        normal_fn, Fscale, npoint, nface, 0 )
    else
      if (.not. use_side) then
        call elembnd_flux_kernel<<<nblock_face,CUDA_BLOCK_SIZE,0,dg_stream>>>( &
          flux_bnd, q, u, v, w, VMapM, VMapP, normal_fn, Fscale, nface, 0 )
      end if

      call launch_volume_flux( &
        flux_x, flux_y, flux_z, q, u, v, w, npoint )

      if (use_side) then
        call dg_side_fork(.false.)
        call elembnd_flux_kernel<<<nblock_face,CUDA_BLOCK_SIZE,0,dg_side_stream>>>( &
          flux_bnd, q, u, v, w, VMapM, VMapP, normal_fn, Fscale, nface, 0 )
      end if
    end if

    !- SCALE_DG_GVOLPAR: the three volume GEMMs are independent, so they can
    !- be spread over streams.  GEMM_FUSED has had overlap_y / overlap_xy /
    !- overlap_z since the carrier work; the unfused driver never did.
    !- 0 = the serial schedule; 1 = y beside x; 2 = all three.  Only the
    !- cuBLAS backend takes it, and only with FP64 emulation off
    !- (see gemm_volume_xyz).
    !-
    !- DEFAULT 2, adopted 2026-09-03 (Slurm job 78297, node c384, 12
    !- interleaved rounds, all 12/12 with disjoint ranges): mode 1 is
    !- -1.23 / -1.37 / -1.56 / -1.60 / -2.82 / -2.03 / -0.22% at
    !- p = 7 / 15 / 31 / 63 / 127 / 255 / 511.  Mode 2 differs from mode 1
    !- only where dg_side_stream is free, and there it is a wash except at
    !- Nq = 16, where it takes another -0.53% (12/12, disjoint).  It is never
    !- worse, so it is the default and degrades to mode 1 on its own when the
    !- face flux occupies the side stream (Nq >= 64).
    !- reports/gemm_assignment_and_carrier.md section 9.4.
    call gemm_volume_xyz(backend, Nq, Ne, nq2, plane_batch, &
      stride_plane, stride_zero, stride_vol, D1D, D1D_tr, &
      flux_x, flux_y, flux_z, deriv_x, deriv_y, dqdt, &
      dg_env_int("SCALE_DG_GVOLPAR", gvolpar_env, 2), .not. use_side)

    if (use_side) call dg_side_join(.false.)

    call separable_lift_assembly_kernel<<<nblock,CUDA_BLOCK_SIZE,0,dg_stream>>>( &
      dqdt, Escale(1,1,1), Escale(1,1,2), Escale(1,1,3), &
      deriv_x, deriv_y, dqdt, flux_bnd, Lift1D, &
      Nq, Np, npoint )

    istat = cudaGetLastError()
    if (istat /= cudaSuccess) then
      select case (backend)
      case (GEMM_VOL_OZAKI1)
        call cuda_failure("CUDAFORTRAN_GEMM_OZAKI1 kernels",istat)
      case (GEMM_VOL_OZAKI2)
        call cuda_failure("CUDAFORTRAN_GEMM_OZAKI2 kernels",istat)
      case default
        call cuda_failure("CUDAFORTRAN_GEMM kernels",istat)
      end select
    end if
    call dg_ev_record(2)
    call dg_ev_end(DG_EV_SINGLE)

    kernel_time(1) = dg_kernel_time(1)
    kernel_time(2) = dg_kernel_time(2)
  end subroutine cuda_cal_dqdt_gemm_unfused

  subroutine cuda_cal_dqdt_gemm( &
    dqdt, q, u, v, w, D1D, D1D_tr, Lift1D, VMapM, VMapP, &
    normal_fn, Fscale, Escale, flux_bnd, &
    flux_x, flux_y, flux_z, deriv_x, deriv_y, &
    Nq, Np, NfpTot, Ne, NeA, kernel_time )
    implicit none
    integer, intent(in) :: Nq, Np, NfpTot, Ne, NeA
    real(RP), device, intent(out) :: dqdt(Np,Ne)
    real(RP), device, intent(in) :: q(Np,NeA)
    real(RP), device, intent(in) :: u(Np,NeA), v(Np,NeA), w(Np,NeA)
    real(RP), device, intent(in) :: D1D(Nq,Nq), D1D_tr(Nq,Nq)
    real(RP), device, intent(in) :: Lift1D(Nq,6)
    integer, device, intent(in) :: VMapM(NfpTot,Ne), VMapP(NfpTot,Ne)
    real(RP), device, intent(in) :: normal_fn(NfpTot,Ne,3)
    real(RP), device, intent(in) :: Fscale(NfpTot,Ne)
    real(RP), device, intent(in) :: Escale(Np,Ne,3)
    real(RP), device, intent(out) :: flux_bnd(NfpTot,Ne)
    real(RP), device, intent(out) :: flux_x(Np,Ne), flux_y(Np,Ne), flux_z(Np,Ne)
    real(RP), device, intent(out) :: deriv_x(Np,Ne), deriv_y(Np,Ne)
    real(RP), intent(out) :: kernel_time(2)

    call cuda_cal_dqdt_gemm_unfused( GEMM_VOL_CUBLAS, &
      dqdt, q, u, v, w, D1D, D1D_tr, Lift1D, VMapM, VMapP, &
      normal_fn, Fscale, Escale, flux_bnd, &
      flux_x, flux_y, flux_z, deriv_x, deriv_y, &
      Nq, Np, NfpTot, Ne, NeA, kernel_time )
  end subroutine cuda_cal_dqdt_gemm

  subroutine cuda_ozaki2_init(moduli_count, fixed_mantissa)
    implicit none
    integer, intent(in) :: moduli_count
    logical, intent(in), optional :: fixed_mantissa
    integer :: istat
    integer(c_int) :: fixed_flag

    fixed_flag = 1
    if (present(fixed_mantissa)) then
      fixed_flag = 0
      if (fixed_mantissa) fixed_flag = 1
    end if
    istat = ozaki2_init(moduli_count, fixed_flag)
    if (istat /= 0) call cuda_failure("ozaki2_init", istat)

    return
  end subroutine cuda_ozaki2_init

  subroutine cuda_ozaki2_alloc_workspace(Nq, Ne, Np)
    implicit none
    integer, intent(in) :: Nq, Ne, Np
    integer :: istat

    istat = ozaki2_alloc_workspace(Nq, Ne, Np)
    if (istat /= 0) call cuda_failure("ozaki2_alloc_workspace", istat)

    return
  end subroutine cuda_ozaki2_alloc_workspace

  subroutine cuda_ozaki2_finalize()
    implicit none
    integer :: istat

    istat = ozaki2_finalize()
    if (istat /= 0) call cuda_failure("ozaki2_finalize", istat)

    return
  end subroutine cuda_ozaki2_finalize

  subroutine cuda_cal_dqdt_gemm_ozaki2( &
    dqdt, q, u, v, w, D1D, D1D_tr, Lift1D, VMapM, VMapP, &
    normal_fn, Fscale, Escale, flux_bnd, &
    flux_x, flux_y, flux_z, deriv_x, deriv_y, &
    Nq, Np, NfpTot, Ne, NeA, kernel_time )
    implicit none
    integer, intent(in) :: Nq, Np, NfpTot, Ne, NeA
    real(RP), device, intent(out) :: dqdt(Np,Ne)
    real(RP), device, intent(in) :: q(Np,NeA)
    real(RP), device, intent(in) :: u(Np,NeA), v(Np,NeA), w(Np,NeA)
    real(RP), device, intent(in) :: D1D(Nq,Nq), D1D_tr(Nq,Nq)
    real(RP), device, intent(in) :: Lift1D(Nq,6)
    integer, device, intent(in) :: VMapM(NfpTot,Ne), VMapP(NfpTot,Ne)
    real(RP), device, intent(in) :: normal_fn(NfpTot,Ne,3)
    real(RP), device, intent(in) :: Fscale(NfpTot,Ne)
    real(RP), device, intent(in) :: Escale(Np,Ne,3)
    real(RP), device, intent(out) :: flux_bnd(NfpTot,Ne)
    real(RP), device, intent(out) :: flux_x(Np,Ne), flux_y(Np,Ne), flux_z(Np,Ne)
    real(RP), device, intent(out) :: deriv_x(Np,Ne), deriv_y(Np,Ne)
    real(RP), intent(out) :: kernel_time(2)

    call cuda_cal_dqdt_gemm_unfused( GEMM_VOL_OZAKI2, &
      dqdt, q, u, v, w, D1D, D1D_tr, Lift1D, VMapM, VMapP, &
      normal_fn, Fscale, Escale, flux_bnd, &
      flux_x, flux_y, flux_z, deriv_x, deriv_y, &
      Nq, Np, NfpTot, Ne, NeA, kernel_time )
  end subroutine cuda_cal_dqdt_gemm_ozaki2

  subroutine cuda_ozaki1_init(slice_count, fixed_mantissa)
    implicit none
    integer, intent(in) :: slice_count
    logical, intent(in), optional :: fixed_mantissa
    integer :: istat
    integer(c_int) :: fixed_flag

    fixed_flag = 1
    if (present(fixed_mantissa)) then
      fixed_flag = 0
      if (fixed_mantissa) fixed_flag = 1
    end if
    istat = ozaki1_init(slice_count, fixed_flag)
    if (istat /= 0) call cuda_failure("ozaki1_init", istat)

    return
  end subroutine cuda_ozaki1_init

  subroutine cuda_ozaki1_alloc_workspace(Nq, Ne, Np)
    implicit none
    integer, intent(in) :: Nq, Ne, Np
    integer :: istat

    istat = ozaki1_alloc_workspace(Nq, Ne, Np)
    if (istat /= 0) call cuda_failure("ozaki1_alloc_workspace", istat)

    return
  end subroutine cuda_ozaki1_alloc_workspace

  subroutine cuda_ozaki1_finalize()
    implicit none
    integer :: istat

    istat = ozaki1_finalize()
    if (istat /= 0) call cuda_failure("ozaki1_finalize", istat)

    return
  end subroutine cuda_ozaki1_finalize

  subroutine cuda_ozaki1_slice_stats_set_enabled(enabled)
    implicit none
    integer, intent(in) :: enabled

    call ozaki1_slice_stats_set_enabled(enabled)

    return
  end subroutine cuda_ozaki1_slice_stats_set_enabled

  subroutine cuda_ozaki1_slice_stats_set_verbose(verbose)
    implicit none
    integer, intent(in) :: verbose

    call ozaki1_slice_stats_set_verbose(verbose)

    return
  end subroutine cuda_ozaki1_slice_stats_set_verbose

  subroutine cuda_ozaki1_slice_stats_begin_step()
    implicit none

    call ozaki1_slice_stats_begin_step()

    return
  end subroutine cuda_ozaki1_slice_stats_begin_step

  subroutine cuda_ozaki1_slice_stats_end_step()
    implicit none

    call ozaki1_slice_stats_end_step()

    return
  end subroutine cuda_ozaki1_slice_stats_end_step

  subroutine cuda_ozaki1_slice_stats_print()
    implicit none

    call ozaki1_slice_stats_print()

    return
  end subroutine cuda_ozaki1_slice_stats_print

  subroutine cuda_cal_dqdt_gemm_ozaki1( &
    dqdt, q, u, v, w, D1D, D1D_tr, Lift1D, VMapM, VMapP, &
    normal_fn, Fscale, Escale, flux_bnd, &
    flux_x, flux_y, flux_z, deriv_x, deriv_y, &
    Nq, Np, NfpTot, Ne, NeA, kernel_time )
    implicit none
    integer, intent(in) :: Nq, Np, NfpTot, Ne, NeA
    real(RP), device, intent(out) :: dqdt(Np,Ne)
    real(RP), device, intent(in) :: q(Np,NeA)
    real(RP), device, intent(in) :: u(Np,NeA), v(Np,NeA), w(Np,NeA)
    real(RP), device, intent(in) :: D1D(Nq,Nq), D1D_tr(Nq,Nq)
    real(RP), device, intent(in) :: Lift1D(Nq,6)
    integer, device, intent(in) :: VMapM(NfpTot,Ne), VMapP(NfpTot,Ne)
    real(RP), device, intent(in) :: normal_fn(NfpTot,Ne,3)
    real(RP), device, intent(in) :: Fscale(NfpTot,Ne)
    real(RP), device, intent(in) :: Escale(Np,Ne,3)
    real(RP), device, intent(out) :: flux_bnd(NfpTot,Ne)
    real(RP), device, intent(out) :: flux_x(Np,Ne), flux_y(Np,Ne), flux_z(Np,Ne)
    real(RP), device, intent(out) :: deriv_x(Np,Ne), deriv_y(Np,Ne)
    real(RP), intent(out) :: kernel_time(2)

    call cuda_cal_dqdt_gemm_unfused( GEMM_VOL_OZAKI1, &
      dqdt, q, u, v, w, D1D, D1D_tr, Lift1D, VMapM, VMapP, &
      normal_fn, Fscale, Escale, flux_bnd, &
      flux_x, flux_y, flux_z, deriv_x, deriv_y, &
      Nq, Np, NfpTot, Ne, NeA, kernel_time )
  end subroutine cuda_cal_dqdt_gemm_ozaki1

  subroutine cuda_cal_dqdt_gemm_cutlass(fuse_epilogue, &
    dqdt, q, u, v, w, D1D, D1D_tr, Lift1D, VMapM, VMapP, &
    normal_fn, Fscale, Escale, flux_bnd, &
    flux_x, flux_y, flux_z, deriv_x, deriv_y, &
    Nq, Np, NfpTot, Ne, NeA, kernel_time )
    implicit none
    logical, intent(in) :: fuse_epilogue
    integer, intent(in) :: Nq, Np, NfpTot, Ne, NeA
    real(RP), device, intent(out) :: dqdt(Np,Ne)
    real(RP), device, intent(in) :: q(Np,NeA)
    real(RP), device, intent(in) :: u(Np,NeA), v(Np,NeA), w(Np,NeA)
    real(RP), device, intent(in) :: D1D(Nq,Nq), D1D_tr(Nq,Nq)
    real(RP), device, intent(in) :: Lift1D(Nq,6)
    integer, device, intent(in) :: VMapM(NfpTot,Ne), VMapP(NfpTot,Ne)
    real(RP), device, intent(in) :: normal_fn(NfpTot,Ne,3)
    real(RP), device, intent(in) :: Fscale(NfpTot,Ne)
    real(RP), device, intent(in) :: Escale(Np,Ne,3)
    real(RP), device, intent(out) :: flux_bnd(NfpTot,Ne)
    real(RP), device, intent(out) :: flux_x(Np,Ne), flux_y(Np,Ne), flux_z(Np,Ne)
    real(RP), device, intent(out) :: deriv_x(Np,Ne), deriv_y(Np,Ne)
    real(RP), intent(out) :: kernel_time(2)

    integer :: istat, nface, npoint, nblock, nblock_face
    integer :: nq2, xy_weighted, pair_nq2
    integer :: carrier, ysched
    logical :: overlap_xy
    type(dg_gemm_plan_t) :: plan
    logical :: use_side, overlap_y, overlap_z, use_side2, p31_early_face
    logical :: face_fused
    integer :: fluxfuse
    integer :: cutepar
    logical :: cute_zpar

    ! y GEMM batches over Nq*Ne planes and CUTLASS puts the batch on grid.z
    ! (CUDA cap 65535).  cuda_cutlass_gemm_fused.cu splits that launch so
    ! p=7 Ne=32**3 and p=15 Ne=16**3 are valid; the tile types are unchanged.
    if (.not. gemm_inited) then
      call cuda_gemm_setup(.false.)
    end if

    call dg_ev_begin()

    nq2 = Nq*Nq
    p31_early_face = fuse_epilogue .and. (Nq == 32)
    ! Weighted z: Nq>64 (CUTLASS x/y scale) and Nq=64 (cuBLAS x plus y
    ! epilogue Ey*acc + Ex*Dx). Nq<64 stays unweighted; the fold is +2.3% at
    ! p=31 and +39% at p=7, where y is the dominant kernel and pays for the
    ! three extra volume tensors that z saves.
    xy_weighted = 0
    pair_nq2 = 0
    if (fuse_epilogue .and. Nq >= 64) xy_weighted = 1
    ! The whole volume-GEMM assignment for this order and path, resolved once:
    ! x library / tile / weighting, y library, which GEMM carries the fused
    ! assembly epilogue (0 = z, 1 = y), z library and the y-carrier schedule.
    ! See the table at the top of the module.
    call dg_gemm_plan(Nq, fuse_epilogue, plan)
    carrier = plan%carrier
    ysched = plan%ysched
    ! Partial forwarding: CUTLASS x can carry Escale_x while the y GEMM does
    ! not carry Escale_y, so the assembly epilogue reads four volume tensors
    ! instead of five.  The plan decides, so the epilogue and the x launch
    ! cannot disagree.
    if (fuse_epilogue .and. (plan%x_mode == 2 .or. plan%x_mode == 4)) &
      xy_weighted = 2
    ! Nq = 8 keeps the five-tensor z epilogue but does take the paired face
    ! layout: the three 16-byte lift loads are -2.4% there (p7_gemm_fused.md
    ! section 13).  Nq = 16, 32 and 64 lose from it.
    if (fuse_epilogue .and. (Nq >= 64 .or. Nq == 8)) pair_nq2 = nq2
    !- SCALE_DG_ZPKG selects the interleaved face layout explicitly.
    if (fuse_epilogue .and. plan%zpkg >= 0) then
      if (iand(plan%zpkg, 2) /= 0) then
        pair_nq2 = nq2
      else
        pair_nq2 = 0
      end if
    end if
    !- The y assembly epilogue does not read the interleaved face layout, so a
    !- y carrier must not get it.  The x carrier CAN read it -- it needs the
    !- same three pairs -- and does when SCALE_DG_XPKG bit 1 asks for the
    !- 16-byte lift.
    if (carrier == 1) pair_nq2 = 0
    if (carrier == 2) then
      if (iand(plan%xpkg, 2) /= 0) then
        pair_nq2 = nq2
        if (dg_lift_xpair_nq /= Nq) then
          if (allocated(dg_lift_xpair)) deallocate(dg_lift_xpair)
          allocate(dg_lift_xpair(6*Nq))
          call pack_lift_xpair_kernel<<<(Nq+CUDA_BLOCK_SIZE-1)/CUDA_BLOCK_SIZE, &
            CUDA_BLOCK_SIZE,0,dg_stream>>>( dg_lift_xpair, Lift1D, Nq )
          dg_lift_xpair_nq = Nq
        end if
      else
        pair_nq2 = 0
      end if
    end if
    if (pair_nq2 /= 0) then
      if (dg_lift_zpair_nq /= Nq) then
        if (allocated(dg_lift_zpair)) deallocate(dg_lift_zpair)
        allocate(dg_lift_zpair(2*Nq))
        call pack_lift_zpair_kernel<<<(Nq+CUDA_BLOCK_SIZE-1)/CUDA_BLOCK_SIZE, &
          CUDA_BLOCK_SIZE,0,dg_stream>>>( dg_lift_zpair, Lift1D, Nq )
        dg_lift_zpair_nq = Nq
      end if
    end if
    nface = NfpTot*Ne
    npoint = Np*Ne
    nblock = (npoint+CUDA_BLOCK_SIZE-1)/CUDA_BLOCK_SIZE
    nblock_face = (nface+CUDA_BLOCK_SIZE-1)/CUDA_BLOCK_SIZE

    ! Overlapping elembnd with the volume GEMMs loses at Nq<64 except for
    ! Nq=32 GEMM_FUSED, where starting it before volume_flux gives it an
    ! earlier finish and keeps the fused z behind the join (p31 section 23).
    ! A y carrier cannot start before z finishes, so the y-beside-x overlap
    ! is not available to it.  It gets the elembnd flux moved onto the side
    ! stream ahead of volume_flux instead -- the schedule Nq = 32 already uses
    ! -- and optionally z beside x on the second side stream (SCALE_DG_YSCHED).
    if (carrier >= 1) p31_early_face = .true.
    use_side = dg_side_enabled .and. &
      ((Nq >= 64) .or. p31_early_face)
    overlap_y = fuse_epilogue .and. dg_side_enabled .and. (Nq < 64) .and. &
      (carrier == 0)
    overlap_z = (carrier == 1) .and. dg_side_enabled .and. (ysched == 1)
    !- x carrier: y and z both precede the carrier, so the pair that can run
    !- concurrently is y beside z (SCALE_DG_YSCHED = 1), not y or z beside x.
    overlap_xy = (carrier == 2) .and. dg_side_enabled .and. (ysched == 1)
    use_side2 = overlap_y .or. overlap_z .or. overlap_xy

    call dg_ev_record(1)

    ! SCALE_DG_FSKIP: ablation only, skip the face flux launch (but not the
    ! stream fork) so its cost can be read off the stage time.  Numerically
    ! wrong on purpose.
    !- Fuse the two flux kernels into one launch (launch_flux_all), the same
    !- shared helper cuda_cal_dqdt_gemm_unfused uses, so GEMM / OZAKI1 /
    !- OZAKI2 / GEMM_CUTE / GEMM_FUSED all get it at once.  Mode 1 fuses only
    !- where the two would be serial on dg_stream anyway; mode 2 also takes
    !- the face flux off the side stream (giving that overlap up).  The FSKIP
    !- ablation prices the face flux by dropping its launch, which the fused
    !- form cannot express, so it turns fusion off.
    fluxfuse = dg_flux_fuse()
    face_fused = ((fluxfuse >= 1 .and. .not. use_side) .or. fluxfuse >= 2) &
      .and. dg_env_int("SCALE_DG_FSKIP", fskip_env, 0) == 0 &
      .and. dg_env_int("SCALE_DG_VSKIP", vskip_env, 0) == 0
    if (face_fused) then
      use_side = .false.
      p31_early_face = .false.
    end if

    if (face_fused) then
      call launch_flux_all( &
        flux_x, flux_y, flux_z, flux_bnd, q, u, v, w, VMapM, VMapP, &
        normal_fn, Fscale, npoint, nface, pair_nq2 )
    else
      if (.not. use_side) then
        if (dg_env_int("SCALE_DG_FSKIP", fskip_env, 0) == 0) then
          call elembnd_flux_kernel<<<nblock_face,CUDA_BLOCK_SIZE,0,dg_stream>>>( &
            flux_bnd, q, u, v, w, VMapM, VMapP, normal_fn, Fscale, nface, pair_nq2 )
        end if
      else if (p31_early_face) then
        call dg_side_fork(use_side2)
        if (dg_env_int("SCALE_DG_FSKIP", fskip_env, 0) == 0) then
          call elembnd_flux_kernel<<<nblock_face,CUDA_BLOCK_SIZE,0,dg_side_stream>>>( &
            flux_bnd, q, u, v, w, VMapM, VMapP, normal_fn, Fscale, nface, pair_nq2 )
        end if
      end if

      if (dg_env_int("SCALE_DG_VSKIP", vskip_env, 0) == 0) then
        call launch_volume_flux( &
          flux_x, flux_y, flux_z, q, u, v, w, npoint )
      end if
    end if

    call dg_ev_record(2)

    if ((use_side .or. use_side2) .and. .not. p31_early_face) then
      call dg_side_fork(use_side2)
      if (use_side .and. dg_env_int("SCALE_DG_FSKIP", fskip_env, 0) == 0) then
        call elembnd_flux_kernel<<<nblock_face,CUDA_BLOCK_SIZE,0,dg_side_stream>>>( &
          flux_bnd, q, u, v, w, VMapM, VMapP, normal_fn, Fscale, nface, pair_nq2 )
      end if
    end if

    if (fuse_epilogue .and. carrier == 2) then
      ! x carrier: y and z run first as plain GEMMs, optionally with their own
      ! Escale factor folded into their own epilogue (plan%xfwd).  deriv_x has
      ! no buffer of its own; the x GEMM now writes dqdt, so deriv_x is free
      ! and is reused as the deriv_z scratch.
      if (iand(plan%xfwd, 8) /= 0) then
        ! Ceiling measurement (SCALE_DG_XFWD bit 3, Nq = 64 only): the z GEMM's
        ! epilogue adds Escale_y*Dy to Escale_z*Dz, so the carrier reads one
        ! volume tensor instead of two.  y must therefore run BEFORE z, which
        ! is why dg_gemm_plan forces the serial schedule with this bit set.
        call launch_volume_gemm_y_common( plan, &
          deriv_y, flux_y, D1D_tr, Escale(1,1,2), Nq, Ne, istat )
        if (istat /= 0) call cuda_failure("launch_volume_gemm_y(fold)",istat)
        istat = launch_volume_gemm_z_scaleadd( deriv_x, flux_z, D1D_tr, &
          Escale(1,1,3), deriv_y, Nq, Ne, cutlass_mma_shape_id )
        if (istat /= 0) call cuda_failure("launch_volume_gemm_z_scaleadd",istat)
      else
      if (overlap_xy) then
        call dg_set_cuda_stream(dg_side2_stream)
        call launch_volume_gemm_y_common( plan, &
          deriv_y, flux_y, D1D_tr, Escale(1,1,2), Nq, Ne, istat )
        call dg_set_cuda_stream(dg_stream)
        if (istat /= 0) call cuda_failure("launch_volume_gemm_y(side2)",istat)
      end if
      call launch_volume_gemm_z_common( plan, &
        deriv_x, flux_z, D1D_tr, Escale(1,1,3), Nq, Np, Ne, istat )
      if (istat /= 0) call cuda_failure("launch_volume_gemm_z(x-carrier)",istat)
      if (.not. overlap_xy) then
        call launch_volume_gemm_y_common( plan, &
          deriv_y, flux_y, D1D_tr, Escale(1,1,2), Nq, Ne, istat )
        if (istat /= 0) call cuda_failure("launch_volume_gemm_y",istat)
      end if
      end if
    else if (fuse_epilogue .and. carrier == 1) then
      ! y carrier: x and z run first as plain unweighted GEMMs.  deriv_z has no
      ! buffer of its own; the deriv_y array is free because the y GEMM now
      ! writes dqdt, so it is reused as the deriv_z scratch.
      if (overlap_z) then
        call dg_set_cuda_stream(dg_side2_stream)
        call launch_volume_gemm_z_common( plan, &
          deriv_y, flux_z, D1D_tr, Escale(1,1,3), Nq, Np, Ne, istat )
        if (istat /= 0) call cuda_failure("launch_volume_gemm_z(side2)",istat)
        call dg_set_cuda_stream(dg_stream)
      end if
      call launch_volume_gemm_x_common( plan, &
        deriv_x, flux_x, D1D, Escale, Nq, Np, Ne, istat )
      if (istat /= 0) call cuda_failure("x-deriv (fused y-carrier)",istat)
      if (.not. overlap_z) then
        call launch_volume_gemm_z_common( plan, &
          deriv_y, flux_z, D1D_tr, Escale(1,1,3), Nq, Np, Ne, istat )
        if (istat /= 0) call cuda_failure("launch_volume_gemm_z",istat)
      end if
    else if (fuse_epilogue) then
      if (Nq <= 64) then
        if (Nq == 64) then
          ! y reads unweighted deriv_x, so it cannot run beside cuBLAS x.
          call launch_volume_gemm_x_common( plan, &
            deriv_x, flux_x, D1D, Escale, Nq, Np, Ne, istat )
          if (istat /= 0) call cuda_failure("x-deriv (fused)",istat)
          istat = launch_volume_gemm_y_scaleadd( &
            deriv_y, flux_y, D1D_tr, Escale(1,1,2), deriv_x, Escale(1,1,1), &
            Nq, Ne, cutlass_mma_shape_id )
          if (istat /= 0) call cuda_failure("launch_volume_gemm_y_scaleadd",istat)
        else
          if (overlap_y) then
            call dg_set_cuda_stream(dg_side2_stream)
            call launch_volume_gemm_y_common( plan, &
              deriv_y, flux_y, D1D_tr, Escale(1,1,2), Nq, Ne, istat )
            call dg_set_cuda_stream(dg_stream)
            if (istat /= 0) call cuda_failure("launch_volume_gemm_y(side2)",istat)
          end if
          call launch_volume_gemm_x_common( plan, &
            deriv_x, flux_x, D1D, Escale, Nq, Np, Ne, istat )
          if (istat /= 0) call cuda_failure("x-deriv (fused)",istat)
          if (.not. overlap_y) then
            call launch_volume_gemm_y_common( plan, &
              deriv_y, flux_y, D1D_tr, Escale(1,1,2), Nq, Ne, istat )
            if (istat /= 0) call cuda_failure("launch_volume_gemm_y",istat)
          end if
        end if
      else
        istat = launch_volume_gemm_xy( &
          deriv_x, deriv_y, flux_x, flux_y, D1D, D1D_tr, Escale, Nq, Ne, &
          cutlass_mma_shape_id )
        if (istat /= 0) call cuda_failure("launch_volume_gemm_xy",istat)
      end if
    else
      !- SCALE_DG_CUTEPAR: OUT-OF-ROLE ABLATION, DEFAULT 0 (off).  Not a
      !- production knob and not reachable from any DqdtKernel_Type; it exists
      !- only so the schedule axis can be measured on GEMM_CUTE.
      !-
      !- Without a fused epilogue the three volume GEMMs are independent, so
      !- all three can run concurrently -- the same fact SCALE_DG_GVOLPAR
      !- exploits on the unfused cuBLAS driver.  WITH a fused epilogue the
      !- carrier reads the other two derivatives elementwise (every carrier
      !- variant takes deriv_x and deriv_y: launch_{x,y,z}_gemm_assembly
      !- below), so the carrier depends on both and only the two non-carriers
      !- can overlap.  Fusion therefore REDUCES the overlap opportunity from
      !- three to two, whichever of x / y / z carries.
      !-
      !- 0 = the serial schedule (the shipped GEMM_CUTE); 1 = y beside x on
      !- side2; 2 = all three, z on side1 as well when the face flux is not
      !- already occupying it.  Measured in
      !- reports/gemm_assignment_and_carrier.md section 10.9.
      cutepar = dg_env_int("SCALE_DG_CUTEPAR", cutepar_env, 0)
      cute_zpar = (cutepar >= 2) .and. (.not. use_side)
      if (cutepar >= 1) then
        call dg_side2_fork()
        call dg_set_cuda_stream(dg_side2_stream)
        call launch_volume_gemm_y_common( plan, &
          deriv_y, flux_y, D1D_tr, Escale(1,1,2), Nq, Ne, istat )
        call dg_set_cuda_stream(dg_stream)
        if (istat /= 0) call cuda_failure("launch_volume_gemm_y(cutepar)",istat)
      end if
      if (cute_zpar) then
        call dg_side1_fork()
        call dg_set_cuda_stream(dg_side_stream)
        call launch_volume_gemm_z_common( plan, &
          dqdt, flux_z, D1D_tr, Escale(1,1,3), Nq, Np, Ne, istat )
        call dg_set_cuda_stream(dg_stream)
        if (istat /= 0) call cuda_failure("launch_volume_gemm_z(cutepar)",istat)
      end if
      !- Nq > 64 has no x tile list of its own unless the plan names one: with
      !- x_mode = 0 there it takes the generic launch_volume_gemm_x, which is
      !- the same 64x128 tile PHXTile0 spells out.  Whichever it is, GEMM_FUSED
      !- runs the identical mainloop.
      if (Nq <= 64 .or. plan%x_mode /= 0) then
        call launch_volume_gemm_x_common( plan, &
          deriv_x, flux_x, D1D, Escale, Nq, Np, Ne, istat )
        if (istat /= 0) call cuda_failure("x-deriv (cute)",istat)
      else
        istat = launch_volume_gemm_x( &
          deriv_x, flux_x, D1D, Nq, Ne, cutlass_mma_shape_id )
        if (istat /= 0) call cuda_failure("launch_volume_gemm_x",istat)
      end if
      if (cutepar == 0) then
        call launch_volume_gemm_y_common( plan, &
          deriv_y, flux_y, D1D_tr, Escale(1,1,2), Nq, Ne, istat )
        if (istat /= 0) call cuda_failure("launch_volume_gemm_y",istat)
      end if
      if (.not. cute_zpar) then
        call launch_volume_gemm_z_common( plan, &
          dqdt, flux_z, D1D_tr, Escale(1,1,3), Nq, Np, Ne, istat )
        if (istat /= 0) call cuda_failure("launch_volume_gemm_z",istat)
      end if
      if (cute_zpar) call dg_side1_join()
      if (cutepar >= 1) call dg_side2_join()
    end if
    call dg_ev_record(3)

    if (use_side .or. use_side2) call dg_side_join(use_side2)

    if (fuse_epilogue) call dg_ev_record(4)

    if (dg_env_int("SCALE_DG_CSKIP", cskip_env, 0) /= 0) then
      ! Ablation only: skip the fused carrier kernel entirely (GEMM_FUSED),
      ! or the separate separable_lift_assembly kernel that does the same
      ! work in GEMM_CUTE.  Numerically wrong on purpose; it prices the
      ! epilogue-carrying launch off the stage time on either path, which is
      ! what makes the two comparable.
      continue
    else if (fuse_epilogue .and. carrier == 2) then
      if (iand(plan%xpkg, 2) /= 0) then
        istat = launch_x_gemm_assembly( &
          dqdt, flux_x, D1D, deriv_y, deriv_x, flux_bnd, Lift1D, &
          dg_lift_xpair, Escale, Nq, Ne, cutlass_mma_shape_id, plan%x_tile, &
          plan%xfwd, plan%xpkg )
      else
        istat = launch_x_gemm_assembly( &
          dqdt, flux_x, D1D, deriv_y, deriv_x, flux_bnd, Lift1D, &
          Lift1D, Escale, Nq, Ne, cutlass_mma_shape_id, plan%x_tile, &
          plan%xfwd, plan%xpkg )
      end if
      if (istat /= 0) call cuda_failure("launch_x_gemm_assembly",istat)
    else if (fuse_epilogue .and. carrier == 1) then
      istat = launch_y_gemm_assembly( &
        dqdt, flux_y, D1D_tr, deriv_x, deriv_y, flux_bnd, Lift1D, &
        Escale, Nq, Ne, cutlass_mma_shape_id, xy_weighted )
      if (istat /= 0) call cuda_failure("launch_y_gemm_assembly",istat)
    else if (fuse_epilogue) then
      if (pair_nq2 /= 0) then
        istat = launch_z_gemm_assembly( &
          dqdt, flux_z, D1D_tr, deriv_x, deriv_y, flux_bnd, Lift1D, &
          dg_lift_zpair, Escale, Nq, Ne, cutlass_mma_shape_id, xy_weighted, &
          plan%zpkg )
        if (istat /= 0) call cuda_failure("launch_z_gemm_assembly",istat)
      else
        istat = launch_z_gemm_assembly( &
          dqdt, flux_z, D1D_tr, deriv_x, deriv_y, flux_bnd, Lift1D, &
          Lift1D, Escale, Nq, Ne, cutlass_mma_shape_id, xy_weighted, &
          plan%zpkg )
        if (istat /= 0) call cuda_failure("launch_z_gemm_assembly",istat)
      end if
    else
      call separable_lift_assembly_kernel<<<nblock,CUDA_BLOCK_SIZE,0,dg_stream>>>( &
        dqdt, Escale(1,1,1), Escale(1,1,2), Escale(1,1,3), &
        deriv_x, deriv_y, dqdt, flux_bnd, Lift1D, &
        Nq, Np, npoint )
    end if

    istat = cudaGetLastError()
    if (istat /= cudaSuccess) then
      if (fuse_epilogue) then
        call cuda_failure("CUDAFORTRAN_GEMM_FUSED kernels",istat)
      else
        call cuda_failure("CUDAFORTRAN_GEMM_CUTE kernels",istat)
      end if
    end if
    if (fuse_epilogue) then
      call dg_ev_record(5)
      call dg_ev_end(DG_EV_GEMM_FUSED)
    else
      call dg_ev_record(4)
      call dg_ev_end(DG_EV_CUTE)
    end if

    kernel_time(1) = dg_kernel_time(1)
    kernel_time(2) = dg_kernel_time(2)
  end subroutine cuda_cal_dqdt_gemm_cutlass

  subroutine cuda_cal_dqdt_gemm_cute( &
    dqdt, q, u, v, w, D1D, D1D_tr, Lift1D, VMapM, VMapP, &
    normal_fn, Fscale, Escale, flux_bnd, &
    flux_x, flux_y, flux_z, deriv_x, deriv_y, &
    Nq, Np, NfpTot, Ne, NeA, kernel_time )
    implicit none
    integer, intent(in) :: Nq, Np, NfpTot, Ne, NeA
    real(RP), device, intent(out) :: dqdt(Np,Ne)
    real(RP), device, intent(in) :: q(Np,NeA)
    real(RP), device, intent(in) :: u(Np,NeA), v(Np,NeA), w(Np,NeA)
    real(RP), device, intent(in) :: D1D(Nq,Nq), D1D_tr(Nq,Nq)
    real(RP), device, intent(in) :: Lift1D(Nq,6)
    integer, device, intent(in) :: VMapM(NfpTot,Ne), VMapP(NfpTot,Ne)
    real(RP), device, intent(in) :: normal_fn(NfpTot,Ne,3)
    real(RP), device, intent(in) :: Fscale(NfpTot,Ne)
    real(RP), device, intent(in) :: Escale(Np,Ne,3)
    real(RP), device, intent(out) :: flux_bnd(NfpTot,Ne)
    real(RP), device, intent(out) :: flux_x(Np,Ne), flux_y(Np,Ne), flux_z(Np,Ne)
    real(RP), device, intent(out) :: deriv_x(Np,Ne), deriv_y(Np,Ne)
    real(RP), intent(out) :: kernel_time(2)

    call cuda_cal_dqdt_gemm_cutlass(.false., &
      dqdt, q, u, v, w, D1D, D1D_tr, Lift1D, VMapM, VMapP, &
      normal_fn, Fscale, Escale, flux_bnd, &
      flux_x, flux_y, flux_z, deriv_x, deriv_y, &
      Nq, Np, NfpTot, Ne, NeA, kernel_time )
  end subroutine cuda_cal_dqdt_gemm_cute

  subroutine cuda_cal_dqdt_gemm_fused( &
    dqdt, q, u, v, w, D1D, D1D_tr, Lift1D, VMapM, VMapP, &
    normal_fn, Fscale, Escale, flux_bnd, &
    flux_x, flux_y, flux_z, deriv_x, deriv_y, &
    Nq, Np, NfpTot, Ne, NeA, kernel_time )
    implicit none
    integer, intent(in) :: Nq, Np, NfpTot, Ne, NeA
    real(RP), device, intent(out) :: dqdt(Np,Ne)
    real(RP), device, intent(in) :: q(Np,NeA)
    real(RP), device, intent(in) :: u(Np,NeA), v(Np,NeA), w(Np,NeA)
    real(RP), device, intent(in) :: D1D(Nq,Nq), D1D_tr(Nq,Nq)
    real(RP), device, intent(in) :: Lift1D(Nq,6)
    integer, device, intent(in) :: VMapM(NfpTot,Ne), VMapP(NfpTot,Ne)
    real(RP), device, intent(in) :: normal_fn(NfpTot,Ne,3)
    real(RP), device, intent(in) :: Fscale(NfpTot,Ne)
    real(RP), device, intent(in) :: Escale(Np,Ne,3)
    real(RP), device, intent(out) :: flux_bnd(NfpTot,Ne)
    real(RP), device, intent(out) :: flux_x(Np,Ne), flux_y(Np,Ne), flux_z(Np,Ne)
    real(RP), device, intent(out) :: deriv_x(Np,Ne), deriv_y(Np,Ne)
    real(RP), intent(out) :: kernel_time(2)

    call cuda_cal_dqdt_gemm_cutlass(.true., &
      dqdt, q, u, v, w, D1D, D1D_tr, Lift1D, VMapM, VMapP, &
      normal_fn, Fscale, Escale, flux_bnd, &
      flux_x, flux_y, flux_z, deriv_x, deriv_y, &
      Nq, Np, NfpTot, Ne, NeA, kernel_time )
  end subroutine cuda_cal_dqdt_gemm_fused


  subroutine cuda_cal_dqdt_split( &
    flux_x, flux_y, flux_z, deriv_x, deriv_y, deriv_z, lift_out, dqdt, &
    q, u, v, w, D1D, D1D_tr, Lift_mat, flux_bnd, Escale, &
    Nq, Np, NfpTot, Ne, NeA, kernel_time )
    implicit none
    integer, intent(in) :: Nq, Np, NfpTot, Ne, NeA
    real(RP), device, intent(out) :: flux_x(Np,Ne), flux_y(Np,Ne), flux_z(Np,Ne)
    real(RP), device, intent(out) :: deriv_x(Np,Ne), deriv_y(Np,Ne), deriv_z(Np,Ne)
    real(RP), device, intent(out) :: lift_out(Np,Ne), dqdt(Np,Ne)
    real(RP), device, intent(in) :: q(Np,NeA), u(Np,NeA), v(Np,NeA), w(Np,NeA)
    real(RP), device, intent(in) :: D1D(Nq,Nq), D1D_tr(Nq,Nq)
    real(RP), device, intent(in) :: Lift_mat(Nq,Nq,Nq,6), flux_bnd(NfpTot,Ne)
    real(RP), device, intent(in) :: Escale(Np,Ne,3)
    real(RP), intent(out) :: kernel_time(4)

    integer :: istat, npoint, nblock

    call dg_ev_begin()

    npoint = Np*Ne
    nblock = (npoint+CUDA_BLOCK_SIZE-1)/CUDA_BLOCK_SIZE
    call dg_ev_record(1)

    call launch_volume_flux( &
      flux_x, flux_y, flux_z, q, u, v, w, npoint )
    istat = cudaGetLastError()
    if (istat /= cudaSuccess) call cuda_failure("volume_flux_kernel",istat)
    call dg_ev_record(2)

    if (Nq == 8) then
      call volume_deriv_p7_kernel<<<Ne,CUDA_P7_BLOCK_SIZE,0,dg_stream>>>( &
        deriv_x, deriv_y, deriv_z, D1D, D1D_tr, flux_x, flux_y, flux_z, Ne )
    else
      call volume_deriv_kernel<<<nblock,CUDA_BLOCK_SIZE,0,dg_stream>>>( &
        deriv_x, deriv_y, deriv_z, D1D, D1D_tr, &
        flux_x, flux_y, flux_z, Nq, Np, npoint )
    end if
    istat = cudaGetLastError()
    if (istat /= cudaSuccess) call cuda_failure("volume_deriv_kernel",istat)
    call dg_ev_record(3)

    if (Nq == 8) then
      call surface_lift_p7_kernel<<<Ne,CUDA_P7_BLOCK_SIZE,0,dg_stream>>>( &
        lift_out, Lift_mat, flux_bnd, Ne )
    else
      call surface_lift_kernel<<<nblock,CUDA_BLOCK_SIZE,0,dg_stream>>>( &
        lift_out, Lift_mat, flux_bnd, Nq, Np, NfpTot, npoint )
    end if
    istat = cudaGetLastError()
    if (istat /= cudaSuccess) call cuda_failure("surface_lift_kernel",istat)
    call dg_ev_record(4)

    call dqdt_assembly_kernel<<<nblock,CUDA_BLOCK_SIZE,0,dg_stream>>>( &
      dqdt, Escale, deriv_x, deriv_y, deriv_z, lift_out, npoint )
    istat = cudaGetLastError()
    if (istat /= cudaSuccess) call cuda_failure("dqdt_assembly_kernel",istat)
    call dg_ev_record(5)
    call dg_ev_end(DG_EV_SPLIT)

    kernel_time(1:4) = dg_kernel_time(1:4)
  end subroutine cuda_cal_dqdt_split
  ! Separable surface lift. Lift1D(:,f) is the 1D lift profile of face f and
  ! flux_bnd holds the six face planes, so the lift at node (i,j,k) is the sum
  ! of three rank-2 terms. Writing lift_out once replaces the three K=2 GEMMs,
  ! which read and rewrote the whole volume twice to accumulate into it.
  attributes(global) subroutine separable_lift_kernel( &
    lift_out, flux_bnd, Lift1D, Nq, Np, npoint )
    implicit none
    integer, value :: Nq, Np, npoint
    real(RP), device :: lift_out(*)
    real(RP), device :: flux_bnd(*), Lift1D(*)

    integer :: idx, node, elem, nq2, base
    integer :: i, j, k
    real(RP) :: lx, ly, lz

    idx = (blockIdx%x-1)*blockDim%x + threadIdx%x
    if (idx <= npoint) then
      nq2 = Nq*Nq
      node = mod(idx-1,Np)
      elem = (idx-1)/Np
      i = mod(node,Nq)
      j = mod(node/Nq,Nq)
      k = node/nq2
      base = elem*6*nq2

      lx = Lift1D(  Nq+i+1)*flux_bnd(base+  nq2+j+k*Nq+1) &
         + Lift1D(3*Nq+i+1)*flux_bnd(base+3*nq2+j+k*Nq+1)
      ly = Lift1D(     j+1)*flux_bnd(base+      i+k*Nq+1) &
         + Lift1D(2*Nq+j+1)*flux_bnd(base+2*nq2+i+k*Nq+1)
      lz = Lift1D(4*Nq+k+1)*flux_bnd(base+4*nq2+i+j*Nq+1) &
         + Lift1D(5*Nq+k+1)*flux_bnd(base+5*nq2+i+j*Nq+1)

      lift_out(idx) = (lx + ly) + lz
    end if
  end subroutine separable_lift_kernel

  !> separable_lift_kernel and dqdt_assembly_kernel in one pass.
  !!
  !! The two were split because CUDAFORTRAN_SPLIT wants to time the lift and
  !! the assembly separately, but on the GEMM paths nothing reads lift_out in
  !! between, so materializing it costs a full Np*Ne write plus a full read --
  !! 268 MB per stage at 16.78 M DOF.  That is pure loss on any order where
  !! the assembly sits on the DRAM roof, which ncu measures at 91.4% for
  !! p=31 (reports/p31_gap_study.md section 9).
  !!
  !! The summation order is the one the two kernels produced together:
  !! (lx + ly) + lz was rounded to a double in lift_out, and that is still
  !! where the parenthesis is, so the result is unchanged.
  !!
  !! Pass the three Escale components as separate base pointers.  At p=1023,
  !! npoint=2^30 and the old device expression idx+2*npoint crossed the signed
  !! 32-bit boundary.  The host-side array descriptor forms each component
  !! pointer with its native address kind, while every kernel-local point index
  !! remains 32-bit and keeps the existing paths' instruction mix unchanged.
  attributes(global) subroutine separable_lift_assembly_kernel( &
    dqdt, Escale_x, Escale_y, Escale_z, &
    deriv_x, deriv_y, deriv_z, flux_bnd, Lift1D, &
    Nq, Np, npoint )
    implicit none
    integer, value :: Nq, Np, npoint
    real(RP), device :: dqdt(*), Escale_x(*), Escale_y(*), Escale_z(*)
    real(RP), device :: deriv_x(*), deriv_y(*), deriv_z(*)
    real(RP), device :: flux_bnd(*), Lift1D(*)

    integer :: idx, node, elem, nq2, base
    integer :: i, j, k
    real(RP) :: lx, ly, lz

    idx = (blockIdx%x-1)*blockDim%x + threadIdx%x
    if (idx <= npoint) then
      nq2 = Nq*Nq
      node = mod(idx-1,Np)
      elem = (idx-1)/Np
      i = mod(node,Nq)
      j = mod(node/Nq,Nq)
      k = node/nq2
      base = elem*6*nq2

      lx = Lift1D(  Nq+i+1)*flux_bnd(base+  nq2+j+k*Nq+1) &
         + Lift1D(3*Nq+i+1)*flux_bnd(base+3*nq2+j+k*Nq+1)
      ly = Lift1D(     j+1)*flux_bnd(base+      i+k*Nq+1) &
         + Lift1D(2*Nq+j+1)*flux_bnd(base+2*nq2+i+k*Nq+1)
      lz = Lift1D(4*Nq+k+1)*flux_bnd(base+4*nq2+i+j*Nq+1) &
         + Lift1D(5*Nq+k+1)*flux_bnd(base+5*nq2+i+j*Nq+1)

      dqdt(idx) = -( &
          Escale_x(idx)*deriv_x(idx) &
        + Escale_y(idx)*deriv_y(idx) &
        + Escale_z(idx)*deriv_z(idx) &
        + ((lx + ly) + lz) )
    end if
  end subroutine separable_lift_assembly_kernel

  ! The four operands are read into registers before any store is issued.
  ! Written as three q(idx)*vel expressions instead, nvfortran interleaved the
  ! loads with the stores and reloaded q for each one: ncu measured 6 global
  ! load instructions per warp instead of 4, DRAM throughput 65.7% with no unit
  ! saturated (L1 52.5%, SM 33.7%), i.e. latency bound.  Batching the loads
  ! took the kernel from 150.6 to 125.9 us at p=255 (DRAM 83.4%, 7.1 TB/s).
  ! Hoisting only q changes nothing; the store-free load window is the point.
  attributes(global) subroutine volume_flux_kernel( &
    flux_x, flux_y, flux_z, q, u, v, w, npoint )
    implicit none
    integer, value :: npoint
    real(RP), device :: flux_x(*), flux_y(*), flux_z(*)
    real(RP), device :: q(*), u(*), v(*), w(*)

    integer :: idx
    real(RP) :: qi, ui, vi, wi

    idx = (blockIdx%x-1)*blockDim%x + threadIdx%x
    if (idx <= npoint) then
      qi = q(idx)
      ui = u(idx)
      vi = v(idx)
      wi = w(idx)
      flux_x(idx) = qi*ui
      flux_y(idx) = qi*vi
      flux_z(idx) = qi*wi
    end if
  end subroutine volume_flux_kernel

  subroutine launch_volume_flux( &
    flux_x, flux_y, flux_z, q, u, v, w, npoint )
    implicit none
    integer, intent(in) :: npoint
    real(RP), device :: flux_x(*), flux_y(*), flux_z(*)
    real(RP), device :: q(*), u(*), v(*), w(*)

    integer :: nblock_flux

    nblock_flux = (npoint+CUDA_BLOCK_SIZE-1)/CUDA_BLOCK_SIZE
    call volume_flux_kernel<<<nblock_flux,CUDA_BLOCK_SIZE,0,dg_stream>>>( &
      flux_x, flux_y, flux_z, q, u, v, w, npoint )
  end subroutine launch_volume_flux

  ! Volume flux and element-boundary flux in ONE launch.  Both are pure
  ! streaming kernels over the same q / u / v / w fields, so the concatenated
  ! grid saves one launch and lets the face threads hit the L2 lines the
  ! volume threads have just pulled in (VMapM points at a volume node of the
  ! same element).  The two halves are byte-for-byte the bodies of
  ! volume_flux_kernel and elembnd_flux_kernel; nothing about the numerics
  ! changes.  Only reachable when the face flux would otherwise run serially
  ! on dg_stream ahead of the volume flux -- with the face flux on the side
  ! stream the fused form would give the overlap back.
  attributes(global) subroutine flux_all_kernel( &
    flux_x, flux_y, flux_z, flux, q, u, v, w, VMapM, VMapP, &
    normal_fn, Fscale, npoint, nface, pair_nq2 )
    implicit none
    integer, value :: npoint, nface, pair_nq2
    real(RP), device :: flux_x(*), flux_y(*), flux_z(*), flux(*)
    real(RP), device :: q(*), u(*), v(*), w(*)
    integer, device :: VMapM(*), VMapP(*)
    real(RP), device :: normal_fn(*), Fscale(*)

    integer :: tid, idx, iM, iP, iout, ir, iface, ipt, igrp, islot
    real(RP) :: qi, ui, vi, wi
    real(RP) :: qM, qP, VelM, VelP, alpha

    tid = (blockIdx%x-1)*blockDim%x + threadIdx%x
    if (tid <= npoint) then
      idx = tid
      qi = q(idx)
      ui = u(idx)
      vi = v(idx)
      wi = w(idx)
      flux_x(idx) = qi*ui
      flux_y(idx) = qi*vi
      flux_z(idx) = qi*wi
    else
      idx = tid - npoint
      if (idx <= nface) then
        iM = VMapM(idx)
        iP = VMapP(idx)
        qM = q(iM)
        qP = q(iP)
        VelM = u(iM)*normal_fn(idx) &
             + v(iM)*normal_fn(idx+nface) &
             + w(iM)*normal_fn(idx+2*nface)
        VelP = u(iP)*normal_fn(idx) &
             + v(iP)*normal_fn(idx+nface) &
             + w(iP)*normal_fn(idx+2*nface)
        alpha = 0.5_RP*abs(VelP+VelM)
        if (pair_nq2 == 0) then
          iout = idx
        else
          ir = mod(idx-1, 6*pair_nq2)
          iface = ir / pair_nq2
          ipt = mod(ir, pair_nq2)
          if (iface < 4) then
            igrp = mod(iface, 2)
            islot = iface / 2
          else
            igrp = 2
            islot = iface - 4
          end if
          iout = (idx-1) - ir + 2*pair_nq2*igrp + 2*ipt + islot + 1
        end if
        flux(iout) = 0.5_RP*Fscale(idx)*( &
          qP*VelP-qM*VelM-alpha*(qP-qM) )
      end if
    end if
  end subroutine flux_all_kernel

  ! Shared launch helper for the fused pair.  Every GEMM path (GEMM, OZAKI1,
  ! OZAKI2 through cuda_cal_dqdt_gemm_unfused, GEMM_CUTE and GEMM_FUSED
  ! through cuda_cal_dqdt_gemm_cutlass) reaches the fused flux only here, so
  ! the five paths cannot diverge on it.
  subroutine launch_flux_all( &
    flux_x, flux_y, flux_z, flux_bnd, q, u, v, w, VMapM, VMapP, &
    normal_fn, Fscale, npoint, nface, pair_nq2 )
    implicit none
    integer, intent(in) :: npoint, nface, pair_nq2
    real(RP), device :: flux_x(*), flux_y(*), flux_z(*), flux_bnd(*)
    real(RP), device :: q(*), u(*), v(*), w(*)
    integer, device :: VMapM(*), VMapP(*)
    real(RP), device :: normal_fn(*), Fscale(*)

    integer :: nblock_all

    nblock_all = (npoint+nface+CUDA_BLOCK_SIZE-1)/CUDA_BLOCK_SIZE
    call flux_all_kernel<<<nblock_all,CUDA_BLOCK_SIZE,0,dg_stream>>>( &
      flux_x, flux_y, flux_z, flux_bnd, q, u, v, w, VMapM, VMapP, &
      normal_fn, Fscale, npoint, nface, pair_nq2 )
  end subroutine launch_flux_all

  ! SCALE_DG_FLUXFUSE: 0 = separate volume_flux_kernel and elembnd_flux_kernel
  ! (the form every measurement before 2026-09-03 used), 1 = fuse them into
  ! flux_all_kernel wherever they would run back to back on dg_stream anyway,
  ! 2 = fuse them even where the face flux is currently hidden on the side
  ! stream (which gives that overlap up).  Shared by all five GEMM paths.
  !
  ! DEFAULT 1, adopted 2026-09-03 (Slurm job 78296, node c384, 12 interleaved
  ! rounds): GEMM -0.07 / -0.17 / -0.28% at p = 7 / 15 / 31 (12/12 rounds each)
  ! and GEMM_CUTE -0.05 / -0.23% at p = 7 / 15 (10/12 and 12/12); p = 31
  ! GEMM_CUTE is a wash (+0.01%, 5/12, ranges overlap).  Mode 2 loses wherever
  ! it can be tested (+0.44 / +0.80 / +1.40% on GEMM_FUSED at p = 7 / 15 / 31),
  ! which is the side stream's value measured from the other side.
  ! reports/gemm_assignment_and_carrier.md section 9.
  integer function dg_flux_fuse()
    implicit none
    dg_flux_fuse = dg_env_int("SCALE_DG_FLUXFUSE", fluxfuse_env, 1)
  end function dg_flux_fuse

  attributes(global) subroutine volume_deriv_kernel( &
    deriv_x, deriv_y, deriv_z, D1D, D1D_tr, &
    flux_x, flux_y, flux_z, Nq, Np, npoint )
    implicit none
    integer, value :: Nq, Np, npoint
    real(RP), device :: deriv_x(*), deriv_y(*), deriv_z(*)
    real(RP), device :: D1D(*), D1D_tr(*)
    real(RP), device :: flux_x(*), flux_y(*), flux_z(*)

    integer :: idx, node, elem_offset
    integer :: i, j, k, l, nq2
    integer :: ix, iy, iz
    real(RP) :: sum_x, sum_y, sum_z

    idx = (blockIdx%x-1)*blockDim%x + threadIdx%x
    nq2 = Nq*Nq

    if (idx <= npoint) then
      node = mod(idx-1,Np) + 1
      elem_offset = idx - node
      i = mod(node-1,Nq) + 1
      j = mod((node-1)/Nq,Nq) + 1
      k = (node-1)/nq2 + 1

      sum_x = 0.0_RP
      sum_y = 0.0_RP
      sum_z = 0.0_RP
      do l = 1, Nq
        ix = elem_offset + l + (j-1)*Nq + (k-1)*nq2
        iy = elem_offset + i + (l-1)*Nq + (k-1)*nq2
        iz = elem_offset + i + (j-1)*Nq + (l-1)*nq2
        sum_x = sum_x + D1D(i+(l-1)*Nq)*flux_x(ix)
        sum_y = sum_y + D1D_tr(l+(j-1)*Nq)*flux_y(iy)
        sum_z = sum_z + D1D_tr(l+(k-1)*Nq)*flux_z(iz)
      end do

      deriv_x(idx) = sum_x
      deriv_y(idx) = sum_y
      deriv_z(idx) = sum_z
    end if
  end subroutine volume_deriv_kernel

  !> Polynomial-order-7 derivative kernel.  One CUDA block owns one
  !! element, so values reused by the three tensor contractions are read
  !! from global memory once and then served from shared memory.
  attributes(global) subroutine volume_deriv_p7_kernel( &
    deriv_x, deriv_y, deriv_z, D1D, D1D_tr, &
    flux_x, flux_y, flux_z, Ne )
    implicit none
    integer, value :: Ne
    real(RP), device :: deriv_x(*), deriv_y(*), deriv_z(*)
    real(RP), device :: D1D(*), D1D_tr(*)
    real(RP), device :: flux_x(*), flux_y(*), flux_z(*)

    real(RP), shared :: sD1D(64), sD1D_tr(64)
    real(RP), shared :: sflux_x(512), sflux_y(512), sflux_z(512)
    integer :: elem, elem_offset, tid, node, i, j, k, l
    integer :: ix, iy, iz
    real(RP) :: sum_x, sum_y, sum_z

    elem = blockIdx%x
    if (elem > Ne) return

    tid = threadIdx%x
    elem_offset = (elem-1)*512

    if (tid <= 64) then
      sD1D(tid) = D1D(tid)
      sD1D_tr(tid) = D1D_tr(tid)
    end if
    node = tid
    sflux_x(node) = flux_x(elem_offset+node)
    sflux_y(node) = flux_y(elem_offset+node)
    sflux_z(node) = flux_z(elem_offset+node)
    call syncthreads()

    i = mod(node-1,8) + 1
    j = mod((node-1)/8,8) + 1
    k = (node-1)/64 + 1

    sum_x = 0.0_RP
    sum_y = 0.0_RP
    sum_z = 0.0_RP
    do l = 1, 8
      ix = l + (j-1)*8 + (k-1)*64
      iy = i + (l-1)*8 + (k-1)*64
      iz = i + (j-1)*8 + (l-1)*64
      sum_x = sum_x + sD1D(i+(l-1)*8)*sflux_x(ix)
      sum_y = sum_y + sD1D_tr(l+(j-1)*8)*sflux_y(iy)
      sum_z = sum_z + sD1D_tr(l+(k-1)*8)*sflux_z(iz)
    end do

    deriv_x(elem_offset+node) = sum_x
    deriv_y(elem_offset+node) = sum_y
    deriv_z(elem_offset+node) = sum_z
  end subroutine volume_deriv_p7_kernel

  !> Form the p=7 volume fluxes directly in shared memory and immediately
  !! apply the tensor-product derivative, avoiding three global work arrays.
  attributes(global) subroutine volume_flux_deriv_p7_kernel( &
    deriv_x, deriv_y, deriv_z, D1D, D1D_tr, q, u, v, w, Ne )
    implicit none
    integer, value :: Ne
    real(RP), device :: deriv_x(*), deriv_y(*), deriv_z(*)
    real(RP), device :: D1D(*), D1D_tr(*)
    real(RP), device :: q(*), u(*), v(*), w(*)

    real(RP), shared :: sD1D(64), sD1D_tr(64)
    real(RP), shared :: sflux_x(512), sflux_y(512), sflux_z(512)
    integer :: elem, elem_offset, tid, node1, node2, i, j, k1, k2, l
    integer :: ix1, iy1, iz, ix2, iy2
    real(RP) :: q_node, mat_x, mat_y, mat_z1, mat_z2
    real(RP) :: sum_x1, sum_y1, sum_z1, sum_x2, sum_y2, sum_z2

    elem = blockIdx%x
    if (elem > Ne) return

    tid = threadIdx%x
    node1 = tid
    node2 = tid + 256
    elem_offset = (elem-1)*512

    if (tid <= 64) then
      sD1D(tid) = D1D(tid)
      sD1D_tr(tid) = D1D_tr(tid)
    end if
    q_node = q(elem_offset+node1)
    sflux_x(node1) = q_node*u(elem_offset+node1)
    sflux_y(node1) = q_node*v(elem_offset+node1)
    sflux_z(node1) = q_node*w(elem_offset+node1)
    q_node = q(elem_offset+node2)
    sflux_x(node2) = q_node*u(elem_offset+node2)
    sflux_y(node2) = q_node*v(elem_offset+node2)
    sflux_z(node2) = q_node*w(elem_offset+node2)
    call syncthreads()

    i = mod(node1-1,8) + 1
    j = mod((node1-1)/8,8) + 1
    k1 = (node1-1)/64 + 1
    k2 = k1 + 4

    sum_x1 = 0.0_RP
    sum_y1 = 0.0_RP
    sum_z1 = 0.0_RP
    sum_x2 = 0.0_RP
    sum_y2 = 0.0_RP
    sum_z2 = 0.0_RP
    do l = 1, 8
      ix1 = l + (j-1)*8 + (k1-1)*64
      iy1 = i + (l-1)*8 + (k1-1)*64
      iz = i + (j-1)*8 + (l-1)*64
      ix2 = ix1 + 256
      iy2 = iy1 + 256
      mat_x = sD1D(i+(l-1)*8)
      mat_y = sD1D_tr(l+(j-1)*8)
      mat_z1 = sD1D_tr(l+(k1-1)*8)
      mat_z2 = sD1D_tr(l+(k2-1)*8)
      sum_x1 = sum_x1 + mat_x*sflux_x(ix1)
      sum_y1 = sum_y1 + mat_y*sflux_y(iy1)
      sum_z1 = sum_z1 + mat_z1*sflux_z(iz)
      sum_x2 = sum_x2 + mat_x*sflux_x(ix2)
      sum_y2 = sum_y2 + mat_y*sflux_y(iy2)
      sum_z2 = sum_z2 + mat_z2*sflux_z(iz)
    end do

    deriv_x(elem_offset+node1) = sum_x1
    deriv_y(elem_offset+node1) = sum_y1
    deriv_z(elem_offset+node1) = sum_z1
    deriv_x(elem_offset+node2) = sum_x2
    deriv_y(elem_offset+node2) = sum_y2
    deriv_z(elem_offset+node2) = sum_z2
  end subroutine volume_flux_deriv_p7_kernel

  !> Form volume fluxes, differentiate, lift surface fluxes, and assemble dqdt.
  !! Two nodes with common x/y contraction coefficients are handled per thread.
  attributes(global) subroutine volume_flux_deriv_lift_assembly_p7_kernel( &
    dqdt, Escale, D1D, D1D_tr, Lift_mat, flux_bnd, q, u, v, w, Ne )
    implicit none
    integer, value :: Ne
    real(RP), device :: dqdt(*), Escale(*), D1D(*), D1D_tr(*)
    real(RP), device :: Lift_mat(*), flux_bnd(*), q(*), u(*), v(*), w(*)

    real(RP), shared :: sD1D(64), sD1D_tr(64)
    real(RP), shared :: sflux_x(512), sflux_y(512), sflux_z(512)
    integer :: elem, elem_offset, face_offset, tid, node1, node2
    integer :: i, j, k1, k2, l, ix1, iy1, iz, ix2, iy2
    integer :: face11, face12, face13, face14, face15, face16
    integer :: face21, face22, face23, face24, face25, face26
    integer :: idx1, idx2, npoint
    real(RP) :: q_node, mat_x, mat_y, mat_z1, mat_z2
    real(RP) :: sum_x1, sum_y1, sum_z1, sum_x2, sum_y2, sum_z2
    real(RP) :: lift1, lift2

    elem = blockIdx%x
    if (elem > Ne) return

    tid = threadIdx%x
    node1 = tid
    node2 = tid + 256
    elem_offset = (elem-1)*512
    face_offset = (elem-1)*384

    if (tid <= 64) then
      sD1D(tid) = D1D(tid)
      sD1D_tr(tid) = D1D_tr(tid)
    end if
    q_node = q(elem_offset+node1)
    sflux_x(node1) = q_node*u(elem_offset+node1)
    sflux_y(node1) = q_node*v(elem_offset+node1)
    sflux_z(node1) = q_node*w(elem_offset+node1)
    q_node = q(elem_offset+node2)
    sflux_x(node2) = q_node*u(elem_offset+node2)
    sflux_y(node2) = q_node*v(elem_offset+node2)
    sflux_z(node2) = q_node*w(elem_offset+node2)
    call syncthreads()

    i = mod(node1-1,8) + 1
    j = mod((node1-1)/8,8) + 1
    k1 = (node1-1)/64 + 1
    k2 = k1 + 4

    sum_x1 = 0.0_RP
    sum_y1 = 0.0_RP
    sum_z1 = 0.0_RP
    sum_x2 = 0.0_RP
    sum_y2 = 0.0_RP
    sum_z2 = 0.0_RP
    do l = 1, 8
      ix1 = l + (j-1)*8 + (k1-1)*64
      iy1 = i + (l-1)*8 + (k1-1)*64
      iz = i + (j-1)*8 + (l-1)*64
      ix2 = ix1 + 256
      iy2 = iy1 + 256
      mat_x = sD1D(i+(l-1)*8)
      mat_y = sD1D_tr(l+(j-1)*8)
      mat_z1 = sD1D_tr(l+(k1-1)*8)
      mat_z2 = sD1D_tr(l+(k2-1)*8)
      sum_x1 = sum_x1 + mat_x*sflux_x(ix1)
      sum_y1 = sum_y1 + mat_y*sflux_y(iy1)
      sum_z1 = sum_z1 + mat_z1*sflux_z(iz)
      sum_x2 = sum_x2 + mat_x*sflux_x(ix2)
      sum_y2 = sum_y2 + mat_y*sflux_y(iy2)
      sum_z2 = sum_z2 + mat_z2*sflux_z(iz)
    end do

    face11 = i + (k1-1)*8
    face12 = 64 + j + (k1-1)*8
    face13 = 128 + i + (k1-1)*8
    face14 = 192 + j + (k1-1)*8
    face15 = 256 + i + (j-1)*8
    face16 = 320 + i + (j-1)*8
    face21 = i + (k2-1)*8
    face22 = 64 + j + (k2-1)*8
    face23 = 128 + i + (k2-1)*8
    face24 = 192 + j + (k2-1)*8
    face25 = face15
    face26 = face16

    lift1 = &
        Lift_mat(node1)       *flux_bnd(face_offset+face11) &
      + Lift_mat(node1+512)   *flux_bnd(face_offset+face12) &
      + Lift_mat(node1+1024)  *flux_bnd(face_offset+face13) &
      + Lift_mat(node1+1536)  *flux_bnd(face_offset+face14) &
      + Lift_mat(node1+2048)  *flux_bnd(face_offset+face15) &
      + Lift_mat(node1+2560)  *flux_bnd(face_offset+face16)
    lift2 = &
        Lift_mat(node2)       *flux_bnd(face_offset+face21) &
      + Lift_mat(node2+512)   *flux_bnd(face_offset+face22) &
      + Lift_mat(node2+1024)  *flux_bnd(face_offset+face23) &
      + Lift_mat(node2+1536)  *flux_bnd(face_offset+face24) &
      + Lift_mat(node2+2048)  *flux_bnd(face_offset+face25) &
      + Lift_mat(node2+2560)  *flux_bnd(face_offset+face26)

    idx1 = elem_offset + node1
    idx2 = elem_offset + node2
    npoint = 512*Ne
    dqdt(idx1) = -(Escale(idx1)*sum_x1 + Escale(idx1+npoint)*sum_y1 &
      + Escale(idx1+2*npoint)*sum_z1 + lift1)
    dqdt(idx2) = -(Escale(idx2)*sum_x2 + Escale(idx2+npoint)*sum_y2 &
      + Escale(idx2+2*npoint)*sum_z2 + lift2)
  end subroutine volume_flux_deriv_lift_assembly_p7_kernel

  attributes(global) subroutine surface_lift_kernel( &
    lift_out, Lift_mat, flux_bnd, Nq, Np, NfpTot, npoint )
    implicit none
    integer, value :: Nq, Np, NfpTot, npoint
    real(RP), device :: lift_out(*), Lift_mat(*), flux_bnd(*)

    integer :: idx, node, elem, elem_face_offset
    integer :: i, j, k, nq2
    integer :: face1, face2, face3, face4, face5, face6

    idx = (blockIdx%x-1)*blockDim%x + threadIdx%x
    nq2 = Nq*Nq

    if (idx <= npoint) then
      node = mod(idx-1,Np) + 1
      elem = (idx-1)/Np + 1
      elem_face_offset = (elem-1)*NfpTot
      i = mod(node-1,Nq) + 1
      j = mod((node-1)/Nq,Nq) + 1
      k = (node-1)/nq2 + 1

      face1 = elem_face_offset + i + (k-1)*Nq
      face2 = elem_face_offset + nq2 + j + (k-1)*Nq
      face3 = elem_face_offset + 2*nq2 + i + (k-1)*Nq
      face4 = elem_face_offset + 3*nq2 + j + (k-1)*Nq
      face5 = elem_face_offset + 4*nq2 + i + (j-1)*Nq
      face6 = elem_face_offset + 5*nq2 + i + (j-1)*Nq

      lift_out(idx) = &
          Lift_mat(node)       * flux_bnd(face1) &
        + Lift_mat(node+Np)    * flux_bnd(face2) &
        + Lift_mat(node+2*Np)  * flux_bnd(face3) &
        + Lift_mat(node+3*Np)  * flux_bnd(face4) &
        + Lift_mat(node+4*Np)  * flux_bnd(face5) &
        + Lift_mat(node+5*Np)  * flux_bnd(face6)
    end if
  end subroutine surface_lift_kernel

  !> Polynomial-order-7 lifting kernel using the read-only cache for face data.
  attributes(global) subroutine surface_lift_p7_kernel( &
    lift_out, Lift_mat, flux_bnd, Ne )
    implicit none
    integer, value :: Ne
    real(RP), device :: lift_out(*), Lift_mat(*), flux_bnd(*)

    integer :: elem, elem_offset, elem_face_offset, tid, node
    integer :: i, j, k
    integer :: face1, face2, face3, face4, face5, face6

    elem = blockIdx%x
    if (elem > Ne) return

    tid = threadIdx%x
    elem_offset = (elem-1)*512
    elem_face_offset = (elem-1)*384

    node = tid
    i = mod(node-1,8) + 1
    j = mod((node-1)/8,8) + 1
    k = (node-1)/64 + 1

    face1 = i + (k-1)*8
    face2 = 64 + j + (k-1)*8
    face3 = 128 + i + (k-1)*8
    face4 = 192 + j + (k-1)*8
    face5 = 256 + i + (j-1)*8
    face6 = 320 + i + (j-1)*8

    lift_out(elem_offset+node) = &
        Lift_mat(node)        * flux_bnd(elem_face_offset+face1) &
      + Lift_mat(node+512)    * flux_bnd(elem_face_offset+face2) &
      + Lift_mat(node+1024)   * flux_bnd(elem_face_offset+face3) &
      + Lift_mat(node+1536)   * flux_bnd(elem_face_offset+face4) &
      + Lift_mat(node+2048)   * flux_bnd(elem_face_offset+face5) &
      + Lift_mat(node+2560)   * flux_bnd(elem_face_offset+face6)
  end subroutine surface_lift_p7_kernel

  !> Polynomial-order-7 lifting and final tendency assembly in one kernel.
  attributes(global) subroutine surface_lift_assembly_p7_kernel( &
    dqdt, Escale, deriv_x, deriv_y, deriv_z, Lift_mat, flux_bnd, Ne )
    implicit none
    integer, value :: Ne
    real(RP), device :: dqdt(*), Escale(*)
    real(RP), device :: deriv_x(*), deriv_y(*), deriv_z(*)
    real(RP), device :: Lift_mat(*), flux_bnd(*)

    integer :: elem, elem_offset, elem_face_offset, tid, node, idx, npoint
    integer :: i, j, k
    integer :: face1, face2, face3, face4, face5, face6
    real(RP) :: lift_value

    elem = blockIdx%x
    if (elem > Ne) return

    tid = threadIdx%x
    elem_offset = (elem-1)*512
    elem_face_offset = (elem-1)*384

    node = tid
    i = mod(node-1,8) + 1
    j = mod((node-1)/8,8) + 1
    k = (node-1)/64 + 1

    face1 = i + (k-1)*8
    face2 = 64 + j + (k-1)*8
    face3 = 128 + i + (k-1)*8
    face4 = 192 + j + (k-1)*8
    face5 = 256 + i + (j-1)*8
    face6 = 320 + i + (j-1)*8

    lift_value = &
        Lift_mat(node)        * flux_bnd(elem_face_offset+face1) &
      + Lift_mat(node+512)    * flux_bnd(elem_face_offset+face2) &
      + Lift_mat(node+1024)   * flux_bnd(elem_face_offset+face3) &
      + Lift_mat(node+1536)   * flux_bnd(elem_face_offset+face4) &
      + Lift_mat(node+2048)   * flux_bnd(elem_face_offset+face5) &
      + Lift_mat(node+2560)   * flux_bnd(elem_face_offset+face6)

    idx = elem_offset + node
    npoint = 512*Ne
    dqdt(idx) = -( &
        Escale(idx)*deriv_x(idx) &
      + Escale(idx+npoint)*deriv_y(idx) &
      + Escale(idx+2*npoint)*deriv_z(idx) &
      + lift_value )
  end subroutine surface_lift_assembly_p7_kernel

  attributes(global) subroutine dqdt_assembly_kernel( &
    dqdt, Escale, deriv_x, deriv_y, deriv_z, lift_in, npoint )
    implicit none
    integer, value :: npoint
    real(RP), device :: dqdt(*), Escale(*)
    real(RP), device :: deriv_x(*), deriv_y(*), deriv_z(*), lift_in(*)

    integer :: idx

    idx = (blockIdx%x-1)*blockDim%x + threadIdx%x
    if (idx <= npoint) then
      dqdt(idx) = -( &
          Escale(idx)*deriv_x(idx) &
        + Escale(idx+npoint)*deriv_y(idx) &
        + Escale(idx+2*npoint)*deriv_z(idx) &
        + lift_in(idx) )
    end if
  end subroutine dqdt_assembly_kernel

  ! pair_nq2 = 0 writes the plain layout: six face planes of nq2 points, in
  ! face order.  pair_nq2 = nq2 instead interleaves the planes in the three
  ! pairs the p>64 GEMM_FUSED z epilogue reads at a common index -- (1,3),
  ! (2,4), (5,6) -- so that each of its three lift terms is one 16-byte load
  ! instead of two 8-byte ones.  It moves the same bytes; only the destination
  ! index differs.  See cutlass_z_gemm_assembly.h.
  attributes(global) subroutine pack_lift_zpair_kernel( zpair, lift1d, Nq )
    implicit none
    integer, value :: Nq
    real(RP), device :: zpair(*), lift1d(*)
    integer :: k

    k = (blockIdx%x-1)*blockDim%x + threadIdx%x
    if (k <= Nq) then
      zpair(2*k-1) = lift1d(4*Nq+k)
      zpair(2*k  ) = lift1d(5*Nq+k)
    end if
  end subroutine pack_lift_zpair_kernel

  !- Packed lift-coefficient pairs for the x assembly epilogue: (col1,col3)
  !- indexed by j, (col2,col4) indexed by i, (col5,col6) indexed by k.
  attributes(global) subroutine pack_lift_xpair_kernel( pairs, lift1d, Nq )
    implicit none
    integer, value :: Nq
    real(RP), device :: pairs(*), lift1d(*)
    integer :: k

    k = (blockIdx%x-1)*blockDim%x + threadIdx%x
    if (k <= Nq) then
      pairs(2*k-1)        = lift1d(k)
      pairs(2*k  )        = lift1d(2*Nq+k)
      pairs(2*Nq+2*k-1)   = lift1d(Nq+k)
      pairs(2*Nq+2*k  )   = lift1d(3*Nq+k)
      pairs(4*Nq+2*k-1)   = lift1d(4*Nq+k)
      pairs(4*Nq+2*k  )   = lift1d(5*Nq+k)
    end if
  end subroutine pack_lift_xpair_kernel

  attributes(global) subroutine elembnd_flux_kernel( &
    flux, q, u, v, w, VMapM, VMapP, normal_fn, Fscale, nface, pair_nq2 )
    implicit none
    integer, value :: nface, pair_nq2
    real(RP), device :: flux(*), q(*), u(*), v(*), w(*)
    integer, device :: VMapM(*), VMapP(*)
    real(RP), device :: normal_fn(*), Fscale(*)

    integer :: idx, iM, iP, iout, ir, iface, ipt, igrp, islot
    real(RP) :: qM, qP, VelM, VelP, alpha

    idx = (blockIdx%x-1)*blockDim%x + threadIdx%x
    if (idx <= nface) then
      iM = VMapM(idx)
      iP = VMapP(idx)
      qM = q(iM)
      qP = q(iP)
      VelM = u(iM)*normal_fn(idx) &
           + v(iM)*normal_fn(idx+nface) &
           + w(iM)*normal_fn(idx+2*nface)
      VelP = u(iP)*normal_fn(idx) &
           + v(iP)*normal_fn(idx+nface) &
           + w(iP)*normal_fn(idx+2*nface)
      alpha = 0.5_RP*abs(VelP+VelM)
      if (pair_nq2 == 0) then
        iout = idx
      else
        ! face f -> (group, slot): 0->(0,0) 1->(1,0) 2->(0,1) 3->(1,1)
        !                          4->(2,0) 5->(2,1)
        ir = mod(idx-1, 6*pair_nq2)
        iface = ir / pair_nq2
        ipt = mod(ir, pair_nq2)
        if (iface < 4) then
          igrp = mod(iface, 2)
          islot = iface / 2
        else
          igrp = 2
          islot = iface - 4
        end if
        iout = (idx-1) - ir + 2*pair_nq2*igrp + 2*ipt + islot + 1
      end if
      flux(iout) = 0.5_RP*Fscale(idx)*( &
        qP*VelP-qM*VelM-alpha*(qP-qM) )
    end if
  end subroutine elembnd_flux_kernel

  ! group=0: faces 2 and 4 (2*Nq^2 compact threads / element).
  ! group=1: faces 1,3,5,6 (4*Nq^2 compact threads / element).
  attributes(global) subroutine elembnd_flux_group_kernel( &
    flux, q, u, v, w, VMapM, VMapP, normal_fn, Fscale, nface, nq2, group )
    implicit none
    integer, value :: nface, nq2, group
    real(RP), device :: flux(*), q(*), u(*), v(*), w(*)
    integer, device :: VMapM(*), VMapP(*)
    real(RP), device :: normal_fn(*), Fscale(*)

    integer :: tid, nwork_e, ie, local, base, idx, iM, iP
    real(RP) :: qM, qP, VelM, VelP, alpha

    tid = (blockIdx%x-1)*blockDim%x + threadIdx%x
    nwork_e = merge(2*nq2, 4*nq2, group == 0)
    ie = (tid-1) / nwork_e
    local = mod(tid-1, nwork_e)
    base = ie * 6 * nq2
    idx = base + local + 1
    if (group == 0) then
      if (local < nq2) then
        idx = base + nq2 + local + 1
      else
        idx = base + 3*nq2 + (local-nq2) + 1
      end if
    else
      if (local < nq2) then
        idx = base + local + 1
      else if (local < 2*nq2) then
        idx = base + 2*nq2 + (local-nq2) + 1
      else
        idx = base + 4*nq2 + (local-2*nq2) + 1
      end if
    end if
    if (idx <= nface) then
      iM = VMapM(idx)
      iP = VMapP(idx)
      qM = q(iM)
      qP = q(iP)
      VelM = u(iM)*normal_fn(idx) &
           + v(iM)*normal_fn(idx+nface) &
           + w(iM)*normal_fn(idx+2*nface)
      VelP = u(iP)*normal_fn(idx) &
           + v(iP)*normal_fn(idx+nface) &
           + w(iP)*normal_fn(idx+2*nface)
      alpha = 0.5_RP*abs(VelP+VelM)
      flux(idx) = 0.5_RP*Fscale(idx)*( &
        qP*VelP-qM*VelM-alpha*(qP-qM) )
    end if
  end subroutine elembnd_flux_group_kernel

  subroutine cuda_cal_volume_flux( &
    flux_x, flux_y, flux_z, q, u, v, w, Np, Ne, NeA )
    implicit none
    integer, intent(in) :: Np, Ne, NeA
    real(RP), device, intent(out) :: flux_x(Np,Ne), flux_y(Np,Ne), flux_z(Np,Ne)
    real(RP), device, intent(in) :: q(Np,NeA)
    real(RP), device, intent(in) :: u(Np,NeA), v(Np,NeA), w(Np,NeA)

    integer :: npoint, nblock

    npoint = Np*Ne
    nblock = (npoint+CUDA_BLOCK_SIZE-1)/CUDA_BLOCK_SIZE
    call launch_volume_flux( &
      flux_x, flux_y, flux_z, q, u, v, w, npoint )
    call synchronize_cuda_kernel("volume_flux_kernel")
  end subroutine cuda_cal_volume_flux

  subroutine cuda_cal_volume_deriv( &
    deriv_x, deriv_y, deriv_z, D1D, D1D_tr, &
    flux_x, flux_y, flux_z, Nq, Np, Ne )
    implicit none
    integer, intent(in) :: Nq, Np, Ne
    real(RP), device, intent(out) :: deriv_x(Np,Ne), deriv_y(Np,Ne), deriv_z(Np,Ne)
    real(RP), device, intent(in) :: D1D(Nq,Nq), D1D_tr(Nq,Nq)
    real(RP), device, intent(in) :: flux_x(Np,Ne), flux_y(Np,Ne), flux_z(Np,Ne)

    integer :: npoint, nblock

    if (Nq == 8) then
      call volume_deriv_p7_kernel<<<Ne,CUDA_P7_BLOCK_SIZE,0,dg_stream>>>( &
        deriv_x, deriv_y, deriv_z, D1D, D1D_tr, &
        flux_x, flux_y, flux_z, Ne )
      call synchronize_cuda_kernel("volume_deriv_p7_kernel")
    else
      npoint = Np*Ne
      nblock = (npoint+CUDA_BLOCK_SIZE-1)/CUDA_BLOCK_SIZE
      call volume_deriv_kernel<<<nblock,CUDA_BLOCK_SIZE,0,dg_stream>>>( &
        deriv_x, deriv_y, deriv_z, D1D, D1D_tr, &
        flux_x, flux_y, flux_z, Nq, Np, npoint )
      call synchronize_cuda_kernel("volume_deriv_kernel")
    end if
  end subroutine cuda_cal_volume_deriv

  subroutine cuda_cal_surface_lift( &
    lift_out, Lift_mat, flux_bnd, Nq, Np, NfpTot, Ne )
    implicit none
    integer, intent(in) :: Nq, Np, NfpTot, Ne
    real(RP), device, intent(out) :: lift_out(Np,Ne)
    real(RP), device, intent(in) :: Lift_mat(Nq,Nq,Nq,6)
    real(RP), device, intent(in) :: flux_bnd(NfpTot,Ne)

    integer :: npoint, nblock

    if (Nq == 8) then
      call surface_lift_p7_kernel<<<Ne,CUDA_P7_BLOCK_SIZE,0,dg_stream>>>( &
        lift_out, Lift_mat, flux_bnd, Ne )
      call synchronize_cuda_kernel("surface_lift_p7_kernel")
    else
      npoint = Np*Ne
      nblock = (npoint+CUDA_BLOCK_SIZE-1)/CUDA_BLOCK_SIZE
      call surface_lift_kernel<<<nblock,CUDA_BLOCK_SIZE,0,dg_stream>>>( &
        lift_out, Lift_mat, flux_bnd, Nq, Np, NfpTot, npoint )
      call synchronize_cuda_kernel("surface_lift_kernel")
    end if
  end subroutine cuda_cal_surface_lift

  subroutine cuda_assemble_dqdt( &
    dqdt, Escale, deriv_x, deriv_y, deriv_z, lift_in, Np, Ne, NeA )
    implicit none
    integer, intent(in) :: Np, Ne, NeA
    real(RP), device, intent(out) :: dqdt(Np,Ne)
    real(RP), device, intent(in) :: Escale(Np,Ne,3)
    real(RP), device, intent(in) :: deriv_x(Np,Ne), deriv_y(Np,Ne), deriv_z(Np,Ne)
    real(RP), device, intent(in) :: lift_in(Np,Ne)

    integer :: npoint, nblock

    npoint = Np*Ne
    nblock = (npoint+CUDA_BLOCK_SIZE-1)/CUDA_BLOCK_SIZE
    call dqdt_assembly_kernel<<<nblock,CUDA_BLOCK_SIZE,0,dg_stream>>>( &
      dqdt, Escale, deriv_x, deriv_y, deriv_z, lift_in, npoint )
    call synchronize_cuda_kernel("dqdt_assembly_kernel")
  end subroutine cuda_assemble_dqdt

  subroutine cuda_failure(operation,istat)
    implicit none
    character(len=*), intent(in) :: operation
    integer, intent(in) :: istat

    write(*,*) trim(operation), ": ", trim(cudaGetErrorString(istat))
    error stop
  end subroutine cuda_failure

  subroutine synchronize_cuda_kernel(kernel_name)
    implicit none
    character(len=*), intent(in) :: kernel_name
    integer :: istat

    istat = cudaGetLastError()
    if (istat /= cudaSuccess) then
      write(*,*) trim(kernel_name), ": launch failed: ", trim(cudaGetErrorString(istat))
      error stop
    end if
    istat = cudaDeviceSynchronize()
    if (istat /= cudaSuccess) then
      write(*,*) trim(kernel_name), ": execution failed: ", trim(cudaGetErrorString(istat))
      error stop
    end if
  end subroutine synchronize_cuda_kernel
end module mod_cuda_dg_kernels
