.DS_Store
.cc_src/
# jobs/ is local scratch, with one exception: the cross-machine measurement
# harness is tracked, because a published ratio is only reproducible if the
# script that produced every column of it is. See jobs/README.md.
/jobs/*
!/jobs/README.md
!/jobs/tsubame_paths.sh
!/jobs/tsubame_paths_summarize.py
!/jobs/rikyu_paths.sh
!/jobs/wisteria_paths.sh
!/jobs/cublas_kernel_names_nsys.sh
!/jobs/wisteria_cublas_nsys.sh
!/jobs/l1_roof_ncu.sh
!/jobs/rikyu_l1_roof_ncu.sh
!/jobs/wisteria_l1_roof_ncu.sh
!/jobs/rikyu_p511_reversal_ncu.sh
!/jobs/wisteria_p511_reversal_ncu.sh
!/jobs/wisteria_compiler_sens.sh
!/jobs/roof_bytes_ncu.sh
!/jobs/rikyu_roof_bytes_ncu.sh
!/jobs/tsubame_roof_bytes_ncu.sh
!/jobs/wisteria_roof_bytes_ncu.sh
!/jobs/tsubame_ozaki.sh
!/jobs/wisteria_ozaki.sh
!/jobs/tsubame_acc.sh
!/jobs/wisteria_acc.sh
!/jobs/wisteria_p511_spread.sh
!/jobs/rikyu_acc.sh
!/jobs/tsubame_ozaki_sanitizer.sh
!/jobs/wisteria_ozaki_sanitizer.sh
!/jobs/wisteria_p511_clock.sh
!/jobs/tsubame_p511_clock.sh
/output/

# Paper drafting notes (outline, abstract drafts, figure plan) stay local: the
